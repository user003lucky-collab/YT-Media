    "var_f73770cf4f9f": {
      "type": "variant",
      "label": "01 Private Screening — Studio Site & Hero / Phone",
      "parentId": "var_6cfb358b5fd6",
      "themeId": null,
      "rect": {
        "x": 1470,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.studio-phone {font-family:'Raleway',sans-serif;background:#040407;color:#f5f3ea;--gold:#e4cf91;}\n.studio-phone .display {font-family:'Cormorant',serif;}\n.studio-phone .glass {background:linear-gradient(120deg,rgba(255,255,255,.065),rgba(255,255,255,.025));backdrop-filter:blur(30px) saturate(200%);border:1px solid #e9dbb52b;box-shadow:inset 0 1px 1px #ffffff40;}\n.studio-phone .well {background:#06060970;border:1px solid #ffffff26;box-shadow:inset 0 1px 3px #04040770;}\n.studio-phone input,.studio-phone textarea {font-family:inherit;color:#f5f3ea;}\n.studio-phone input:focus-visible,.studio-phone textarea:focus-visible,.studio-phone button:focus-visible,.studio-phone label:has(input:focus-visible) {outline:2px solid #e4cf91;outline-offset:3px;}\n.studio-phone .aperture {border-radius:24px 24px 34px 34px / 24px 24px 20px 20px;border:1px solid #e4cf9155;box-shadow:inset 0 1px 1px #ffffff40;}\n</style>\n<div class=\"studio-phone relative isolate min-h-[100dvh] overflow-x-clip px-3 pt-3 pb-8 text-[14px] font-medium\" data-kid=\"1\" data-name=\"phone app root container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background layer\">\n<div class=\"studio-orb absolute -left-32 top-8 h-[470px] w-[400px] rounded-full bg-[#d4af37]/12 blur-[100px]\" data-kid=\"1-1-1\" data-name=\"decorative gold blurred orb\"></div>\n<div class=\"studio-orb absolute -right-40 top-[560px] h-[500px] w-[400px] rounded-full bg-[#ff0033]/9 blur-[110px]\" data-kid=\"1-1-2\" data-name=\"decorative red blurred orb\"></div>\n<div class=\"studio-orb absolute -left-44 top-[1250px] h-[580px] w-[410px] rounded-full bg-[#4f46e5]/12 blur-[110px]\" data-kid=\"1-1-3\" data-name=\"decorative indigo blurred orb\"></div>\n<div class=\"studio-orb absolute -right-40 bottom-12 h-[470px] w-[400px] rounded-full bg-[#06b6d4]/8 blur-[110px]\" data-kid=\"1-1-4\" data-name=\"decorative cyan blurred orb\"></div>\n</div>\n<header class=\"glass relative rounded-[26px] px-4 pt-4 pb-2\" data-kid=\"1-2\" data-name=\"header bar with glass background\">\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"flex items-center gap-3\" data-kid=\"1-2-1\" data-name=\"brand identity row\">\n<div aria-hidden=\"true\" class=\"glass flex size-12 shrink-0 items-center justify-center rounded-full text-[21px] text-[#e4cf91]\" data-kid=\"1-2-1-1\" data-name=\"brand logo medallion\"><i class=\"icon-play ml-0.5 block size-[21px]\" data-kid=\"1-2-1-1-1\" data-name=\"play triangle logo icon\"></i></div>\n<div class=\"min-w-0\" data-kid=\"1-2-1-2\" data-name=\"brand name block\"><div class=\"text-[19px] font-semibold tracking-[-.4px]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name with separator\">YT Media <span class=\"text-[14px] text-[#e4cf91]\" data-kid=\"1-2-1-2-1-1\" data-name=\"gold bullet separator\">•</span></div><p class=\"mt-0.5 text-[12px] leading-[1.6] text-[#e0dbce]\" data-kid=\"1-2-1-2-2\" data-name=\"brand attribution credits\">Powered by Vorex Agency |<br data-kid=\"1-2-1-2-2-1\" data-name=\"line break\"/>Built by Dhiraj Kondalwar</p></div>\n</div>\n<div class=\"mt-3 flex items-center justify-between border-t border-white/10 pt-1 text-[13px]\" data-kid=\"1-2-2\" data-name=\"header action row\">\n<button class=\"flex min-h-12 items-center gap-2 text-[#e5d5a5]\" data-kid=\"1-2-2-1\" data-name=\"view portal button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-2-2-1-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-arrow-up-right block size-[18px]\" data-kid=\"1-2-2-1-1-1\" data-name=\"arrow-up-right icon\"></i></span>View portal</button>\n<button class=\"flex min-h-12 items-center gap-2 text-[#d7d1c6]\" data-kid=\"1-2-2-2\" data-name=\"sign out button\" type=\"button\">Sign out<span class=\"text-[17px]\" data-kid=\"1-2-2-2-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-log-out block size-[17px]\" data-kid=\"1-2-2-2-1-1\" data-name=\"log-out icon\"></i></span></button>\n</div>\n</header>\n<main class=\"pt-7\" data-kid=\"1-3\" data-name=\"main content area\">\n<h1 class=\"display px-2 text-[35px] font-medium leading-none tracking-[-.5px]\" data-kid=\"1-3-1\" data-name=\"app title heading\">YT Media Studio</h1>\n<p class=\"mt-2 px-2 text-[14px] leading-6 text-[#c9c3b8]\" data-kid=\"1-3-2\" data-name=\"app tagline\">Your collection, your presentation.</p>\n<nav aria-label=\"Studio workspace\" class=\"glass mt-5 grid grid-cols-2 gap-1 rounded-[19px] p-1.5\" data-kid=\"1-3-3\" data-name=\"workspace tab navigation\">\n<button class=\"flex h-12 items-center justify-center gap-2 rounded-[14px] text-[#d5cec0]\" data-kid=\"1-3-3-1\" data-name=\"media tab button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-3-1-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-library block size-[18px]\" data-kid=\"1-3-3-1-1-1\" data-name=\"library icon\"></i></span>Media</button>\n<button aria-current=\"page\" class=\"flex h-12 items-center justify-center gap-2 rounded-[14px] border border-[#d4af37]/25 bg-[#d4af37]/12 font-semibold text-[#ead8a3]\" data-kid=\"1-3-3-2\" data-name=\"site and hero active tab button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-3-2-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-panels-top-left block size-[18px]\" data-kid=\"1-3-3-2-1-1\" data-name=\"panels-top-left icon\"></i></span>Site &amp; hero</button>\n</nav>\n<section aria-labelledby=\"site-heading\" class=\"glass relative mt-5 rounded-[28px] px-5 py-6\" data-kid=\"1-3-4\" data-name=\"site settings section card\">\n<div aria-hidden=\"true\" class=\"absolute inset-x-9 top-0 h-px bg-[linear-gradient(90deg,transparent,#e4cf9166,#06b6d433,transparent)]\" data-kid=\"1-3-4-1\" data-name=\"decorative gold gradient top accent\"></div>\n<h2 class=\"display text-[32px] font-medium leading-none\" data-kid=\"1-3-4-2\" data-name=\"site settings heading\" id=\"site-heading\">Site settings</h2>\n<p class=\"mt-2 text-[13px] leading-6 text-[#c8c0b2]\" data-kid=\"1-3-4-3\" data-name=\"site settings description\">Set the name and finish of your portal.</p>\n<div class=\"mt-5\" data-kid=\"1-3-4-4\" data-name=\"site title field container\">\n<label class=\"mb-2 block text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-4-4-1\" data-name=\"site title label\" for=\"site-title\">Site Title</label>\n<input class=\"well h-[52px] w-full rounded-[18px] px-4 text-[15px]\" data-kid=\"1-3-4-4-2\" data-name=\"site title text input\" id=\"site-title\" type=\"text\" value=\"YT Media\"/>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-4-5\" data-name=\"brand subtitle field container\">\n<label class=\"mb-2 block text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-4-5-1\" data-name=\"brand subtitle label\" for=\"brand-subtitle\">Brand Attribution Subtitle</label>\n<textarea class=\"well min-h-[114px] w-full resize-none rounded-[18px] px-4 py-3 text-[14px] leading-6\" data-kid=\"1-3-4-5-2\" data-name=\"brand subtitle textarea\" id=\"brand-subtitle\" rows=\"3\">Powered by Vorex Agency • Built by Dhiraj Kondalwar</textarea>\n<p class=\"mt-2 text-[12px] leading-5 text-[#bcb5a9]\" data-kid=\"1-3-4-5-3\" data-name=\"brand subtitle helper text\">The required agency and builder credit stays visible in your header and footer.</p>\n</div>\n<fieldset class=\"mt-6\" data-kid=\"1-3-4-6\" data-name=\"accent theme radio group\">\n<legend class=\"mb-3 text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-4-6-1\" data-name=\"accent theme group legend\">Liquid Glass Accent Theme</legend>\n<div class=\"grid grid-cols-2 gap-2.5\" data-kid=\"1-3-4-6-2\" data-name=\"accent theme grid\">\n<label class=\"well flex min-h-[60px] items-center gap-2 rounded-[16px] px-3\" data-kid=\"1-3-4-6-2-1\" data-name=\"crimson luxe theme option\"><input class=\"size-4 shrink-0 accent-[#ff0033]\" data-kid=\"1-3-4-6-2-1-1\" data-name=\"crimson radius input\" name=\"accent-theme\" type=\"radio\" value=\"Crimson Luxe\"/><span class=\"text-[12px] leading-5 text-[#e6ded9]\" data-kid=\"1-3-4-6-2-1-2\" data-name=\"crimson theme label\">Crimson Luxe</span></label>\n<label class=\"flex min-h-[60px] items-center gap-2 rounded-[16px] border border-[#d4af37]/55 bg-[#d4af37]/10 px-3 shadow-[inset_0_1px_1px_#ffffff25]\" data-kid=\"1-3-4-6-2-2\" data-name=\"royal gold theme option\"><input checked=\"\" class=\"size-4 shrink-0 accent-[#e4cf91]\" data-kid=\"1-3-4-6-2-2-1\" data-name=\"royal gold radio input\" name=\"accent-theme\" type=\"radio\" value=\"Royal Gold\"/><span class=\"text-[12px] font-semibold leading-5 text-[#ead8a3]\" data-kid=\"1-3-4-6-2-2-2\" data-name=\"royal gold theme label\">Royal Gold</span></label>\n<label class=\"well flex min-h-[60px] items-center gap-2 rounded-[16px] px-3\" data-kid=\"1-3-4-6-2-3\" data-name=\"cyber violet theme option\"><input class=\"size-4 shrink-0 accent-[#8a80ed]\" data-kid=\"1-3-4-6-2-3-1\" data-name=\"cyber violet radio input\" name=\"accent-theme\" type=\"radio\" value=\"Cyber Violet\"/><span class=\"text-[12px] leading-5 text-[#e6ded9]\" data-kid=\"1-3-4-6-2-3-2\" data-name=\"cyber violet theme label\">Cyber Violet</span></label>\n<label class=\"well flex min-h-[60px] items-center gap-2 rounded-[16px] px-3\" data-kid=\"1-3-4-6-2-4\" data-name=\"emerald theme option\"><input class=\"size-4 shrink-0 accent-[#42c895]\" data-kid=\"1-3-4-6-2-4-1\" data-name=\"emerald radio input\" name=\"accent-theme\" type=\"radio\" value=\"Emerald\"/><span class=\"text-[12px] leading-5 text-[#e6ded9]\" data-kid=\"1-3-4-6-2-4-2\" data-name=\"emerald theme label\">Emerald</span></label>\n</div>\n</fieldset>\n<button class=\"mt-6 flex h-[52px] w-full items-center justify-center gap-2.5 rounded-full bg-[#e4cf91] text-[14px] font-bold text-[#252015] active:scale-[.98]\" data-kid=\"1-3-4-7\" data-name=\"save site settings button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-4-7-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-check block size-[18px]\" data-kid=\"1-3-4-7-1-1\" data-name=\"checkmark icon\"></i></span>Save site settings</button>\n</section>\n<section aria-labelledby=\"hero-heading\" class=\"glass relative mt-5 rounded-[28px] px-5 py-6\" data-kid=\"1-3-5\" data-name=\"hero banner section card\">\n<div aria-hidden=\"true\" class=\"absolute inset-x-9 top-0 h-px bg-[linear-gradient(90deg,transparent,#e4cf9166,#06b6d433,transparent)]\" data-kid=\"1-3-5-1\" data-name=\"decorative gold gradient top accent\"></div>\n<h2 class=\"display text-[32px] font-medium leading-none\" data-kid=\"1-3-5-2\" data-name=\"hero banner heading\" id=\"hero-heading\">Hero banner</h2>\n<p class=\"mt-2 text-[13px] leading-6 text-[#c8c0b2]\" data-kid=\"1-3-5-3\" data-name=\"hero banner description\">Choose what welcomes your viewers.</p>\n<div class=\"mt-5 flex min-h-[56px] items-center justify-between gap-4 border-y border-white/10 py-3\" data-kid=\"1-3-5-4\" data-name=\"banner visibility toggle row\">\n<label class=\"text-[14px] font-semibold\" data-kid=\"1-3-5-4-1\" data-name=\"show hero banner label\" for=\"hero-visible\">Show Hero Banner</label>\n<label class=\"relative flex h-12 w-14 shrink-0 items-center justify-center\" data-kid=\"1-3-5-4-2\" data-name=\"show hero toggle switch\"><input checked=\"\" class=\"peer sr-only\" data-kid=\"1-3-5-4-2-1\" data-name=\"hero visible checkbox\" id=\"hero-visible\" type=\"checkbox\"/><span class=\"flex h-7 w-12 items-center rounded-full border border-[#e4cf91]/45 bg-[#d4af37]/25 px-1\" data-kid=\"1-3-5-4-2-2\" data-name=\"toggle switch track\"><span class=\"ml-auto size-[19px] rounded-full bg-[#e4cf91] shadow-[0_1px_5px_#d4af3730]\" data-kid=\"1-3-5-4-2-2-1\" data-name=\"toggle knob\"></span></span></label>\n</div>\n<p class=\"mt-2 text-[12px] leading-5 text-[#bcb5a9]\" data-kid=\"1-3-5-5\" data-name=\"hide banner helper text\">Hiding the banner won’t remove its media.</p>\n<div class=\"mt-6 flex items-center justify-between\" data-kid=\"1-3-5-6\" data-name=\"banner preview header\"><h3 class=\"text-[14px] font-semibold text-[#e6dfcf]\" data-kid=\"1-3-5-6-1\" data-name=\"banner preview title\">Banner preview</h3><span class=\"text-[12px] text-[#c6b987]\" data-kid=\"1-3-5-6-2\" data-name=\"phone layout tag\">Phone layout</span></div>\n<div class=\"aperture relative isolate mt-3 h-[278px] overflow-hidden bg-[#171d20]\" data-kid=\"1-3-5-7\" data-name=\"hero banner aperture preview frame\">\n<img alt=\"Silver surf on a volcanic coastline — Lorenzo Alessio Messina on Pexels\" class=\"hero-preview-photo absolute inset-0 -z-20 size-full object-cover object-[center_57%]\" data-kid=\"1-3-5-7-1\" data-name=\"hero preview background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=780&amp;h=780&amp;fit=crop&amp;q=85\"/>\n<div aria-hidden=\"true\" class=\"absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(4,7,9,.96),rgba(4,7,9,.1)_95%)]\" data-kid=\"1-3-5-7-2\" data-name=\"hero preview bottom gradient overlay\"></div>\n<div class=\"absolute inset-x-5 bottom-5\" data-kid=\"1-3-5-7-3\" data-name=\"hero preview content\">\n<h4 class=\"display text-[38px] font-medium leading-[.93] tracking-[-.5px]\" data-kid=\"1-3-5-7-3-1\" data-name=\"hero preview headline\">Where the<br data-kid=\"1-3-5-7-3-1-1\" data-name=\"line break\"/>land ends</h4>\n<p class=\"mt-3 text-[11px] text-[#e4d7b5]\" data-kid=\"1-3-5-7-3-2\" data-name=\"hero preview category\">Coastal film</p>\n<p class=\"mt-2 text-[12px] leading-5 text-[#deddd7]\" data-kid=\"1-3-5-7-3-3\" data-name=\"hero preview description\">Black sand, silver water. A moment at the edge of Iceland.</p>\n<button class=\"mt-3 flex min-h-12 items-center gap-2 rounded-full bg-[#e4cf91] px-4 text-[12px] font-bold text-[#211d12]\" data-kid=\"1-3-5-7-3-4\" data-name=\"play featured button\" type=\"button\"><span class=\"text-[15px]\" data-kid=\"1-3-5-7-3-4-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-play block size-[15px]\" data-kid=\"1-3-5-7-3-4-1-1\" data-name=\"play triangle icon\"></i></span>Play Featured</button>\n</div>\n</div>\n<div class=\"mt-6\" data-kid=\"1-3-5-8\" data-name=\"banner image field container\">\n<label class=\"mb-2 block text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-5-8-1\" data-name=\"banner image URL label\" for=\"banner-image\">Banner Image URL</label>\n<input class=\"well h-[52px] w-full min-w-0 rounded-[18px] px-4 text-[13px]\" data-kid=\"1-3-5-8-2\" data-name=\"banner image URL input\" id=\"banner-image\" type=\"url\" value=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg\"/>\n<p class=\"mt-2 text-[12px] leading-5 text-[#bcb5a9]\" data-kid=\"1-3-5-8-3\" data-name=\"banner image helper text\">Direct image URLs and Google Drive links.</p>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-5-9\" data-name=\"banner heading field container\">\n<label class=\"mb-2 block text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-5-9-1\" data-name=\"banner heading label\" for=\"banner-heading\">Banner Heading</label>\n<input class=\"well h-[52px] w-full rounded-[18px] px-4 text-[14px]\" data-kid=\"1-3-5-9-2\" data-name=\"banner heading text input\" id=\"banner-heading\" type=\"text\" value=\"Where the land ends\"/>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-5-10\" data-name=\"banner description field container\">\n<label class=\"mb-2 block text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-5-10-1\" data-name=\"banner description label\" for=\"banner-description\">Banner Description</label>\n<textarea class=\"well min-h-[114px] w-full resize-none rounded-[18px] px-4 py-3 text-[14px] leading-6\" data-kid=\"1-3-5-10-2\" data-name=\"banner description textarea\" id=\"banner-description\" rows=\"3\">Black sand, silver water. A moment at the edge of Iceland.</textarea>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-5-11\" data-name=\"featured media field container\">\n<label class=\"mb-2 block text-[14px] font-semibold text-[#e8e3d8]\" data-kid=\"1-3-5-11-1\" data-name=\"featured media link label\" for=\"featured-media\">Featured Media Link</label>\n<input class=\"well h-[52px] w-full rounded-[18px] px-4 text-[14px] placeholder:text-[#a9a395]\" data-kid=\"1-3-5-11-2\" data-name=\"featured media URL input\" id=\"featured-media\" placeholder=\"Paste a media link\" type=\"url\"/>\n<p class=\"mt-2 text-[12px] leading-5 text-[#bcb5a9]\" data-kid=\"1-3-5-11-3\" data-name=\"featured media helper text\">YouTube, Google Drive or a direct media URL.</p>\n</div>\n<button class=\"mt-6 flex h-[52px] w-full items-center justify-center gap-2.5 rounded-full bg-[#e4cf91] text-[14px] font-bold text-[#252015] active:scale-[.98]\" data-kid=\"1-3-5-12\" data-name=\"save hero banner button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-5-12-1\" data-name=\"icon wrapper\"><i aria-hidden=\"true\" class=\"icon-check block size-[18px]\" data-kid=\"1-3-5-12-1-1\" data-name=\"checkmark icon\"></i></span>Save hero banner</button>\n</section>\n</main>\n<footer class=\"mx-3 mt-7 border-t border-white/10 pt-5 text-center text-[12px] leading-6 text-[#cfc6b4]\" data-kid=\"1-4\" data-name=\"footer credits\">YT Media • Powered by Vorex Agency |<br data-kid=\"1-4-1\" data-name=\"line break\"/>Built by Dhiraj Kondalwar</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif (typeof gsap !== 'undefined') { gsap.to('.studio-orb',{x:22,y:24,duration:17,stagger:2,repeat:-1,yoyo:true,ease:'sine.inOut'}); gsap.to('.hero-preview-photo',{scale:1.045,duration:24,repeat:-1,yoyo:true,ease:'sine.inOut'}); }\n</script>",
