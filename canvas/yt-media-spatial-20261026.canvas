      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Heebo:wght@400;450;500;600;700&family=Staatliches&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\nhtml, body { height: 100%; background: #040407; }\n.yt-phone { font-family: 'Heebo', sans-serif; color: #f5f3ea; background: #040407; container-type: size; }\n.yt-shorts .yt-card { width: 145px; }\n.yt-display { font-family: 'Staatliches', sans-serif; font-weight: 400; }\n.yt-glass { background: linear-gradient(125deg,rgba(255,255,255,.095),rgba(255,255,255,.025)); backdrop-filter: blur(30px) saturate(200%); -webkit-backdrop-filter: blur(30px) saturate(200%); border: 1px solid rgba(222,220,238,.19); box-shadow: inset 0 1px 1px rgba(255,255,255,.25); }\n.yt-scroll { scrollbar-width: none; overscroll-behavior: contain; }\n.yt-scroll::-webkit-scrollbar { display: none; }\n.yt-shelf { scroll-snap-type: x mandatory; scroll-padding-left: 18px; }\n.yt-shelf > article { scroll-snap-align: start; }\n.yt-phone button { cursor: pointer; -webkit-tap-highlight-color: transparent; }\n.yt-phone button:active { transform: scale(.96); }\n.yt-phone button:focus-visible { outline: 2px solid #d4af37; outline-offset: 3px; }\n.yt-card { border-radius: 20px; overflow: hidden; background: rgba(255,255,255,.04); box-shadow: inset 0 1px 1px #ffffff40; }\n.yt-shorts { background: radial-gradient(ellipse at 10% 40%,#4f46e520,transparent 75%); }\n.yt-videos { background: radial-gradient(ellipse at 90% 30%,#ff003318,transparent 72%); }\n.yt-posts { background: radial-gradient(ellipse at 0% 30%,#06b6d418,transparent 70%); }\n</style>\n<!-- Node var_07d5c4d80094 · Direction 2 / Format Rooms / Phone Home. Reviewed for 390px. Stateless visual preview: media playback, search, admin authentication and vault locking are not implemented. Persistent chrome is contained in this independently scrolling view; no viewport positioning is used. -->\n<div class=\"yt-phone relative isolate mx-auto grid h-full w-full max-w-[480px] grid-rows-[auto_minmax(0,1fr)_auto] overflow-clip\" data-kid=\"1\" data-name=\"phone home page layout container\" data-node-id=\"var_07d5c4d80094\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background glow container\">\n<div class=\"absolute -left-28 -top-20 h-96 w-80 rounded-full bg-[#d4af37]/10 blur-[75px]\" data-kid=\"1-1-1\" data-name=\"amber decorative blur orb\"></div>\n<div class=\"absolute -right-40 top-[390px] h-96 w-80 rounded-full bg-[#4f46e5]/15 blur-[80px]\" data-kid=\"1-1-2\" data-name=\"indigo decorative blur orb\"></div>\n<div class=\"absolute -left-32 bottom-0 h-64 w-64 rounded-full bg-[#06b6d4]/10 blur-[70px]\" data-kid=\"1-1-3\" data-name=\"cyan decorative blur orb\"></div>\n<div class=\"absolute -right-20 bottom-0 h-44 w-44 rounded-full bg-[#ff0033]/10 blur-[65px]\" data-kid=\"1-1-4\" data-name=\"red decorative blur orb\"></div>\n</div>\n<header class=\"yt-glass relative z-20 mx-3 mt-3 rounded-[20px] px-3 pb-3 pt-1.5\" data-kid=\"1-2\" data-name=\"app top header bar with glass effect\">\n<div class=\"flex items-center justify-between gap-1\" data-kid=\"1-2-1\" data-name=\"header top row\">\n<span class=\"yt-display whitespace-nowrap text-[26px] leading-none\" data-kid=\"1-2-1-1\" data-name=\"app brand wordmark\">YT Media</span>\n<div class=\"flex shrink-0 items-center text-[20px]\" data-kid=\"1-2-1-2\" data-name=\"header action buttons group\">\n<button aria-label=\"Search\" class=\"flex size-12 items-center justify-center rounded-full text-[#f5f3ea]\" data-kid=\"1-2-1-2-1\" data-name=\"search icon button\" title=\"Search\" type=\"button\"><i aria-hidden=\"true\" class=\"icon icon-search\" data-kid=\"1-2-1-2-1-1\" data-name=\"search magnifying glass icon\"></i></button>\n<button aria-label=\"Admin Studio\" class=\"flex size-12 items-center justify-center rounded-full text-[#f5f3ea]\" data-kid=\"1-2-1-2-2\" data