      "themeId": null,
      "rect": {
        "x": 8610,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n@layer components {\n.yt-settings {font-family:'Raleway',sans-serif;background:#040407;color:#f5f3ea;--gold:#d4af37;}\n.yt-settings .display {font-family:'Cormorant',serif;}\n.yt-settings .glass {background:linear-gradient(120deg,rgba(255,255,255,.065),rgba(255,255,255,.025));backdrop-filter:blur(30px) saturate(200%);border:1px solid rgba(245,243,234,.14);box-shadow:inset 0 1px 1px rgba(255,255,255,.2);}\n.yt-settings .well {background:rgba(4,4,7,.38);border:1px solid rgba(245,243,234,.14);box-shadow:inset 0 1px 2px #04040766;}\n.yt-settings .aperture {border-radius:28px 28px 42px 42px / 28px 28px 24px 24px;border:1px solid rgba(245,230,185,.32);box-shadow:inset 0 1px 1px #ffffff40;}\n.yt-settings i {display:inline-flex;align-items:center;justify-content:center;width:1em;height:1em;color:inherit;}\n.yt-settings input,.yt-settings textarea {outline:none;}\n.yt-settings input:focus-visible,.yt-settings textarea:focus-visible,.yt-settings button:focus-visible {outline:2px solid #d4af37;outline-offset:4px;}\n.yt-settings button {cursor:default;}\n}\n</style>\n<div class=\"yt-settings relative isolate min-h-[1240px] overflow-x-clip px-7 pt-6 pb-7 text-[14px] font-medium\" data-kid=\"1\" data-name=\"settings page layout container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative glow background layer\">\n<div class=\"settings-orb absolute -left-44 -top-36 h-[700px] w-[700px] rounded-full bg-[#d4af37]/10 blur-[130px]\" data-kid=\"1-1-1\" data-name=\"gold ambient glow orb\"></div>\n<div class=\"settings-orb absolute -right-36 top-[240px] h-[600px] w-[650px] rounded-full bg-[#ff0033]/9 blur-[130px]\" data-kid=\"1-1-2\" data-name=\"red ambient glow orb\"></div>\n<div class=\"settings-orb absolute right-[15%] bottom-0 h-[500px] w-[650px] rounded-full bg-[#06b6d4]/7 blur-[135px]\" data-kid=\"1-1-3\" data-name=\"cyan ambient glow orb\"></div>\n<div class=\"settings-orb absolute -left-40 bottom-0 h-[600px] w-[700px] rounded-full bg-[#4f46e5]/10 blur-[145px]\" data-kid=\"1-1-4\" data-name=\"indigo ambient glow orb\"></div>\n</div>\n<header class=\"glass flex h-[88px] items-center justify-between gap-8 rounded-[28px] px-5\" data-kid=\"1-2\" data-name=\"app header bar\">\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"flex w-[374px] shrink-0 items-center gap-3.5\" data-kid=\"1-2-1\" data-name=\"brand identity block\">\n<span aria-hidden=\"true\" class=\"glass flex size-[49px] shrink-0 items-center justify-center rounded-full text-[21px] text-[#e6ce8c]\" data-kid=\"1-2-1-1\" data-name=\"brand logo badge\"><i class=\"icon-play ml-0.5\" data-kid=\"1-2-1-1-1\" data-name=\"play triangle logo icon\"></i></span>\n<div class=\"leading-[1.4]\" data-kid=\"1-2-1-2\" data-name=\"brand name and attribution text\"><span class=\"block text-[20px] font-semibold tracking-[-.5px]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name text\">YT Media <span class=\"text-[14px] text-[#d6bf7c]\" data-kid=\"1-2-1-2-1-1\" data-name=\"brand name bullet separator\">•</span></span><span class=\"mt-0.5 block text-[13px] text-[#e2dfd6]\" data-kid=\"1-2-1-2-2\">Powered by Vorex Agency |<br data-kid=\"1-2-1-2-2-1\"/>Built by Dhiraj Kondalwar</span></div>\n</div>\n<div class=\"flex flex-1 items-center gap-3 border-l border-white/12 pl-7\" data-kid=\"1-2-2\"><span class=\"text-[21px] text-[#d4bd7c]\" data-kid=\"1-2-2-1\"><i class=\"icon-sliders-horizontal\" data-kid=\"1-2-2-1-1\"></i></span><span class=\"text-[19px] font-semibold tracking-[-.3px]\" data-kid=\"1-2-2-2\">YT Media Studio</span></div>\n<div class=\"flex items-center gap-5\" data-kid=\"1-2-3\"><button class=\"flex h-12 items-center gap-2.5 rounded-[17px] border border-[#dfc67d]/25 bg-[#d4af37]/5 px-4 text-[#e8d8a7]\" data-kid=\"1-2-3-1\" type=\"button\">View portal<span class=\"text-[17px]\" data-kid=\"1-2-3-1-1\"><i class=\"icon-arrow-up-right\" data-kid=\"1-2-3-1-1-1\"></i></span></button><span class=\"h-6 w-px bg-white/12\" data-kid=\"1-2-3-2\"></span><button class=\"flex h-12 items-center gap-2.5 text-[#d8d5cc]\" data-kid=\"1-2-3-3\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-2-3-3-1\"><i class=\"icon-log-out\" data-kid=\"1-2-3-3-1-1\"></i></span>Sign out</button></div>\n</header>\n<main class=\"mx-auto mt-8 max-w-[1296px]\" data-kid=\"1-3\">\n<div class=\"mb-7 flex items-end justify-between gap-8\" data-kid=\"1-3-1\">\n<div data-kid=\"1-3-1-1\"><h1 class=\"display text-[48px] font-medium leading-none tracking-[-.8px]\" data-kid=\"1-3-1-1-1\">Site &amp; hero</h1><p class=\"mt-3 text-[15px] leading-6 text-[#c5c0b5]\" data-kid=\"1-3-1-1-2\">Set the first impression of your private collection.</p></div>\n<nav aria-label=\"Studio workspace\" class=\"glass mb-1 flex items-center gap-1 rounded-[19px] p-1.5\" data-kid=\"1-3-1-2\"><button class=\"flex h-11 items-center gap-2 rounded-[14px] px-5 text-[#c8c3b9]\" data-kid=\"1-3-1-2-1\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-1-2-1-1\"><i class=\"icon-clapperboard\" data-kid=\"1-3-1-2-1-1-1\"></i></span>Media</button><button aria-current=\"page\" class=\"flex h-11 items-center gap-2 rounded-[14px] border border-[#d4af37]/25 bg-[#d4af37]/12 px-5 font-semibold text-[#e7d29b]\" data-kid=\"1-3-1-2-2\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-1-2-2-1\"><i class=\"icon-panels-top-left\" data-kid=\"1-3-1-2-2-1-1\"></i></span>Site &amp; hero</button></nav>\n</div>\n<section aria-labelledby=\"site-settings-heading\" class=\"glass rounded-[28px] px-7 py-6\" data-kid=\"1-3-2\">\n<div class=\"flex items-center justify-between gap-5\" data-kid=\"1-3-2-1\"><h2 class=\"display text-[30px] font-medium leading-none\" data-kid=\"1-3-2-1-1\" id=\"site-settings-heading\">Site settings</h2><p class=\"text-[13px] text-[#bcb7ac]\" data-kid=\"1-3-2-1-2\">Your identity across the portal</p></div>\n<div class=\"mt-6 grid grid-cols-[.7fr_1.3fr] gap-6\" data-kid=\"1-3-2-2\">\n<div data-kid=\"1-3-2-2-1\"><label class=\"mb-2.5 block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-2-2-1-1\" for=\"site-title\">Site Title</label><input class=\"well h-[48px] w-full rounded-[16px] px-4 text-[15px] text-[#f1ede4]\" data-kid=\"1-3-2-2-1-2\" id=\"site-title\" value=\"YT Media\"/></div>\n<div data-kid=\"1-3-2-2-2\"><label class=\"mb-2.5 block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-2-2-2-1\" for=\"brand-subtitle\">Brand Attribution Subtitle</label><input class=\"well h-[48px] w-full rounded-[16px] px-4 text-[14px] text-[#f1ede4]\" data-kid=\"1-3-2-2-2-2\" id=\"brand-subtitle\" value=\"Powered by Vorex Agency • Built by Dhiraj Kondalwar\"/></div>\n</div>\n<div class=\"mt-5 flex items-end justify-between gap-7\" data-kid=\"1-3-2-3\">\n<fieldset class=\"min-w-0\" data-kid=\"1-3-2-3-1\"><legend class=\"mb-3 text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-2-3-1-1\">Liquid Glass Accent Theme</legend><div class=\"flex flex-wrap gap-2.5\" data-kid=\"1-3-2-3-1-2\">\n<button aria-pressed=\"false\" class=\"well flex h-[43px] items-center gap-2.5 rounded-full px-4 text-[13px] text-[#d1cbc0]\" data-kid=\"1-3-2-3-1-2-1\" type=\"button\"><span aria-hidden=\"true\" class=\"size-2.5 rounded-full bg-[#ff0033]\" data-kid=\"1-3-2-3-1-2-1-1\"></span>Crimson Luxe</button>\n<button aria-pressed=\"true\" class=\"flex h-[43px] items-center gap-2.5 rounded-full border border-[#d4af37]/50 bg-[#d4af37]/10 px-4 text-[13px] font-semibold text-[#ead79f]\" data-kid=\"1-3-2-3-1-2-2\" type=\"button\"><span aria-hidden=\"true\" class=\"size-2.5 rounded-full bg-[#d4af37]\" data-kid=\"1-3-2-3-1-2-2-1\"></span>Royal Gold<span class=\"ml-1 text-[15px]\" data-kid=\"1-3-2-3-1-2-2-2\"><i class=\"icon-check\" data-kid=\"1-3-2-3-1-2-2-2-1\"></i></span></button>\n<button aria-pressed=\"false\" class=\"well flex h-[43px] items-center gap-2.5 rounded-full px-4 text-[13px] text-[#d1cbc0]\" data-kid=\"1-3-2-3-1-2-3\" type=\"button\"><span aria-hidden=\"true\" class=\"size-2.5 rounded-full bg-[#7d72e9]\" data-kid=\"1-3-2-3-1-2-3-1\"></span>Cyber Violet</button>\n<button aria-pressed=\"false\" class=\"well flex h-[43px] items-center gap-2.5 rounded-full px-4 text-[13px] text-[#d1cbc0]\" data-kid=\"1-3-2-3-1-2-4\" type=\"button\"><span aria-hidden=\"true\" class=\"size-2.5 rounded-full bg-[#2dbb91]\" data-kid=\"1-3-2-3-1-2-4-1\"></span>Emerald</button>\n</div></fieldset>\n<button class=\"flex h-[45px] shrink-0 items-center gap-2 rounded-[15px] border border-[#d4af37]/35 bg-[#d4af37]/6 px-5 text-[14px] font-semibold text-[#e8d4a0]\" data-kid=\"1-3-2-3-2\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-3-2-3-2-1\"><i class=\"icon-save\" data-kid=\"1-3-2-3-2-1-1\"></i></span>Save site settings</button>\n</div>\n<p class=\"mt-4 text-[13px] leading-5 text-[#bcb6aa]\" data-kid=\"1-3-2-4\">Required brand credits remain visible in the header and footer.</p>\n</section>\n<section aria-labelledby=\"hero-settings-heading\" class=\"mt-8\" data-kid=\"1-3-3\">\n<div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-3-3-1\"><h2 class=\"display text-[34px] font-medium\" data-kid=\"1-3-3-1-1\" id=\"hero-settings-heading\">Hero banner</h2><span class=\"flex items-center gap-2 text-[13px] text-[#e2c885]\" data-kid=\"1-3-3-1-2\"><span class=\"size-1.5 rounded-full bg-[#d4af37]\" data-kid=\"1-3-3-1-2-1\"></span>Unsaved changes</span></div>\n<div class=\"grid grid-cols-[minmax(0,.95fr)_minmax(0,1.05fr)] items-start gap-8\" data-kid=\"1-3-3-2\">\n<div class=\"glass rounded-[28px] p-6\" data-kid=\"1-3-3-2-1\">\n<div data-kid=\"1-3-3-2-1-1\"><label class=\"mb-2.5 block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-3-2-1-1-1\" for=\"banner-image\">Banner Image URL</label><div class=\"relative\" data-kid=\"1-3-3-2-1-1-2\"><span aria-hidden=\"true\" class=\"pointer-events-none absolute left-4 top-4 text-[17px] text-[#b7b1a5]\" data-kid=\"1-3-3-2-1-1-2-1\"><i class=\"icon-image\" data-kid=\"1-3-3-2-1-1-2-1-1\"></i></span><input class=\"well h-[49px] w-full rounded-[16px] pr-4 pl-11 text-[13px] text-[#e4ded3]\" data-kid=\"1-3-3-2-1-1-2-2\" id=\"banner-image\" type=\"url\" value=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg\"/></div><p class=\"mt-2 text-[13px] leading-5 text-[#bcb5a7]\" data-kid=\"1-3-3-2-1-1-3\">Google Drive image links or direct image URLs.</p></div>\n<div class=\"mt-5\" data-kid=\"1-3-3-2-1-2\"><label class=\"mb-2.5 block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-3-2-1-2-1\" for=\"banner-heading\">Banner Heading</label><input class=\"well h-[49px] w-full rounded-[16px] px-4 text-[15px] text-[#f1ede4]\" data-kid=\"1-3-3-2-1-2-2\" id=\"banner-heading\" value=\"Where the land ends\"/></div>\n<div class=\"mt-5\" data-kid=\"1-3-3-2-1-3\"><label class=\"mb-2.5 block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-3-2-1-3-1\" for=\"banner-description\">Banner Description</label><textarea class=\"well min-h-[88px] w-full resize-none rounded-[16px] px-4 py-3.5 text-[14px] leading-6 text-[#e5dfd3]\" data-kid=\"1-3-3-2-1-3-2\" id=\"banner-description\" rows=\"2\">Black sand, silver water. A moment at the edge of Iceland.</textarea></div>\n<div class=\"mt-5\" data-kid=\"1-3-3-2-1-4\"><label class=\"mb-2.5 block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-3-2-1-4-1\" for=\"featured-link\">Featured Media Link</label><div class=\"relative\" data-kid=\"1-3-3-2-1-4-2\"><span aria-hidden=\"true\" class=\"pointer-events-none absolute left-4 top-4 text-[17px] text-[#b7b1a5]\" data-kid=\"1-3-3-2-1-4-2-1\"><i class=\"icon-link\" data-kid=\"1-3-3-2-1-4-2-1-1\"></i></span><input class=\"well h-[49px] w-full rounded-[16px] pr-4 pl-11 text-[13px] text-[#e4ded3] placeholder:text-[#a9a399]\" data-kid=\"1-3-3-2-1-4-2-2\" id=\"featured-link\" placeholder=\"Paste a YouTube, Drive or direct video URL\" type=\"url\"/></div></div>\n<div class=\"mt-6 flex items-center justify-between gap-5 border-t border-white/10 pt-5\" data-kid=\"1-3-3-2-1-5\"><div data-kid=\"1-3-3-2-1-5-1\"><label class=\"block text-[14px] font-semibold text-[#e4dfd3]\" data-kid=\"1-3-3-2-1-5-1-1\" id=\"hero-visible-label\">Show Hero Banner</label><p class=\"mt-1.5 max-w-[350px] text-[13px] leading-5 text-[#bcb5a7]\" data-kid=\"1-3-3-2-1-5-1-2\">Hiding the banner does not delete the featured media.</p></div><button aria-checked=\"true\" aria-labelledby=\"hero-visible-label\" class=\"relative h-[29px] w-[50px] shrink-0 rounded-full border border-[#e3cd88]/35 bg-[#d4af37]/70 shadow-[inset_0_1px_2px_#ffffff22]\" data-kid=\"1-3-3-2-1-5-2\" role=\"switch\" type=\"button\"><span class=\"absolute top-[3px] right-[3px] size-[21px] rounded-full bg-[#fcf5df] shadow-sm\" data-kid=\"1-3-3-2-1-5-2-1\"></span></button></div>\n<div class=\"mt-6 flex items-center justify-between gap-5\" data-kid=\"1-3-3-2-1-6\"><button class=\"flex h-[48px] items-center gap-2.5 rounded-[16px] bg-[#e4cf91] px-5 text-[14px] font-bold text-[#211d12]\" data-kid=\"1-3-3-2-1-6-1\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-3-2-1-6-1-1\"><i class=\"icon-save\" data-kid=\"1-3-3-2-1-6-1-1-1\"></i></span>Save hero banner</button><button class=\"h-[44px] px-1 text-[14px] text-[#c7c0b2]\" data-kid=\"1-3-3-2-1-6-2\" type=\"button\">Discard changes</button></div>\n</div>\n<div class=\"min-w-0 pt-0.5\" data-kid=\"1-3-3-2-2\">\n<div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-3-3-2-2-1\"><h3 class=\"text-[15px] font-semibold text-[#e6e0d3]\" data-kid=\"1-3-3-2-2-1-1\">Banner preview</h3><span class=\"flex items-center gap-2 text-[13px] text-[#c1b9aa]\" data-kid=\"1-3-3-2-2-1-2\"><span class=\"text-[17px]\" data-kid=\"1-3-3-2-2-1-2-1\"><i class=\"icon-monitor\" data-kid=\"1-3-3-2-2-1-2-1-1\"></i></span>Desktop</span></div>\n<div class=\"aperture relative isolate h-[435px] overflow-hidden bg-[#181d20]\" data-kid=\"1-3-3-2-2-2\">\n<img alt=\"Silver surf following a volcanic coastline at dusk — Lorenzo Alessio Messina on Pexels\" class=\"hero-still absolute inset-0 -z-20 size-full object-cover object-[center_57%]\" data-kid=\"1-3-3-2-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200&amp;h=870&amp;fit=crop&amp;q=85\"/>\n<div aria-hidden=\"true\" class=\"absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(4,7,9,.78),rgba(4,7,9,.12)),linear-gradient(0deg,rgba(4,7,9,.85),transparent_85%)]\" data-kid=\"1-3-3-2-2-2-2\"></div>\n<div aria-hidden=\"true\" class=\"absolute inset-x-8 top-0 h-px bg-[linear-gradient(90deg,transparent,#f5e8b2aa,#d4af3722,#06b6d440,transparent)]\" data-kid=\"1-3-3-2-2-2-3\"></div>\n<div class=\"absolute bottom-8 left-8 right-7\" data-kid=\"1-3-3-2-2-2-4\"><h4 class=\"display text-[59px] font-medium leading-[.9] tracking-[-1px] text-[#fbf8ee]\" data-kid=\"1-3-3-2-2-2-4-1\">Where the<br data-kid=\"1-3-3-2-2-2-4-1-1\"/>land ends</h4><p class=\"mt-4 flex items-center gap-3 text-[12px] text-[#e3d5b1]\" data-kid=\"1-3-3-2-2-2-4-2\"><span data-kid=\"1-3-3-2-2-2-4-2-1\">Coastal film</span><span aria-hidden=\"true\" class=\"size-[3px] rounded-full bg-[#c9b98e]\" data-kid=\"1-3-3-2-2-2-4-2-2\"></span><span data-kid=\"1-3-3-2-2-2-4-2-3\">12 min</span><span aria-hidden=\"true\" class=\"size-[3px] rounded-full bg-[#c9b98e]\" data-kid=\"1-3-3-2-2-2-4-2-4\"></span><span data-kid=\"1-3-3-2-2-2-4-2-5\">4K</span></p><p class=\"mt-3 max-w-[360px] text-[14px] leading-6 text-[#e0dfda]\" data-kid=\"1-3-3-2-2-2-4-3\">Black sand, silver water. A moment at the edge of Iceland.</p><span class=\"mt-5 inline-flex h-[44px] items-center gap-2.5 rounded-full bg-[#e4cf91] px-5 text-[13px] font-bold text-[#211d12]\" data-kid=\"1-3-3-2-2-2-4-4\"><span class=\"text-[16px]\" data-kid=\"1-3-3-2-2-2-4-4-1\"><i class=\"icon-play\" data-kid=\"1-3-3-2-2-2-4-4-1-1\"></i></span>Play Featured</span></div>\n</div>\n<div class=\"mt-5 flex items-start gap-3 px-1 text-[#c0b9aa]\" data-kid=\"1-3-3-2-2-3\"><span class=\"mt-0.5 shrink-0 text-[18px] text-[#d2bc7a]\" data-kid=\"1-3-3-2-2-3-1\"><i class=\"icon-info\" data-kid=\"1-3-3-2-2-3-1-1\"></i></span><p class=\"text-[13px] leading-[1.8]\" data-kid=\"1-3-3-2-2-3-2\">The banner image is shown in context. Add a featured media link to connect the Play Featured action.</p></div>\n<div class=\"mt-7 border-t border-white/10 pt-5\" data-kid=\"1-3-3-2-2-4\"><div class=\"flex items-center justify-between text-[13px]\" data-kid=\"1-3-3-2-2-4-1\"><span class=\"text-[#c5bdae]\" data-kid=\"1-3-3-2-2-4-1-1\">Current accent</span><span class=\"flex items-center gap-2 font-semibold text-[#e2cf93]\" data-kid=\"1-3-3-2-2-4-1-2\"><span aria-hidden=\"true\" class=\"size-2 rounded-full bg-[#d4af37]\" data-kid=\"1-3-3-2-2-4-1-2-1\"></span>Royal Gold</span></div><p class=\"mt-3 text-[13px] leading-6 text-[#b3ac9e]\" data-kid=\"1-3-3-2-2-4-2\">Changes appear on Home after saving. Your media collection stays unchanged.</p></div>\n</div>\n</div>\n</section>\n<footer class=\"mt-8 flex items-center justify-between gap-6 border-t border-white/10 pt-6 pb-2 text-[13px] text-[#c9c1b2]\" data-kid=\"1-3-4\"><p data-kid=\"1-3-4-1\">YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar</p><span class=\"flex items-center gap-2 text-[#b3ac9d]\" data-kid=\"1-3-4-2\"><span class=\"text-[16px]\" data-kid=\"1-3-4-2-1\"><i class=\"icon-sliders-horizontal\" data-kid=\"1-3-4-2-1-1\"></i></span>YT Media Studio</span></footer>\n</main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif (window.gsap) {\n gsap.to('.settings-orb',{x:22,y:18,duration:15,repeat:-1,yoyo:true,ease:'sine.inOut',stagger:2});\n gsap.to('.hero-still',{scale:1.045,duration:24,repeat:-1,yoyo:true,ease:'sine.inOut'});\n}\n