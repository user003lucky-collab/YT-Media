    "var_413f74d95df6": {
      "type": "variant",
      "label": "01 Private Screening — Studio Sign-in / Phone",
      "parentId": "var_6cfb358b5fd6",
      "themeId": null,
      "rect": {
        "x": 490,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n@layer components {\n.studio-entry-phone {font-family:'Raleway',sans-serif;color:#f5f3ea;background:#040407;}\n.studio-entry-phone .display {font-family:'Cormorant',serif;}\n.studio-entry-phone .glass {background:linear-gradient(130deg,rgba(255,255,255,.065),rgba(255,255,255,.025));backdrop-filter:blur(30px) saturate(200%);-webkit-backdrop-filter:blur(30px) saturate(200%);border:1px solid rgba(245,243,234,.16);box-shadow:inset 0 1px 1px rgba(255,255,255,.25);}\n.studio-entry-phone .sign-in-plane {border-color:rgba(230,210,155,.25);border-radius:28px;}\n.studio-entry-phone .form-well {background:rgba(4,4,7,.26);box-shadow:inset 0 1px 1px rgba(255,255,255,.12);border:1px solid rgba(245,243,234,.2);backdrop-filter:blur(30px) saturate(200%);}\n.studio-entry-phone button:focus-visible,.studio-entry-phone input:focus-visible {outline:2px solid #d4af37;outline-offset:4px;}\n.studio-entry-phone .press {transition:transform 160ms ease;}\n.studio-entry-phone .press:active {transform:scale(.97);}\n}\n</style>\n<div class=\"studio-entry-phone relative isolate flex min-h-[100dvh] w-full flex-col overflow-x-clip px-5 pt-5 pb-7 text-[14px]\" data-kid=\"1\" data-name=\"studio sign-in phone screen\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background glow layer\">\n<div class=\"entry-orb absolute -left-40 top-14 h-[440px] w-[350px] rounded-full bg-[#d4af37]/16 blur-[90px]\" data-kid=\"1-1-1\" data-name=\"amber decorative background orb\"></div>\n<div class=\"entry-orb absolute -right-40 top-[230px] h-[340px] w-[300px] rounded-full bg-[#ff0033]/9 blur-[100px]\" data-kid=\"1-1-2\" data-name=\"red decorative background orb\"></div>\n<div class=\"entry-orb absolute -left-36 bottom-0 h-[300px] w-[330px] rounded-full bg-[#4f46e5]/16 blur-[110px]\" data-kid=\"1-1-3\" data-name=\"indigo decorative background orb\"></div>\n<div class=\"entry-orb absolute -right-36 bottom-10 h-[270px] w-[280px] rounded-full bg-[#06b6d4]/10 blur-[95px]\" data-kid=\"1-1-4\" data-name=\"cyan decorative background orb\"></div>\n</div>\n<header aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"glass flex min-h-[90px] items-center gap-3 rounded-[24px] px-4 py-3\" data-kid=\"1-2\" data-name=\"brand header bar\">\n<div aria-hidden=\"true\" class=\"glass flex size-11 shrink-0 items-center justify-center rounded-full text-[#e6ce8c]\" data-kid=\"1-2-1\" data-name=\"brand logo badge\"><i class=\"icon-play ml-0.5 inline-block text-[20px]\" data-kid=\"1-2-1-1\" data-name=\"play triangle logo icon\" style=\"width:20px;height:20px;color:#e6ce8c\"></i></div>\n<div class=\"min-w-0 leading-[1.5]\" data-kid=\"1-2-2\" data-name=\"brand identity text block\"><span class=\"block text-[20px] font-semibold tracking-[-.4px]\" data-kid=\"1-2-2-1\" data-name=\"brand name text\">YT Media <span class=\"text-[14px] text-[#d6bf7c]\" data-kid=\"1-2-2-1-1\" data-name=\"brand name separator dot\">•</span></span><span class=\"mt-0.5 block text-[11.5px] font-medium text-[#e2dfd6]\" data-kid=\"1-2-2-2\" data-name=\"brand agency attribution text\">Powered by Vorex Agency |<br data-kid=\"1-2-2-2-1\" data-name=\"attribution line break\"/>Built by Dhiraj Kondalwar</span></div>\n</header>\n<main aria-labelledby=\"studio-login-heading\" class=\"flex flex-1 items-center py-9\" data-kid=\"1-3\" data-name=\"main sign-in content area\">\n<section aria-label=\"Administrator sign-in\" class=\"glass sign-in-plane relative w-full px-[23px] pt-7 pb-5\" data-kid=\"1-3-1\" data-name=\"sign-in card panel\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-x-8 top-0 h-px bg-[linear-gradient(90deg,transparent,#f5e8b2aa,#06b6d450,transparent)]\" data-kid=\"1-3-1-1\" data-name=\"card top accent line\"></div>\n<div aria-hidden=\"true\" class=\"glass mb-6 flex size-[58px] items-center justify-center rounded-full text-[#e6ce8c]\" data-kid=\"1-3-1-2\" data-name=\"settings icon badge\"><i class=\"icon-sliders-horizontal inline-block text-[24px]\" data-kid=\"1-3-1-2-1\" data-name=\"sliders horizontal icon\" style=\"width:24px;height:24px;color:#e6ce8c\"></i></div>\n<h1 class=\"display text-[38px] font-medium leading-[1.02] tracking-[-.6px]\" data-kid=\"1-3-1-3\" data-name=\"sign-in heading\" id=\"studio-login-heading\">Sign in to<br data-kid=\"1-3-1-3-1\" data-name=\"heading line break\"/>YT Media Studio</h1>\n<p class=\"mt-4 max-w-[270px] text-[14px] font-medium leading-[1.65] text-[#d0cabe]\" data-kid=\"1-3-1-4\" data-name=\"studio access description text\">Studio access is separate from the viewer vault.</p>\n<form aria-label=\"Studio sign-in form\" class=\"mt-7\" data-kid=\"1-3-1-5\" data-name=\"sign-in form\" onsubmit=\"event.preventDefault()\">\n<div data-kid=\"1-3-1-5-1\" data-name=\"email field group\">\n<label class=\"mb-2.5 block text-[14px] font-semibold text-[#eee8dc]\" data-kid=\"1-3-1-5-1-1\" data-name=\"email field label\" for=\"studio-email-phone\">Email</label>\n<div class=\"form-well relative flex h-[54px] items-center rounded-[17px]\" data-kid=\"1-3-1-5-1-2\" data-name=\"email input well\">\n<span aria-hidden=\"true\" class=\"pointer-events-none absolute left-4 flex items-center text-[#bbb4a5]\" data-kid=\"1-3-1-5-1-2-1\" data-name=\"email icon holder\"><i class=\"icon-mail inline-block text-[18px]\" data-kid=\"1-3-1-5-1-2-1-1\" data-name=\"envelope email icon\" style=\"width:18px;height:18px;color:#bbb4a5\"></i></span>\n<input aria-label=\"Email\" autocapitalize=\"none\" autocomplete=\"username\" class=\"h-full w-full min-w-0 rounded-[17px] border-0 bg-transparent pr-4 pl-11 text-[16px] text-[#f5f3ea] outline-hidden\" data-kid=\"1-3-1-5-1-2-2\" data-name=\"email input field\" id=\"studio-email-phone\" name=\"email\" spellcheck=\"false\" type=\"email\"/>\n</div>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-1-5-2\" data-name=\"password field group\">\n<label class=\"mb-2.5 block text-[14px] font-semibold text-[#eee8dc]\" data-kid=\"1-3-1-5-2-1\" data-name=\"password field label\" for=\"studio-password-phone\">Password</label>\n<div class=\"form-well relative flex h-[54px] items-center rounded-[17px]\" data-kid=\"1-3-1-5-2-2\" data-name=\"password input well\">\n<span aria-hidden=\"true\" class=\"pointer-events-none absolute left-4 flex items-center text-[#bbb4a5]\" data-kid=\"1-3-1-5-2-2-1\" data-name=\"password icon holder\"><i class=\"icon-lock-keyhole inline-block text-[18px]\" data-kid=\"1-3-1-5-2-2-1-1\" data-name=\"lock keyhole icon\" style=\"width:18px;height:18px;color:#bbb4a5\"></i></span>\n<input aria-label=\"Password\" autocomplete=\"current-password\" class=\"h-full w-full min-w-0 rounded-[17px] border-0 bg-transparent pr-12 pl-11 text-[16px] text-[#f5f3ea] outline-hidden\" data-kid=\"1-3-1-5-2-2-2\" data-name=\"password input field\" id=\"studio-password-phone\" name=\"password\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"press absolute right-0 flex size-[50px] items-center justify-center rounded-[15px] text-[#c7bfae]\" data-kid=\"1-3-1-5-2-2-3\" data-name=\"show password toggle button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-eye inline-block text-[19px]\" data-kid=\"1-3-1-5-2-2-3-1\" data-name=\"eye visibility icon\" style=\"width:19px;height:19px;color:#c7bfae\"></i></button>\n</div>\n</div>\n<button class=\"press mt-7 flex h-[54px] w-full items-center justify-center gap-3 rounded-full bg-[#e4cf91] text-[14px] font-bold text-[#211d12] shadow-[inset_0_1px_1px_#ffffff80]\" data-kid=\"1-3-1-5-3\" data-name=\"primary sign-in call-to-action button\" type=\"button\">Sign in to Studio<i aria-hidden=\"true\" class=\"icon-arrow-right inline-block text-[18px]\" data-kid=\"1-3-1-5-3-1\" data-name=\"right arrow CTA icon\" style=\"width:18px;height:18px;color:#211d12\"></i></button>\n<button class=\"press mt-3 flex h-[50px] w-full items-center justify-center gap-2 text-[13px] font-semibold text-[#d8cfbc]\" data-kid=\"1-3-1-5-4\" data-name=\"return to home secondary button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-arrow-left inline-block text-[17px]\" data-kid=\"1-3-1-5-4-1\" data-name=\"left arrow back icon\" style=\"width:17px;height:17px;color:#d8cfbc\"></i>Return to YT Media</button>\n</form>\n</section>\n</main>\n<footer class=\"px-3 pt-2 text-center text-[12px] font-medium leading-[1.9] text-[#c8c0af]\" data-kid=\"1-4\" data-name=\"footer bar\">\n<p data-kid=\"1-4-1\" data-name=\"footer attribution text\">YT Media <span class=\"text-[#dbc17a]\" data-kid=\"1-4-1-1\" data-name=\"footer separator dot\">•</span> Powered by Vorex Agency |<br data-kid=\"1-4-1-2\" data-name=\"footer line break\"/>Built by Dhiraj Kondalwar</p>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif (window.gsap) {gsap.to('.entry-orb',{x:18,y:22,scale:1.06,duration:14,stagger:2,ease:'sine.inOut',repeat:-1,yoyo:true});}\n</script>",
