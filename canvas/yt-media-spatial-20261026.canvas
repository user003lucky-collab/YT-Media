1-3-4-4-7-1-2-2\" data-name=\"record meta line\">Music <span class=\"mx-1 text-[#6d685f]\" data-kid=\"1-3-4-4-7-1-2-2-1\" data-name=\"meta separator slash\">/</span> Ambient</p></div><span class=\"text-[22px] text-[#d8c28a]\" data-kid=\"1-3-4-4-7-1-3\" data-name=\"music disc icon wrapper\"><i class=\"icon-disc-3\" data-kid=\"1-3-4-4-7-1-3-1\" data-name=\"vinyl disc icon\"></i></span></div>\n<div class=\"mt-4 grid grid-cols-2 gap-3\" data-kid=\"1-3-4-4-7-2\" data-name=\"record actions row\"><button class=\"flex h-12 items-center justify-center gap-2 rounded-[14px] bg-white/6 text-[13px] text-[#eee7d7]\" data-kid=\"1-3-4-4-7-2-1\" data-name=\"edit button\" type=\"button\"><span class=\"text-[16px]\" data-kid=\"1-3-4-4-7-2-1-1\" data-name=\"edit icon wrapper\"><i class=\"icon-pencil\" data-kid=\"1-3-4-4-7-2-1-1-1\" data-name=\"pencil icon\"></i></span>Edit</button><button class=\"flex h-12 items-center justify-center gap-2 rounded-[14px] text-[13px] text-[#ff879d]\" data-kid=\"1-3-4-4-7-2-2\" data-name=\"delete button\" type=\"button\"><span class=\"text-[16px]\" data-kid=\"1-3-4-4-7-2-2-1\" data-name=\"delete icon wrapper\"><i class=\"icon-trash-2\" data-kid=\"1-3-4-4-7-2-2-1-1\" data-name=\"trash icon\"></i></span>Delete</button></div>\n</article>\n<article class=\"record rounded-[23px] p-4\" data-kid=\"1-3-4-4-8\" data-name=\"media record card\">\n<div class=\"flex items-center gap-3.5\" data-kid=\"1-3-4-4-8-1\" data-name=\"record header row\"><img alt=\"Dark Atlantic water album cover — Lorenzo Alessio Messina on Pexels\" class=\"size-[64px] shrink-0 rounded-[12px] object-cover object-right\" data-kid=\"1-3-4-4-8-1-1\" data-name=\"record album art thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=180&amp;h=180&amp;fit=crop&amp;q=80\"/><div class=\"min-w-0 flex-1\" data-kid=\"1-3-4-4-8-1-2\" data-name=\"record title block\"><h3 class=\"text-[15px] font-semibold leading-[1.5]\" data-kid=\"1-3-4-4-8-1-2-1\" data-name=\"record title\">Low tide</h3><p class=\"mt-2 text-[12px] text-[#bfb7a5]\" data-kid=\"1-3-4-4-8-1-2-2\" data-name=\"record meta line\">Music <span class=\"mx-1 text-[#6d685f]\" data-kid=\"1-3-4-4-8-1-2-2-1\" data-name=\"meta separator slash\">/</span> Piano</p></div><span class=\"text-[22px] text-[#d8c28a]\" data-kid=\"1-3-4-4-8-1-3\" data-name=\"music disc icon wrapper\"><i class=\"icon-disc-3\" data-kid=\"1-3-4-4-8-1-3-1\" data-name=\"vinyl disc icon\"></i></span></div>\n<div class=\"mt-4 grid grid-cols-2 gap-3\" data-kid=\"1-3-4-4-8-2\" data-name=\"record actions row\"><button class=\"flex h-12 items-center justify-center gap-2 rounded-[14px] bg-white/6 text-[13px] text-[#eee7d7]\" data-kid=\"1-3-4-4-8-2-1\" data-name=\"edit button\" type=\"button\"><span class=\"text-[16px]\" data-kid=\"1-3-4-4-8-2-1-1\" data-name=\"edit icon wrapper\"><i class=\"icon-pencil\" data-kid=\"1-3-4-4-8-2-1-1-1\" data-name=\"pencil icon\"></i></span>Edit</button><button class=\"flex h-12 items-center justify-center gap-2 rounded-[14px] text-[13px] text-[#ff879d]\" data-kid=\"1-3-4-4-8-2-2\" data-name=\"delete button\" type=\"button\"><span class=\"text-[16px]\" data-kid=\"1-3-4-4-8-2-2-1\" data-name=\"delete icon wrapper\"><i class=\"icon-trash-2\" data-kid=\"1-3-4-4-8-2-2-1-1\" data-name=\"trash icon\"></i></span>Delete</button></div>\n</article>\n</div>\n<p class=\"mt-5 px-2 text-center text-[12px] leading-6 text-[#aaa496]\" data-kid=\"1-3-4-5\" data-name=\"inventory summary text\">All 8 items shown</p>\n</section>\n</main>\n<footer class=\"mt-8 border-t border-white/12 px-2 pt-6 pb-3 text-center\" data-kid=\"1-4\" data-name=\"footer block\">\n<p class=\"text-[13px] font-semibold text-[#d9c38d]\" data-kid=\"1-4-1\" data-name=\"footer brand name\">YT Media <span class=\"mx-1\" data-kid=\"1-4-1-1\" data-name=\"brand separator dot\">•</span></p>\n<p class=\"mt-2 text-[12px] leading-[1.9] text-[#c9c1b0]\" data-kid=\"1-4-2\" data-name=\"footer attribution text\">Powered by Vorex Agency |<br data-dynamic=\"true\" data-kid=\"1-4-2-1\" data-name=\"line break\" data-reason=\"element replaced by script\"/>Built by Dhiraj Kondalwar</p>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n  if (typeof gsap !== 'undefined') {\n    gsap.to('.studio-aurora',{x:24,y:36,duration:18,repeat:-1,yoyo:true,ease:'sine.inOut',stagger:2});\n  }\n</script>",
