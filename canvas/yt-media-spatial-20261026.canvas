    "var_3e3b55e84ebb": {
      "type": "variant",
      "label": "01 Private Screening — Vault / Phone",
      "parentId": "var_6cfb358b5fd6",
      "themeId": null,
      "rect": {
        "x": 980,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.vault-phone { --gold:#d4af37; --ivory:#f5f3ea; font-family:'Raleway',sans-serif; color:var(--ivory); background:#040407; }\n.vault-phone .display { font-family:'Cormorant',serif; }\n.vault-phone .key { background:linear-gradient(135deg,rgba(255,255,255,.075),rgba(255,255,255,.025)); border:1px solid rgba(230,217,174,.2); backdrop-filter:blur(30px) saturate(200%); box-shadow:inset 0 1px 1px rgba(255,255,255,.25),inset 0 -5px 12px rgba(4,4,7,.22); }\n.vault-phone .emblem { background:radial-gradient(ellipse at 30% 10%,rgba(245,231,185,.13),rgba(255,255,255,.025) 65%); backdrop-filter:blur(30px) saturate(200%); border:1px solid rgba(230,211,156,.4); box-shadow:inset 0 1px 1px rgba(255,255,255,.25),0 16px 45px rgba(212,175,55,.06); }\n.vault-phone button { cursor:default; }\n.vault-phone button:focus-visible { outline:2px solid #e4cf91; outline-offset:5px; }\n</style>\n<main aria-label=\"YT Media locked vault\" class=\"vault-phone relative isolate flex min-h-[max(844px,100dvh)] w-full flex-col items-center overflow-x-clip px-7 pt-[70px] pb-[max(26px,env(safe-area-inset-bottom))]\" data-kid=\"1\" data-name=\"locked vault phone screen\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background layer\">\n<div class=\"orb-gold absolute -top-28 -left-44 h-[530px] w-[470px] rounded-full bg-[#d4af37]/12 blur-[105px]\" data-kid=\"1-1-1\" data-name=\"gold floating decorative orb\"></div>\n<div class=\"orb-crimson absolute -right-48 top-[240px] h-[440px] w-[390px] rounded-full bg-[#ff0033]/11 blur-[105px]\" data-kid=\"1-1-2\" data-name=\"crimson floating decorative orb\"></div>\n<div class=\"orb-indigo absolute -left-36 bottom-0 h-[350px] w-[360px] rounded-full bg-[#4f46e5]/13 blur-[95px]\" data-kid=\"1-1-3\" data-name=\"indigo floating decorative orb\"></div>\n<div class=\"orb-cyan absolute -right-28 -bottom-24 h-[300px] w-[300px] rounded-full bg-[#06b6d4]/9 blur-[90px]\" data-kid=\"1-1-4\" data-name=\"cyan floating decorative orb\"></div>\n</div>\n<header class=\"flex flex-col items-center\" data-kid=\"1-2\" data-name=\"brand header section\">\n<div class=\"emblem relative flex size-[120px] flex-col items-center justify-center rounded-full\" data-kid=\"1-2-1\" data-name=\"circle emblem badge\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-[7px] rounded-full border border-[#f5e8b2]/8\" data-kid=\"1-2-1-1\" data-name=\"emblem inner ring border\"></div>\n<span aria-hidden=\"true\" class=\"flex size-9 items-center justify-center text-[27px] text-[#e4cf91]\" data-kid=\"1-2-1-2\" data-name=\"play icon wrapper\"><i class=\"icon-play ml-1 inline-block size-7\" data-kid=\"1-2-1-2-1\" data-name=\"play triangle icon\"></i></span>\n<span class=\"display mt-1 text-[28px] font-medium leading-8 tracking-[-.4px]\" data-kid=\"1-2-1-3\" data-name=\"brand name text\">YT Media</span>\n</div>\n</header>\n<section aria-labelledby=\"vault-heading\" class=\"mt-[33px] flex w-full flex-col items-center\" data-kid=\"1-3\" data-name=\"PIN entry section\">\n<h1 class=\"display text-[35px] font-medium leading-[1.15] tracking-[-.3px]\" data-kid=\"1-3-1\" data-name=\"vault heading text\" id=\"vault-heading\">Enter vault PIN</h1>\n<p class=\"mt-3 text-[14px] leading-6 text-[#c8c2b5]\" data-kid=\"1-3-2\" data-name=\"privacy subtitle text\">Your collection stays private.</p>\n<div aria-label=\"No digits entered, four digits required\" class=\"mt-7 flex h-5 items-center justify-center gap-[18px]\" data-kid=\"1-3-3\" data-name=\"PIN entry dots indicator\" role=\"img\">\n<span class=\"size-[14px] rounded-full border border-[#d9c286]/45 bg-[#08080c] shadow-[inset_0_1px_2px_#00000080,0_0_10px_#d4af3712]\" data-kid=\"1-3-3-1\" data-name=\"empty PIN dot\"></span>\n<span class=\"size-[14px] rounded-full border border-[#d9c286]/45 bg-[#08080c] shadow-[inset_0_1px_2px_#00000080,0_0_10px_#d4af3712]\" data-kid=\"1-3-3-2\" data-name=\"empty PIN dot\"></span>\n<span class=\"size-[14px] rounded-full border border-[#d9c286]/45 bg-[#08080c] shadow-[inset_0_1px_2px_#00000080,0_0_10px_#d4af3712]\" data-kid=\"1-3-3-3\" data-name=\"empty PIN dot\"></span>\n<span class=\"size-[14px] rounded-full border border-[#d9c286]/45 bg-[#08080c] shadow-[inset_0_1px_2px_#00000080,0_0_10px_#d4af3712]\" data-kid=\"1-3-3-4\" data-name=\"empty PIN dot\"></span>\n</div>\n<div aria-label=\"Numeric keypad\" class=\"mt-[34px] grid grid-cols-[68px_68px_68px] gap-x-[32px] gap-y-[13px]\" data-kid=\"1-3-4\" data-name=\"numeric keypad grid\" role=\"group\">\n<button aria-label=\"1\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-1\" data-name=\"keypad number 1 button\" type=\"button\">1</button>\n<button aria-label=\"2\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-2\" data-name=\"keypad number 2 button\" type=\"button\">2</button>\n<button aria-label=\"3\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-3\" data-name=\"keypad number 3 button\" type=\"button\">3</button>\n<button aria-label=\"4\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-4\" data-name=\"keypad number 4 button\" type=\"button\">4</button>\n<button aria-label=\"5\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-5\" data-name=\"keypad number 5 button\" type=\"button\">5</button>\n<button aria-label=\"6\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-6\" data-name=\"keypad number 6 button\" type=\"button\">6</button>\n<button aria-label=\"7\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-7\" data-name=\"keypad number 7 button\" type=\"button\">7</button>\n<button aria-label=\"8\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-8\" data-name=\"keypad number 8 button\" type=\"button\">8</button>\n<button aria-label=\"9\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-9\" data-name=\"keypad number 9 button\" type=\"button\">9</button>\n<div aria-hidden=\"true\" class=\"size-[68px]\" data-kid=\"1-3-4-10\" data-name=\"keypad empty spacer\"></div>\n<button aria-label=\"0\" class=\"key flex size-[68px] items-center justify-center rounded-full text-[27px] font-medium text-[#f5f3ea] active:scale-95\" data-kid=\"1-3-4-11\" data-name=\"keypad number 0 button\" type=\"button\">0</button>\n<button aria-label=\"Delete last digit\" class=\"flex size-[68px] items-center justify-center rounded-full text-[25px] text-[#d8ceb5] active:scale-95\" data-kid=\"1-3-4-12\" data-name=\"keypad delete button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-delete inline-block size-[26px]\" data-kid=\"1-3-4-12-1\" data-name=\"delete backspace icon\"></i></button>\n</div>\n</section>\n<footer class=\"mt-auto w-full pt-[57px] text-center\" data-kid=\"1-4\" data-name=\"footer section\">\n<p class=\"mx-auto max-w-[325px] text-[12px] font-medium leading-[1.9] text-[#c9bd9d]\" data-kid=\"1-4-1\" data-name=\"footer credit text\">YT Media • Powered by Vorex Agency |<br data-kid=\"1-4-1-1\" data-name=\"line break separator\"/>Built by Dhiraj Kondalwar</p>\n</footer>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif (typeof gsap !== 'undefined') {\n  gsap.to('.orb-gold', { x:24, y:28, duration:16, repeat:-1, yoyo:true, ease:'sine.inOut' });\n  gsap.to('.orb-crimson', { x:-22, y:-32, duration:19, repeat:-1, yoyo:true, ease:'sine.inOut' });\n  gsap.to('.orb-indigo', { x:20, y:-24, duration:21, repeat:-1, yoyo:true, ease:'sine.inOut' });\n  gsap.to('.orb-cyan', { x:-18, y:-15, duration:17, repeat:-1, yoyo:true, ease:'sine.inOut' });\n}\n</script>",
