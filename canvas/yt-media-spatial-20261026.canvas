-[#ded2b4]\" data-kid=\"1-3-2-2-3-3-10-4-1\" type=\"button\"><span class=\"text-[14px]\" data-kid=\"1-3-2-2-3-3-10-4-1-1\"><i class=\"icon-pencil\" data-kid=\"1-3-2-2-3-3-10-4-1-1-1\"></i></span>Edit</button></td><td data-kid=\"1-3-2-2-3-3-10-5\"><button aria-label=\"Delete Rooms of light\" class=\"flex h-11 items-center gap-1.5 text-[#f09ba8]\" data-kid=\"1-3-2-2-3-3-10-5-1\" type=\"button\"><span class=\"text-[14px]\" data-kid=\"1-3-2-2-3-3-10-5-1-1\"><i class=\"icon-trash-2\" data-kid=\"1-3-2-2-3-3-10-5-1-1-1\"></i></span>Delete</button></td></tr>\n</tbody></table>\n<div class=\"mt-1 flex items-center justify-between border-t border-white/10 pt-4 pb-1 text-[12px] text-[#b9b09e]\" data-kid=\"1-3-2-2-4\"><span data-kid=\"1-3-2-2-4-1\">Showing all 10 items</span><span data-kid=\"1-3-2-2-4-2\">Sample collection</span></div>\n</section>\n</div>\n</main>\n<footer class=\"mt-7 flex items-center justify-between border-t border-white/10 px-1 pt-5 text-[13px] text-[#bfb6a5]\" data-kid=\"1-4\"><p data-kid=\"1-4-1\">YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar</p><p class=\"flex items-center gap-2\" data-kid=\"1-4-2\"><span class=\"text-[15px] text-[#ccba85]\" data-kid=\"1-4-2-1\"><i class=\"icon-lock-keyhole\" data-kid=\"1-4-2-1-1\"></i></span>Studio access is separate from the viewer vault.</p></footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif (window.gsap) { gsap.to('.studio-media .orb',{x:26,y:22,duration:14,ease:'sine.inOut',repeat:-1,yoyo:true,stagger:3}); }\n</script>",
