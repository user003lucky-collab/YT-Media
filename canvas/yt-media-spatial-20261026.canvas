      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.screening { --obsidian:oklch(from #040407 l c h); --ivory:oklch(96.2% 0.012 95); --gold:oklch(from #d4af37 l c h); --crimson:oklch(from #ff0033 l c h); --indigo:oklch(from #4f46e5 l c h); --cyan:oklch(from #06b6d4 l c h); font-family:'Raleway',sans-serif; background:var(--obsidian); color:var(--ivory); }\n.screening .display { font-family:'Cormorant',serif; }\n.screening .glass { background:linear-gradient(120deg,rgba(255,255,255,.065),rgba(255,255,255,.025)); backdrop-filter:blur(30px) saturate(200%); border:1px solid rgba(245,243,234,.14); box-shadow:inset 0 1px 1px rgba(255,255,255,.2); }\n.screening .aperture { border-radius:34px 34px 48px 48px / 34px 34px 25px 25px; border:1px solid rgba(245,230,185,.32); box-shadow:inset 0 1px 1px #ffffff40; }\n.screening .active-nav { background:linear-gradient(110deg,#d4af3724,#d4af3708); border:1px solid #d4af3730; box-shadow:inset 0 1px 1px #fff1; color:#e5cc83; }\n.screening .vinyl { background:repeating-radial-gradient(circle at center,#151517 0px,#151517 1px,#29292b 1.5px,#0c0c0e 2.5px,#161618 3px); box-shadow:inset 0 0 0 1px #ffffff24,3px 6px 18px #04040780; }\n.screening button { cursor:default; }\n.screening button:focus-visible, .screening input:focus-visible { outline:2px solid var(--gold); outline-offset:4px; }\n.screening input[type=range] { accent-color:#dcc577; height:3px; }\n.screening .photo-surface { background:rgba(255,255,255,.04); border:1px solid #ffffff1a; box-shadow:inset 0 1px 1px #ffffff40; backdrop-filter:blur(30px) saturate(200%); }\n</style>\n<div class=\"screening relative isolate min-w-[1100px] overflow-x-clip px-7 pt-6 pb-7 text-[14px] font-medium\" data-kid=\"1\" data-name=\"app root layout container\" data-node-id=\"var_b231da24bee8\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background glow layer\">\n<div class=\"absolute -left-48 top-0 h-[700px] w-[650px] rounded-full bg-[#d4af37]/9 blur-[130px]\" data-kid=\"1-1-1\" data-name=\"decorative gold ambient glow orb\"></div>\n<div class=\"absolute right-0 top-24 h-[540px] w-[650px] rounded-full bg-[#ff0033]/10 blur-[125px]\" data-kid=\"1-1-2\" data-name=\"decorative crimson ambient glow orb\"></div>\n<div class=\"absolute -right-64 top-[650px] h-[700px] w-[560px] rounded-full bg-[#06b6d4]/7 blur-[130px]\" data-kid=\"1-1-3\" data-name=\"decorative cyan ambient glow orb\"></div>\n<div class=\"absolute bottom-0 left-[240px] h-[500px] w-[900px] rounded-full bg-[#4f46e5]/10 blur-[145px]\" data-kid=\"1-1-4\" data-name=\"decorative indigo ambient glow orb\"></div>\n</div>\n<header class=\"glass relative z-10 flex h-[88px] items-center gap-7 rounded-[28px] px-5\" data-kid=\"1-2\" data-name=\"top app header bar\">\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"flex w-[360px] shrink-0 items-center gap-3.5\" data-kid=\"1-2-1\" data-name=\"brand identity block\">\n<div aria-hidden=\"true\" class=\"glass flex size-[49px] shrink-0 items-center justify-center rounded-full text-[21px] text-[#e6ce8c]\" data-kid=\"1-2-1-1\" data-name=\"brand play icon avatar\"><i class=\"icon-play ml-0.5\" data-kid=\"1-2-1-1-1\" data-name=\"brand play icon\"></i></div>\n<div class=\"leading-[1.4]\" data-kid=\"1-2-1-2\" data-name=\"brand title and attribution text\"><span class=\"block text-[20px] font-semibold tracking-[-.5px]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name label\">YT Media <span class=\"text-[14px] text-[#d6bf7c]\" data-kid=\"1-2-1-2-1-1\" data-name=\"brand name separator dot\">•</span> </span><span class=\"mt-0.5 block text-[13px] font-medium text-[#e2dfd6]\" data-kid=\"1-2-1-2-2\" data-name=\"brand agency attribution line\">Powered by Vorex Agency |<br data-kid=\"1-2-1-2-2-1\" data-name=\"attribution line break\"/> Built by Dhiraj Kondalwar</span></div>\n</div>\n<div class=\"relative min-w-0 flex-1\" data-kid=\"1-2-2\" data-name=\"search field wrapper\">\n<label class=\"sr-only\" data-kid=\"1-2-2-1\" data-name=\"search field accessible label\" for=\"media-search\">Search your collection</label>\n<span class=\"pointer-events-none absolute left-4 top-3.5 text-[19px] text-[#c8c6c1]\" data-kid=\"1-2-2-2\" data-name=\"search field icon wrapper\"><i class=\"icon-search\" data-kid=\"1-2-2-2-1\" data-name=\"search magnifier icon\"></i></span>\n<input class=\"h-12 w-full rounded-[18px] border border-white/10 bg-[#050508]/35 pr-4 pl-12 text-[14px] text-[#f5f3ea] placeholder:text-[#bcbab6] outline-hidden\" data-kid=\"1-2-2-3\" data-name=\"media search input field\" id=\"media-search\" placeholder=\"Search your collection\" type=\"search\"/>\n</div>\n<div class=\"flex shrink-0 items-center gap-5\" data-kid=\"1-2-3\" data-name=\"header right action group\">\n<button class=\"flex items-center gap-2 text-[14px] text-[#e3e0d8]\" data-kid=\"1-2-3-1\" data-name=\"admin studio action button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-2-3-1-1\" data-name=\"slider icon holder\"><i class=\"icon-sliders-horizontal\" data-kid=\"1-2-3-1-1-1\" data-name=\"slider settings icon\"></i></span>Admin Studio</button>\n<span class=\"h-6 w-px bg-white/12\" data-kid=\"1-2-3-2\" data-name=\"header vertical divider\"></span>\n<button class=\"flex h-12 items-center gap-2.5 rounded-[17px] border border-[#dfc67d]/25 bg-[#d4af37]/5 px-4 text-[14px] text-[#e8d8a7]\" data-kid=\"1-2-3-3\" data-name=\"lock vault action button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-2-3-3-1\" data-name=\"lock icon holder\"><i class=\"icon-lock-keyhole\" data-kid=\"1-2-3-3-1-1\" data-name=\"lock keyhole icon\"></i></span>Lock Vault</button>\n</div>\n</header>\n<div class=\"relative mt-6 grid grid-cols-[196px_minmax(0,1fr)] items-start gap