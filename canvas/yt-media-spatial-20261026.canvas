      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.studio-phone { font-family:'Raleway',sans-serif; color:#f5f3ea; background:#040407; --gold:#e4cf91; }\n.studio-phone .display { font-family:'Cormorant',serif; }\n.studio-phone .glass { background:linear-gradient(130deg,rgba(255,255,255,.065),rgba(255,255,255,.025)); backdrop-filter:blur(30px) saturate(200%); -webkit-backdrop-filter:blur(30px) saturate(200%); border:1px solid rgba(241,230,201,.16); box-shadow:inset 0 1px 1px rgba(255,255,255,.25); }\n.studio-phone .field { width:100%; min-width:0; height:54px; border-radius:17px; background:rgba(4,4,7,.42); border:1px solid rgba(245,243,234,.17); color:#f5f3ea; font-size:14px; font-weight:500; padding:0 15px; box-shadow:inset 0 1px 7px rgba(4,4,7,.18); }\n.studio-phone .field::placeholder { color:#a9a69e; }\n.studio-phone .record { background:linear-gradient(120deg,rgba(255,255,255,.055),rgba(255,255,255,.025)); backdrop-filter:blur(30px) saturate(200%); border:1px solid rgba(230,222,204,.13); box-shadow:inset 0 1px 1px rgba(255,255,255,.19); }\n.studio-phone i { display:inline-block; width:1em; height:1em; color:inherit; }\n.studio-phone button:focus-visible,.studio-phone a:focus-visible,.studio-phone input:focus-visible,.studio-phone select:focus-visible { outline:2px solid #e4cf91; outline-offset:4px; }\n.studio-phone button { cursor:default; }\n</style>\n<div class=\"studio-phone relative isolate w-full overflow-x-clip px-4 pt-4 pb-8 text-[14px] font-medium\" data-kid=\"1\" data-name=\"studio phone app root container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative aurora background layer\">\n<div class=\"studio-aurora absolute -top-24 -left-40 h-[550px] w-[450px] rounded-full bg-[#d4af37]/13 blur-[110px]\" data-kid=\"1-1-1\" data-name=\"decorative gold aurora glow orb\"></div>\n<div class=\"studio-aurora absolute top-[520px] -right-56 h-[540px] w-[400px] rounded-full bg-[#ff0033]/9 blur-[110px]\" data-kid=\"1-1-2\" data-name=\"decorative red aurora glow orb\"></div>\n<div class=\"studio-aurora absolute top-[1500px] -left-48 h-[700px] w-[400px] rounded-full bg-[#4f46e5]/12 blur-[120px]\" data-kid=\"1-1-3\" data-name=\"decorative indigo aurora glow orb\"></div>\n<div class=\"studio-aurora absolute right-[-250px] bottom-[300px] h-[700px] w-[500px] rounded-full bg-[#06b6d4]/9 blur-[120px]\" data-kid=\"1-1-4\" data-name=\"decorative cyan aurora glow orb\"></div>\n</div>\n<header class=\"glass relative overflow-hidden rounded-[26px] px-4 pt-4 pb-2\" data-kid=\"1-2\" data-name=\"header glass panel\">\n<span aria-hidden=\"true\" class=\"absolute inset-x-6 top-0 h-px bg-[linear-gradient(90deg,transparent,#dfca8c90,#06b6d440,transparent)]\" data-kid=\"1-2-1\" data-name=\"header top accent gradient rule\"></span>\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"flex items-center gap-3\" data-kid=\"1-2-2\" data-name=\"brand identity row\">\n<span aria-hidden=\"true\" class=\"glass flex size-11 shrink-0 items-center justify-center rounded-full text-[19px] text-[#e4cf91]\" data-kid=\"1-2-2-1\" data-name=\"brand logo badge\"><i class=\"icon-play ml-0.5\" data-kid=\"1-2-2-1-1\" data-name=\"play triangle icon\"></i></span>\n<div class=\"min-w-0 leading-[1.5]\" data-kid=\"1-2-2-2\" data-name=\"brand text block\">\n<p class=\"text-[19px] font-semibold tracking-[-.5px]\" data-kid=\"1-2-2-2-1\" data-name=\"brand name heading\">YT Media <span class=\"text-[#e4cf91]\" data-kid=\"1-2-2-2-1-1\" data-name=\"brand name separator dot\">•</span></p>\n<p class=\"mt-0.5 text-[12px] text-[#dbd5c6]\" data-kid=\"1-2-2-2-2\" data-name=\"brand attribution text\">Powered by Vorex Agency |<br data-dynamic=\"true\" data-kid=\"1-2-2-2-2-1\" data-name=\"line break\" data-reason=\"element replaced by script\"/>Built by Dhiraj Kondalwar</p>\n</div>\n</div>\n<div class=\"mt-3 flex items-center justify-between border-t border-white/10 pt-1 text-[13px]\" data-kid=\"1-2-3\" data-name=\"header actions row\">\n<button class=\"flex h-12 items-center gap-2 text-[#e8d6a5]\" data-kid=\"1-2-3-1\" data-name=\"view portal button\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-2-3-1-1\" data-name=\"view portal icon wrapper\"><i class=\"icon-arrow-up-right\" data-kid=\"1-2-3-1-1-1\" data-name=\"arrow up-right icon\"></i></span>View portal</button>\n<button class=\"flex h-12 items-center gap-2 text-[#d4cec0]\" data-kid=\"1-2-3-2\" data-name=\"sign out button\" type=\"button\">Sign out<span class=\"text-[17px]\" data-kid=\"1-2-3-2-1\" data-name=\"sign out icon wrapper\"><i class=\"icon-log-out\" data-kid=\"1-2-3-2-1-1\" data-name=\"log out icon\"></i></span></button>\n</div>\n</header>\n<main data-kid=\"1-3\" data-name=\"main studio content\">\n<div class=\"mt-7 px-1\" data-kid=\"1-3-1\" data-name=\"studio title block\">\n<h1 class=\"display text-[40px] font-medium leading-[1.05] tracking-[-.6px]\" data-kid=\"1-3-1-1\" data-name=\"studio hero headline\">YT Media Studio</h1>\n<p class=\"mt-2 text-[14px] leading-6 text-[#c6c0b3]\" data-kid=\"1-3-1-2\" data-name=\"studio tagline text\">Curate what plays next.</p>\n</div>\n<div aria-label=\"Studio workspace\" class=\"glass mt-5 grid grid-cols-2 gap-1 rounded-[19px] p-1.5\" data-kid=\"1-3-2\" data-name=\"workspace tab list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"flex h-[49px] items-center justify-center gap-2 rounded-[14px] border border-[#ddc684]/30 bg-[#d4af37]/12 text-[14px] font-semibold text-[#ebd6a0]\" data-kid=\"1-3-2-1\" data-name=\"media tab (active)\" role=\"tab\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-2-1-1\" data-name=\"media tab icon wrapper\"><i class=\"icon-clapperboard\" data-kid=\"1-3-2-1-1-1\" data-name=\"clapperboard icon\"></i></span>Media</button>\n<button aria-selected=\"false\" class=\"flex h-[49px] items-center justify-center gap-2 rounded-[14px] text-[14px] text-[#ccc6b8]\" data-kid=\"1-3-2-2\" data-name=\"site and hero tab\" role=\"tab\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-3-2-2-1\" data-name=\"site and hero tab icon wrapper\"><i class=\"icon-panels-top-left\" data-kid=\"1-3-2-2-1-1\" data-name=\"panels icon\"></i></span>Site &amp; hero</button>\n</div>\n<section aria-labelledby=\"add-media-title\" class=\"mt-7\" data-kid=\"1-3-3\" data-name=\"add new media section\">\n<div class=\"flex items-center justify-between gap-3 px-1\" data-kid=\"1-3-3-1\" data-name=\"section header row\">\n<h2 class=\"display text-[31px] font-medium\" data-kid=\"1-3-3-1-1\" data-name=\"add media heading\" id=\"add-media-title\">Add new media</h2>\n<a class=\"flex min-h-12 items-center gap-1.5 text-[12px] font-semibold text-[#e3cf97]\" data-kid=\"1-3-3-1-2\" data-name=\"jump to inventory link\" href=\"#studio-phone-inventory\">Jump to inventory<span class=\"text-[16px]\" data-kid=\"1-3-3-1-2-1\" data-name=\"down arrow icon wrapper\"><i class=\"icon-arrow-down\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"arrow down icon\"></i></span></a>\n</div>\n<form class=\"glass mt-3 rounded-[28px] p-4\" data-kid=\"1-3-3-2\" data-name=\"add media form card\" onsubmit=\"return false\">\n<div data-kid=\"1-3-3-2-1\" data-name=\"title field group\">\n<label class=\"block text-[14px] font-semibold\" data-kid=\"1-3-3-2-1-1\" data-name=\"title field label\" for=\"phone-media-title\">Title / Caption</label>\n<input autocomplete=\"off\" class=\"field mt-2.5\" data-kid=\"1-3-3-2-1-2\" data-name=\"title text input\" id=\"phone-media-title\" type=\"text\" value=\"Where the land ends\"/>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-3-2-2\" data-name=\"category field group\">\n<label class=\"block text-[14px] font-semibold\" data-kid=\"1-3-3-2-2-1\" data-name=\"category field label\" for=\"phone-media-category\">Section Category</label>\n<div class=\"relative mt-2.5\" data-kid=\"1-3-3-2-2-2\" data-name=\"category select wrapper\">\n<select class=\"field appearance-none pr-12\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"category select dropdown\" id=\"phone-media-category\"><option data-kid=\"1-3-3-2-2-2-1-1\" data-name=\"videos category option\" selected=\"\">Videos</option><option data-kid=\"1-3-3-2-2-2-1-2\" data-name=\"shorts category option\">Shorts</option><option data-kid=\"1-3-3-2-2-2-1-3\" data-name=\"post category option\">Post</option><option data-kid=\"1-3-3-2-2-2-1-4\" data-name=\"music category option\">Music</option></select>\n<span class=\"pointer-events-none absolute top-[18px] right-4 text-[18px] text-[#d6c9ad]\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"select chevron overlay\"><i class=\"icon-chevron-down\" data-kid=\"1-3-3-2-2-2-2-1\" data-name=\"chevron down icon\"></i></span>\n</div>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-3-2-3\" data-name=\"media source field group\">\n<label class=\"block text-[14px] font-semibold\" data-kid=\"1-3-3-2-3-1\" data-name=\"media source field label\" for=\"phone-media-source\">Media Source Link</label>\n<input aria-describedby=\"phone-source-help\" autocomplete=\"off\" class=\"field mt-2.5\" data-kid=\"1-3-3-2-3-2\" data-name=\"media source URL input\" id=\"phone-media-source\" spellcheck=\"false\" type=\"url\" value=\"https://youtu.be/aqz-KE-bpKQ\"/>\n<p class=\"mt-2.5 flex items-center gap-2 text-[12px] text-[#dfcb94]\" data-kid=\"1-3-3-2-3-3\" data-name=\"source detected help text\" id=\"phone-source-help\"><span class=\"text-[15px]\" data-kid=\"1-3-3-2-3-3-1\" data-name=\"help icon wrapper\"><i class=\"icon-circle-check\" data-kid=\"1-3-3-2-3-3-1-1\" data-name=\"circle check icon\"></i></span>YouTube video detected</p>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-3-2-4\" data-name=\"thumbnail cover field group\">\n<label class=\"block text-[14px] font-semibold leading-6\" data-kid=\"1-3-3-2-4-1\" data-name=\"custom cover field label\" for=\"phone-media-cover\">Custom Thumbnail / Cover Image Link</label>\n<input aria-describedby=\"phone-cover-help\" autocomplete=\"off\" class=\"field mt-2\" data-kid=\"1-3-3-2-4-2\" data-name=\"custom cover URL input\" id=\"phone-media-cover\" spellcheck=\"false\" type=\"url\" value=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg\"/>\n<p class=\"mt-2.5 text-[12px] leading-[1.65] text-[#bbb5a9]\" data-kid=\"1-3-3-2-4-3\" data-name=\"cover helper text\" id=\"phone-cover-help\">Leave blank to use an available source thumbnail.</p>\n</div>\n<label class=\"mt-4 flex min-h-[56px] items-center gap-3 text-[14px]\" data-kid=\"1-3-3-2-5\" data-name=\"pin to featured checkbox row\">\n<input checked=\"\" class=\"size-5 shrink-0 accent-[#dec888]\" data-kid=\"1-3-3-2-5-1\" data-name=\"pin to featured checkbox\" type=\"checkbox\"/>\n<span data-kid=\"1-3-3-2-5-2\" data-name=\"pin to featured label text\">Pin to Home Featured</span>\n<span aria-hidden=\"true\" class=\"ml-auto text-[17px] text-[#d9c18a]\" data-kid=\"1-3-3-2-5-3\" data-name=\"pin icon spacer\"><i class=\"icon-pin\" data-kid=\"1-3-3-2-5-3-1\" data-name=\"pin icon\"></i></span>\n</label>\n<div class=\"mt-3 border-t border-white/10 pt-4\" data-kid=\"1-3-3-2-6\" data-name=\"preview card section\">\n<div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-3-3-2-6-1\" data-name=\"preview header row\"><span class=\"text-[13px] font-semibold text-[#ded8c9]\" data-kid=\"1-3-3-2-6-1-1\" data-name=\"preview title label\">Live thumbnail preview</span><span class=\"text-[11px] text-[#bcb6a7]\" data-kid=\"1-3-3-2-6-1-2\" data-name=\"preview state label\">Custom cover</span></div>\n<div class=\"relative aspect-video overflow-hidden rounded-[18px] border border-[#e4cf91]/25 bg-[#17191c]\" data-kid=\"1-3-3-2-6-2\" data-name=\"thumbnail preview card\">\n<img alt=\"Silver surf following a volcanic coastline at dusk — Lorenzo Alessio Messina on Pexels\" class=\"size-full object