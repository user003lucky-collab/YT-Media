      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.vault-desktop{font-family:'Raleway',sans-serif;background:#040407;color:#f5f3ea;}\n.vault-desktop .display{font-family:'Cormorant',serif;}\n.vault-desktop .glass{background:rgba(255,255,255,.04);backdrop-filter:blur(30px) saturate(200%);box-shadow:inset 0 1px 1px rgba(255,255,255,.25);}\n.vault-desktop .lens-rim{background:linear-gradient(145deg,rgba(244,224,168,.65),rgba(255,255,255,.09) 32%,rgba(255,255,255,.035) 50%,rgba(6,182,212,.33) 79%,rgba(255,255,255,.06));padding:1px;}\n.vault-desktop .lens-core{background:radial-gradient(ellipse at 30% 14%,rgba(238,211,139,.15),transparent 55%),linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.015));backdrop-filter:blur(30px) saturate(200%);box-shadow:inset 0 1px 1px #ffffff40,inset 0 -22px 35px #04040780;}\n.vault-desktop .key{background:linear-gradient(145deg,rgba(255,255,255,.085),rgba(255,255,255,.025));backdrop-filter:blur(30px) saturate(200%);border:1px solid rgba(236,225,198,.16);box-shadow:inset 0 1px 1px rgba(255,255,255,.25),inset 0 -3px 7px rgba(4,4,7,.5);cursor:pointer;transition:transform .16s ease,background .16s ease,border-color .16s ease;}\n.vault-desktop .key:hover{background:rgba(212,175,55,.11);border-color:rgba(228,207,145,.5);transform:translateY(-2px);}\n.vault-desktop .key:active{transform:scale(.94);}\n.vault-desktop .key:focus-visible{outline:2px solid #e4cf91;outline-offset:5px;}\n.vault-desktop .indicator{background:radial-gradient(circle at 30% 25%,#ffffff17,#ffffff03);box-shadow:inset 0 1px 2px #ffffff40,inset 0 -2px 3px #040407;}\n</style>\n<div class=\"vault-desktop relative isolate flex h-[960px] min-h-[960px] w-full flex-col overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background layer\">\n<div class=\"vault-orb absolute -left-[100px] top-[100px] h-[520px] w-[650px] rounded-full bg-[#d4af37]/12 blur-[120px]\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"gold ambient glow orb\" data-reason=\"position/scale continuously reinit by gsap infinite loop\"></div>\n<div class=\"vault-orb absolute right-[-100px] top-[-150px] h-[680px] w-[620px] rounded-full bg-[#ff0033]/10 blur-[135px]\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"red ambient glow orb\" data-reason=\"position/scale continuously reinit by gsap infinite loop\"></div>\n<div class=\"vault-orb absolute bottom-[-240px] left-[260px] h-[530px] w-[690px] rounded-full bg-[#4f46e5]/15 blur-[140px]\" data-dynamic=\"true\" data-kid=\"1-1-3\" data-name=\"indigo ambient glow orb\" data-reason=\"position/scale continuously reinit by gsap infinite loop\"></div>\n<div class=\"vault-orb absolute right-[30px] bottom-[50px] h-[410px] w-[410px] rounded-full bg-[#06b6d4]/9 blur-[120px]\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"cyan ambient glow orb\" data-reason=\"position/scale continuously reinit by gsap infinite loop\"></div>\n<div class=\"absolute left-1/2 top-[28px] h-[780px] w-[780px] -translate-x-1/2 rounded-full border border-[#e8d7a5]/[.035] bg-[radial-gradient(ellipse_at_50%_30%,rgba(255,255,255,.02),transparent_68%)]\" data-kid=\"1-1-5\" data-name=\"concentric decorative ring\"></div>\n<div class=\"absolute left-1/2 top-[76px] h-[684px] w-[684px] -translate-x-1/2 rounded-full border border-[#e8d7a5]/[.045]\" data-kid=\"1-1-6\" data-name=\"concentric decorative ring\"></div>\n<div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(4,4,7,.52)_100%)]\" data-kid=\"1-1-7\" data-name=\"edge vignette overlay\"></div>\n</div>\n<header class=\"relative flex items-center justify-between px-12 pt-9\" data-kid=\"1-2\" data-name=\"top status header bar\">\n<div class=\"glass flex items-center gap-3 rounded-full border border-[#e3ca85]/15 py-2 pr-5 pl-2 text-[13px] font-medium text-[#ded7c4]\" data-kid=\"1-2-1\" data-name=\"brand pill with play icon\">\n<span class=\"flex size-9 items-center justify-center rounded-full border border-[#e3ca85]/20 bg-white/[.025] text-[15px] text-[#dfc983]\" data-kid=\"1-2-1-1\" data-name=\"brand icon circle frame\"><i aria-hidden=\"true\" class=\"icon-play inline-block size-[15px]\" data-kid=\"1-2-1-1-1\" data-name=\"play circle icon\"></i></span>\n<span data-kid=\"1-2-1-2\" data-name=\"brand attribution text\"><span class=\"text-[#e4cf91]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name text\">YT Media</span> • Powered by Vorex Agency | Built by Dhiraj Kondalwar</span>\n</div>\n<div class=\"flex items-center gap-2 text-[13px] text-[#bbb6a9]\" data-kid=\"1-2-2\" data-name=\"lock status indicator\"><span class=\"text-[15px] text-[#d5bf7b]\" data-kid=\"1-2-2-1\" data-name=\"lock icon wrapper\"><i aria-hidden=\"true\" class=\"icon-lock-keyhole inline-block size-[15px]\" data-kid=\"1-2-2-1-1\" data-name=\"lock keyhole icon\"></i></span><span data-kid=\"1-2-2-2\" data-name=\"vault locked label\">Vault locked</span></div>\n</header>\n<main aria-labelledby=\"vault-title\" class=\"relative mx-auto flex w-[440px] flex-1 flex-col items-center pt-[29px]\" data-kid=\"1-3\" data-name=\"main vault PIN panel\">\n<div class=\"relative flex size-[170px] shrink-0 items-center justify-center\" data-kid=\"1-3-1\" data-name=\"vault emblem with rings\">\n<div aria-hidden=\"true\" class=\"absolute inset-[-12px] rounded-full border border-[#e6d29a]/[.09]\" data-kid=\"1-3-1-1\" data-name=\"outer decorative ring\"></div>\n<div aria-hidden=\"true\" class=\"absolute inset-[-25px] rounded-full border border-[#e6d29a]/[.035]\" data-kid=\"1-3-1-2\" data-name=\"dashed inner decorative ring\"></div>\n<div class=\"lens-rim size-full rounded-full\" data-kid=\"1-3-1-3\" data-name=\"vault lens rim container\">\n<div class=\"lens-core relative flex size-full flex-col items-center justify-center overflow-hidden rounded-full\" data-kid=\"1-3-1-3-1\" data-name=\"vault glass lens face\">\n<div aria-hidden=\"true\" class=\"absolute left-[18px] top-[12px] h-[45px] w-[105px] -rotate-[25deg] rounded-full bg-[#fff1cc]/[.07] blur-[10px]\" data-kid=\"1-3-1-3-1-1\" data-name=\"lens glossy highlight\"></div>\n<span class=\"mb-2 flex size-[42px] items-center justify-center text-[30px] text-[#e8d6a0]\" data-kid=\"1-3-1-3-1-2\" data-name=\"emblem icon wrapper\"><i aria-hidden=\"true\" class=\"icon-play inline-block size-[30px] translate-x-[2px]\" data-kid=\"1-3-1-3-1-2-1\" data-name=\"emblem play icon\"></i></span>\n<span class=\"display relative text-[35px] font-medium leading-none tracking-[-.6px] text-[#f3e8cd]\" data-kid=\"1-3-1-3-1-3\" data-name=\"emblem brand name text\">YT Media</span>\n</div>\n</div>\n</div>\n<h1 class=\"display mt-9 text-[44px] font-medium leading-[1.1] tracking-[-.8px]\" data-kid=\"1-3-2\" data-name=\"headline with call to action\" id=\"vault-title\">Enter vault PIN</h1>\n<p class=\"mt-3 text-[14px] font-medium text-[#c6c0b2]\" data-kid=\"1-3-3\" data-name=\"subheadline with instructions\">Use the keypad or your keyboard.</p>\n<div aria-label=\"Four empty PIN indicators\" class=\"mt-7 flex items-center justify-center gap-[17px]\" data-kid=\"1-3-4\" data-name=\"decorative indicator dots group\" role=\"img\">\n<span class=\"indicator size-[15px] rounded-full border border-[#e2d7b8]/25\" data-kid=\"1-3-4-1\" data-name=\"dot indicator\"></span>\n<span class=\"indicator size-[15px] rounded-full border border-[#e2d7b8]/25\" data-kid=\"1-3-4-2\" data-name=\"dot indicator\"></span>\n<span class=\"indicator size-[15px] rounded-full border border-[#e2d7b8]/25\" data-kid=\"1-3-4-3\" data-name=\"dot indicator\"></span>\n<span class=\"indicator size-[15px] rounded-full border border-[#e2d7b8]/25\" data-kid=\"1-3-4-4\" data-name=\"dot indicator\"></span>\n</div>\n<div aria-label=\"PIN keypad\" class=\"mt-9 grid grid-cols-3 gap-x-[25px] gap-y-[15px]\" data-kid=\"1-3-5\" data-name=\"keypad button grid\" role=\"group\">\n<button aria-label=\"Digit 1\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-1\" data-name=\"keypad digit one button\" type=\"button\">1</button>\n<button aria-label=\"Digit 2\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-2\" data-name=\"keypad digit two button\" type=\"button\">2</button>\n<button aria-label=\"Digit 3\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-3\" data-name=\"keypad digit three button\" type=\"button\">3</button>\n<button aria-label=\"Digit 4\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-4\" data-name=\"keypad digit four button\" type=\"button\">4</button>\n<button aria-label=\"Digit 5\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-5\" data-name=\"keypad digit five button\" type=\"button\">5</button>\n<button aria-label=\"Digit 6\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-6\" data-name=\"keypad digit six button\" type=\"button\">6</button>\n<button aria-label=\"Digit 7\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-7\" data-name=\"keypad digit seven button\" type=\"button\">7</button>\n<button aria-label=\"Digit 8\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-8\" data-name=\"keypad digit eight button\" type=\"button\">8</button>\n<button aria-label=\"Digit 9\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-9\" data-name=\"keypad digit nine button\" type=\"button\">9</button>\n<div aria-hidden=\"true\" class=\"size-[72px]\" data-kid=\"1-3-5-10\" data-name=\"keypad layout spacer\"></div>\n<button aria-label=\"Digit 0\" class=\"key flex size-[72px] items-center justify-center rounded-full text-[26px] font-medium tabular-nums text-[#f2eee1]\" data-kid=\"1-3-5-11\" data-name=\"keypad digit zero button\" type=\"button\">0</button>\n<button aria-label=\"Backspace\" class=\"flex size-[72px] cursor-pointer items-center justify-center rounded-full text-[23px] text-[#d4c6a5] hover:bg-white/5 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e4cf91]\" data-kid=\"1-3-5-12\" data-name=\"backspace key\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-delete inline-block size-[23px]\" data-kid=\"1-3-5-12-1\" data-name=\"delete left icon\"></i></button>\n</div>\n<p class=\"mt-7 flex items-center gap-2 text-[13px] font-medium text-[#a9a498]\" data-kid=\"1-3-6\" data-name=\"footer note with keyboard hint\"><span class=\"text-[15px]\" data-kid=\"1-3-6-1\" data-name=\"keyboard icon wrapper\"><i aria-hidden=\"true\" class=\"icon-keyboard inline-block size-[15px]\" data-kid=\"1-3-6-1-1\" data-name=\"keyboard icon\"></i></span>Keyboard input supported</p>\n</main>\n<footer class=\"relative mx-auto mb-9 flex w-[calc(100%-96px)] flex-col items-center gap-5\" data-kid=\"1-4\" data-name=\"footer branding area\">\n<div aria-hidden=\"true\" class=\"h-px w-[280px] bg-[linear-gradient(90deg,transparent,rgba(224,201,142,.25),transparent)]\" data-kid=\"1-4-1\" data-name=\"decorative divider line\"></div>\n<p class=\"text-center text-[13px] font-medium leading-6 text-[#c8c0ae]\" data-kid=\"1-4-2\" data-name=\"attribution text\"><span class=\"text-[#e1c982]\" data-kid=\"1-4-2-1\" data-name=\"attribution brand name\">YT Media</span> <span class=\"mx-1.5 text-[#9b927c]\" data-kid=\"1-4-2-2\" data-name=\"attribution dot separator\">•</span> Powered by Vorex Agency <span class=\"mx-1.5 text-[#9b927c]\" data-kid=\"1-4-2-3\" data-name=\"attribution pipe separator\">|</span> Built by Dhiraj Kondalwar</p>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif(window.gsap){gsap.utils.toArray('.vault-orb').forEach(function(orb,index){gsap.to(orb,{x:index%2===0?38:-30,y:index%2===0?-24:32,scale:1.08,duration:18+index*4,repeat:-1,yoyo:true,ease:'sine.inOut'});});}\n</script>",
