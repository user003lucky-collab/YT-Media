    "var_6a3b9e23ea03": {
      "type": "variant",
      "label": "01 Private Screening — Studio Media / Desktop",
      "parentId": "var_b231da24bee8",
      "themeId": null,
      "rect": {
        "x": 5530,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.studio-media { --obsidian:#040407; --ivory:#f5f3ea; --gold:#d4af37; font-family:'Raleway',sans-serif; background:var(--obsidian); color:var(--ivory); }\n.studio-media .display { font-family:'Cormorant',serif; }\n.studio-media .glass { background:linear-gradient(120deg,rgba(255,255,255,.065),rgba(255,255,255,.025)); backdrop-filter:blur(30px) saturate(200%); border:1px solid rgba(245,243,234,.14); box-shadow:inset 0 1px 1px rgba(255,255,255,.25); }\n.studio-media .well { background:rgba(4,4,7,.3); border:1px solid rgba(245,243,234,.15); box-shadow:inset 0 1px 2px #04040740; }\n.studio-media .rim { position:relative; }\n.studio-media .rim:before { content:''; position:absolute; top:0; left:28px; right:28px; height:1px; background:linear-gradient(90deg,transparent,#d4af3780,#06b6d440,transparent); }\n.studio-media button { cursor:default; }\n.studio-media button:focus-visible,.studio-media input:focus-visible,.studio-media select:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }\n.studio-media i { display:inline-block; width:1em; height:1em; color:inherit; }\n.studio-media select option { background:#17161a; color:#f5f3ea; }\n.studio-media input[type=checkbox] { accent-color:#e4cf91; }\n.studio-media .inventory th { font-weight:500; text-align:left; color:#b9b4a9; }\n.studio-media .inventory td { vertical-align:middle; }\n</style>\n<div class=\"studio-media relative isolate min-w-[1100px] overflow-x-clip px-7 pt-6 pb-6 text-[14px] font-medium\" data-kid=\"1\" data-name=\"studio media app page container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background layer\">\n<div class=\"orb absolute -top-48 -left-40 h-[700px] w-[650px] rounded-full bg-[#d4af37]/10 blur-[130px]\" data-kid=\"1-1-1\" data-name=\"gold decorative glow orb\"></div>\n<div class=\"orb absolute top-20 right-0 h-[600px] w-[600px] rounded-full bg-[#ff0033]/7 blur-[130px]\" data-kid=\"1-1-2\" data-name=\"red decorative glow orb\"></div>\n<div class=\"orb absolute bottom-0 left-[400px] h-[700px] w-[700px] rounded-full bg-[#4f46e5]/10 blur-[145px]\" data-kid=\"1-1-3\" data-name=\"indigo decorative glow orb\"></div>\n<div class=\"orb absolute bottom-20 -right-48 h-[600px] w-[500px] rounded-full bg-[#06b6d4]/8 blur-[125px]\" data-kid=\"1-1-4\" data-name=\"cyan decorative glow orb\"></div>\n</div>\n<header class=\"glass relative flex h-[88px] items-center justify-between gap-6 rounded-[28px] px-5\" data-kid=\"1-2\" data-name=\"app top header bar\">\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"flex w-[360px] shrink-0 items-center gap-3.5\" data-kid=\"1-2-1\" data-name=\"brand identity group\">\n<div aria-hidden=\"true\" class=\"glass flex size-[49px] shrink-0 items-center justify-center rounded-full text-[21px] text-[#e6ce8c]\" data-kid=\"1-2-1-1\" data-name=\"brand play badge\"><i class=\"icon-play ml-0.5\" data-kid=\"1-2-1-1-1\" data-name=\"play icon\"></i></div>\n<div class=\"leading-[1.4]\" data-kid=\"1-2-1-2\" data-name=\"brand text group\"><span class=\"block text-[20px] font-semibold tracking-[-.5px]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name row\">YT Media <span class=\"text-[14px] text-[#d6bf7c]\" data-kid=\"1-2-1-2-1-1\" data-name=\"decorative bullet separator\">•</span></span><span class=\"mt-0.5 block text-[13px] font-medium text-[#e2dfd6]\" data-kid=\"1-2-1-2-2\" data-name=\"brand byline text\">Powered by Vorex Agency |<br data-kid=\"1-2-1-2-2-1\" data-name=\"line break\"/>Built by Dhiraj Kondalwar</span></div>\n</div>\n<div class=\"mr-auto flex items-center gap-4 border-l border-white/12 pl-6\" data-kid=\"1-2-2\" data-name=\"studio title group\"><span class=\"text-[20px] text-[#d6bf7c]\" data-kid=\"1-2-2-1\" data-name=\"settings sliders icon wrapper\"><i class=\"icon-sliders-horizontal\" data-kid=\"1-2-2-1-1\" data-name=\"sliders horizontal icon\"></i></span><h1 class=\"text-[21px] font-semibold tracking-[-.6px]\" data-kid=\"1-2-2-2\" data-name=\"studio page title\">YT Media Studio</h1></div>\n<div class=\"flex shrink-0 items-center gap-5\" data-kid=\"1-2-3\" data-name=\"header action group\">\n<button class=\"flex h-12 items-center gap-2 text-[#e4d2a0]\" data-kid=\"1-2-3-1\" data-name=\"view portal link button\" type=\"button\">View portal <span class=\"text-[18px]\" data-kid=\"1-2-3-1-1\" data-name=\"arrow up right icon wrapper\"><i class=\"icon-arrow-up-right\" data-kid=\"1-2-3-1-1-1\" data-name=\"arrow up right icon\"></i></span></button>\n<span class=\"h-6 w-px bg-white/12\" data-kid=\"1-2-3-2\" data-name=\"vertical divider line\"></span>\n<div class=\"flex items-center gap-2.5 text-[#d0cabd]\" data-kid=\"1-2-3-3\" data-name=\"user identity group\"><span class=\"text-[18px]\" data-kid=\"1-2-3-3-1\" data-name=\"user icon wrapper\"><i class=\"icon-user-round\" data-kid=\"1-2-3-3-1-1\" data-name=\"user round icon\"></i></span><span data-kid=\"1-2-3-3-2\" data-name=\"user role label\">Administrator</span></div>\n<button class=\"flex h-12 items-center gap-2 rounded-[17px] border border-white/15 bg-white/4 px-4 text-[#e1dcd1]\" data-kid=\"1-2-3-4\" data-name=\"sign out button\" type=\"button\">Sign out <span class=\"text-[17px]\" data-dynamic=\"true\" data-kid=\"1-2-3-4-1\" data-name=\"log out icon wrapper\" data-reason=\"text replaced on hover by icon script\"><i class=\"icon-log-out\" data-kid=\"1-2-3-4-1-1\"></i></span></button>\n</div>\n</header>\n<main class=\"mt-7\" data-kid=\"1-3\">\n<div class=\"mb-6 flex items-end justify-between\" data-kid=\"1-3-1\">\n<div data-kid=\"1-3-1-1\"><h2 class=\"display text-[44px] font-medium leading-none tracking-[-.6px]\" data-kid=\"1-3-1-1-1\">Manage your collection</h2><p class=\"mt-3 text-[14px] text-[#c1baad]\" data-kid=\"1-3-1-1-2\">Add a film, a passing moment, a photograph, a sound.</p></div>\n<nav aria-label=\"Studio workspaces\" class=\"glass flex h-[54px] items-center gap-1 rounded-full p-1.5\" data-kid=\"1-3-1-2\">\n<button aria-current=\"page\" class=\"flex h-[40px] items-center gap-2 rounded-full bg-[#e4cf91] px-6 font-bold text-[#211d12]\" data-kid=\"1-3-1-2-1\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-3-1-2-1-1\"><i class=\"icon-library\" data-kid=\"1-3-1-2-1-1-1\"></i></span>Media</button>\n<button class=\"flex h-[40px] items-center gap-2 rounded-full px-5 text-[#dbd5c9]\" data-kid=\"1-3-1-2-2\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-3-1-2-2-1\"><i class=\"icon-panels-top-left\" data-kid=\"1-3-1-2-2-1-1\"></i></span>Site &amp; hero</button>\n</nav>\n</div>\n<div class=\"grid grid-cols-[minmax(0,44fr)_minmax(0,56fr)] items-start gap-6\" data-kid=\"1-3-2\">\n<section aria-labelledby=\"editor-title\" class=\"glass rim rounded-[28px] px-7 pt-6 pb-7\" data-kid=\"1-3-2-1\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-2-1-1\"><div data-kid=\"1-3-2-1-1-1\"><h3 class=\"display text-[31px] font-medium leading-tight\" data-kid=\"1-3-2-1-1-1-1\" id=\"editor-title\">Add new media</h3><p class=\"mt-1.5 text-[13px] leading-6 text-[#c0b9ac]\" data-kid=\"1-3-2-1-1-1-2\">Choose the source. Shape its first impression.</p></div><span class=\"flex size-10 items-center justify-center rounded-full border border-[#d4af37]/25 bg-[#d4af37]/5 text-[19px] text-[#d8c385]\" data-kid=\"1-3-2-1-1-2\"><i class=\"icon-plus\" data-kid=\"1-3-2-1-1-2-1\"></i></span></div>\n<form class=\"mt-6\" data-kid=\"1-3-2-1-2\" onsubmit=\"event.preventDefault()\">\n<label class=\"mb-2.5 block text-[14px] text-[#e5dfd3]\" data-kid=\"1-3-2-1-2-1\" for=\"studio-title\">Title / Caption</label>\n<input class=\"well h-[49px] w-full rounded-[17px] px-4 text-[15px] text-[#f5f3ea] outline-hidden\" data-kid=\"1-3-2-1-2-2\" id=\"studio-title\" type=\"text\" value=\"Where the land ends\"/>\n<div class=\"mt-5\" data-kid=\"1-3-2-1-2-3\">\n<label class=\"mb-2.5 block text-[14px] text-[#e5dfd3]\" data-kid=\"1-3-2-1-2-3-1\" for=\"studio-section\">Section Category</label>\n<div class=\"relative\" data-kid=\"1-3-2-1-2-3-2\"><select class=\"well h-[49px] w-full appearance-none rounded-[17px] px-4 text-[14px] text-[#f5f3ea] outline-hidden\" data-kid=\"1-3-2-1-2-3-2-1\" id=\"studio-section\"><option data-kid=\"1-3-2-1-2-3-2-1-1\" selected=\"\">Videos</option><option data-kid=\"1-3-2-1-2-3-2-1-2\">Shorts</option><option data-kid=\"1-3-2-1-2-3-2-1-3\">Post</option><option data-kid=\"1-3-2-1-2-3-2-1-4\">Music</option></select><span class=\"pointer-events-none absolute top-4 right-4 text-[18px] text-[#c8beaa]\" data-kid=\"1-3-2-1-2-3-2-2\"><i class=\"icon-chevron-down\" data-kid=\"1-3-2-1-2-3-2-2-1\"></i></span></div>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-2-1-2-4\">\n<label class=\"mb-2.5 block text-[14px] text-[#e5dfd3]\" data-kid=\"1-3-2-1-2-4-1\" for=\"studio-source\">Media Source Link</label>\n<div class=\"relative\" data-kid=\"1-3-2-1-2-4-2\"><span class=\"absolute top-4 left-4 text-[18px] text-[#a9a294]\" data-kid=\"1-3-2-1-2-4-2-1\"><i class=\"icon-link\" data-kid=\"1-3-2-1-2-4-2-1-1\"></i></span><input aria-describedby=\"source-help\" class=\"well h-[49px] w-full rounded-[17px] pr-4 pl-11 text-[13px] text-[#ded8cc] outline-hidden\" data-kid=\"1-3-2-1-2-4-2-2\" id=\"studio-source\" type=\"url\" value=\"https://www.youtube.com/watch?v=coastFilm01\"/></div>\n<p class=\"mt-2.5 flex items-center gap-2 text-[13px] text-[#cfbe8b]\" data-kid=\"1-3-2-1-2-4-3\" id=\"source-help\"><span class=\"text-[15px]\" data-kid=\"1-3-2-1-2-4-3-1\"><i class=\"icon-circle-check\" data-kid=\"1-3-2-1-2-4-3-1-1\"></i></span>YouTube video detected <span class=\"text-[#a9a293]\" data-kid=\"1-3-2-1-2-4-3-2\">— sample link</span></p>\n</div>\n<div class=\"mt-5\" data-kid=\"1-3-2-1-2-5\">\n<label class=\"mb-2.5 block text-[14px] text-[#e5dfd3]\" data-kid=\"1-3-2-1-2-5-1\" for=\"studio-cover\">Custom Thumbnail / Cover Image Link</label>\n<input aria-describedby=\"cover-help\" class=\"well h-[49px] w-full rounded-[17px] px-4 text-[13px] text-[#ded8cc] outline-hidden\" data-kid=\"1-3-2-1-2-5-2\" id=\"studio-cover\" type=\"url\" value=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg\"/>\n<p class=\"mt-2 text-[13px] leading-5 text-[#bdb4a4]\" data-kid=\"1-3-2-1-2-5-3\" id=\"cover-help\">Leave blank to use an available source thumbnail.</p>\n</div>\n<label class=\"mt-5 flex min-h-10 items-center gap-3 text-[14px] text-[#e8dfcc]\" data-kid=\"1-3-2-1-2-6\"><input aria-label=\"Pin to Home Featured\" checked=\"\" class=\"size-[18px] rounded\" data-kid=\"1-3-2-1-2-6-1\" type=\"checkbox\"/><span class=\"flex items-center gap-2\" data-kid=\"1-3-2-1-2-6-2\"><span class=\"text-[16px] text-[#d4bc78]\" data-kid=\"1-3-2-1-2-6-2-1\"><i class=\"icon-pin\" data-kid=\"1-3-2-1-2-6-2-1-1\"></i></span>Pin to Home Featured</span></label>\n<div class=\"mt-5\" data-kid=\"1-3-2-1-2-7\">\n<div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-3-2-1-2-7-1\"><h4 class=\"text-[14px] text-[#e5dfd3]\" data-kid=\"1-3-2-1-2-7-1-1\">Thumbnail preview</h4><span class=\"text-[12px] text-[#b9af9d]\" data-kid=\"1-3-2-1-2-7-1-2\">Custom cover</span></div>\n<div class=\"relative aspect-video overflow-hidden rounded-[19px] border border-[#e4cf91]/25 bg-[#13191d]\" data-kid=\"1-3-2-1-2-7-2\">\n<img alt=\"Coastal film cover, dark volcanic coastline and silver surf — Lorenzo Alessio Messina on Pexels\" class=\"size-full object-cover\" data-kid=\"1-3-2-1-2-7-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1000&amp;h=562&amp;fit=crop&amp;q=80\"/>\n<div class=\"absolute inset-0 bg-[linear-gradient(0deg,rgba(4,4,7,.9),transparent_80%),linear-gradient(90deg,rgba(4,4,7,.3),transparent)]\" data-kid=\"1-3-2-1-2-7-2-2\"></div>\n<span class=\"glass absolute top-3 right-3 flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[12px] text-[#ecdfbd]\" data-kid=\"1-3-2-1-2-7-2-3\"><span class=\"text-[12px]\" data-kid=\"1-3-2-1-2-7-2-3-1\"><i class=\"icon-pin\" data-kid=\"1-3-2-1-2-7-2-3-1-1\"></i></span>Home featured</span>\n<div class=\"absolute bottom-5 left-5\" data-kid=\"1-3-2-1-2-7-2-4\"><p class=\"mb-1.5 text-[12px] text-[#dcd2bf]\" data-kid=\"1-3-2-1-2-7-2-4-1\">YouTube · Coastal film</p><h5 class=\"display text-[36px] leading-none text-[#fbf8ee]\" data-kid=\"1-3-2-1-2-7-2-4-2\">Where the land ends</h5></div>\n<div aria-hidden=\"true\" class=\"glass absolute top-1/2 left-1/2 flex size-12 -translate-1/2 items-center justify-center rounded-full text-[20px] text-[#f3e7c6]\" data-kid=\"1-3-2-1-2-7-2-5\"><i class=\"icon-play ml-0.5\" data-kid=\"1-3-2-1-2-7-2-5-1\"></i></div>\n</div>\n<p class=\"mt-2.5 text-[12px] leading-5 text-[#b3aa99]\" data-kid=\"1-3-2-1-2-7-3\">Design preview using a supplied cover. Media has not been fetched.</p>\n</div>\n<div class=\"mt-6 flex items-center justify-between gap-4 border-t border-white/10 pt-5\" data-kid=\"1-3-2-1-2-8\"><span class=\"text-[13px] text-[#bdb4a3]\" data-kid=\"1-3-2-1-2-8-1\">Publishes to <span class=\"text-[#e5dbbf]\" data-kid=\"1-3-2-1-2-8-1-1\">Videos</span></span><button class=\"flex h-[49px] items-center gap-2.5 rounded-full bg-[#e4cf91] px-6 font-bold text-[#211d12]\" data-kid=\"1-3-2-1-2-8-2\" type=\"submit\"><span class=\"text-[18px]\" data-kid=\"1-3-2-1-2-8-2-1\"><i class=\"icon-plus\" data-kid=\"1-3-2-1-2-8-2-1-1\"></i></span>Add media</button></div>\n</form>\n</section>\n<section aria-labelledby=\"inventory-title\" class=\"glass rim overflow-hidden rounded-[28px] px-6 pt-6 pb-4\" data-kid=\"1-3-2-2\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-2-2-1\"><div data-kid=\"1-3-2-2-1-1\"><h3 class=\"display text-[31px] font-medium leading-tight\" data-kid=\"1-3-2-2-1-1-1\" id=\"inv