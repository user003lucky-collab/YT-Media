      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Heebo:wght@400;450;500;600;700&family=Staatliches&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html, body { height: 100%; }\n  .yt-app { font-family: 'Heebo', sans-serif; color: #f5f3ea; background: #040407; }\n  .yt-display { font-family: 'Staatliches', sans-serif; font-weight: 400; }\n  .yt-glass { background: rgba(255,255,255,.04); backdrop-filter: blur(30px) saturate(200%); box-shadow: inset 0 1px 1px rgba(255,255,255,.25); border: 1px solid rgba(173,169,163,.18); }\n  .yt-scroll { scrollbar-width: thin; scrollbar-color: #5a5144 transparent; scrollbar-gutter: stable; }\n  .yt-room-video { border-top: 1px solid #ff003330; padding-top: 18px; }\n  .yt-room-shorts { border-top: 1px solid #7770cf50; padding-top: 18px; }\n  .yt-room-post { border-top: 1px solid #06b6d435; padding-top: 18px; }\n  .yt-room-video, .yt-room-shorts, .yt-room-post { border-radius: 0; }\n  .yt-media.yt-glass { box-shadow: none; background: transparent; border-color: #827d733b; }\n  .yt-app > div[aria-hidden] { opacity: .28; }\n  .yt-app main article > div.size-\\[132px\\] { width: 104px; height: 104px; }\n  .yt-vinyl { background: repeating-radial-gradient(circle at center, #0c0d10 0px, #0c0d10 2px, #242426 3px, #0c0d10 4px); box-shadow: 0 3px 14px #0009, inset 0 0 0 1px #595346; }\n  .yt-aurora { animation: yt-drift 20s ease-in-out infinite alternate; }\n  .yt-control { transition: background-color .18s, border-color .18s, transform .18s; }\n  .yt-control:hover { background-color: rgba(255,255,255,.09); }\n  .yt-control:active { transform: scale(.96); }\n  .yt-control:focus-visible, .yt-search:focus-visible { outline: 2px solid #d4af37; outline-offset: 4px; }\n  .yt-media { transition: border-color .18s; }\n  .yt-media:hover { border-color: #bcb1a06b; }\n  .yt-room-link:hover { color: #f5f3ea; }\n  @keyframes yt-drift { to { transform: translate3d(35px,20px,0) scale(1.08); } }\n  @media (prefers-reduced-motion: reduce) { .yt-aurora { animation: none; } .yt-control { transition: none; } }\n</style>\n<div class=\"yt-app relative isolate h-full overflow-clip p-5\" data-kid=\"1\" data-limitations=\"Independent stateless visual view. No routing, authentication, storage or real playback. Home scrolls within its own pane; the vinyl deck remains outside that pane.\" data-name=\"YT Media app root container\" data-node-id=\"var_547312ae3757\" data-review-scope=\"Direction 2 Format Rooms desktop Home; reviewed and refined\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-clip\" data-kid=\"1-1\" data-name=\"decorative aurora background layer\">\n<div class=\"yt-aurora absolute -left-36 top-36 h-[620px] w-[480px] rounded-full bg-[#d4af37]/10 blur-[110px]\" data-kid=\"1-1-1\" data-name=\"aurora gold glow orb\"></div>\n<div class=\"yt-aurora absolute left-[32%] top-[440px] h-[430px] w-[520px] rounded-full bg-[#ff0033]/10 blur-[110px]\" data-kid=\"1-1-2\" data-name=\"aurora red glow orb\" style=\"animation-delay:-9s\"></div>\n<div class=\"yt-aurora absolute -right-24 top-[280px] h-[650px] w-[500px] rounded-full bg-[#4f46e5]/15 blur-[110px]\" data-kid=\"1-1-3\" data-name=\"aurora indigo glow orb\" style=\"animation-delay:-4s\"></div>\n<div class=\"yt-aurora absolute bottom-[-160px] left-[48%] h-[460px] w-[550px] rounded-full bg-[#06b6d4]/10 blur-[110px]\" data-kid=\"1-1-4\" data-name=\"aurora cyan glow orb\" style=\"animation-delay:-12s\"></div>\n</div>\n<div class=\"grid h-full grid-cols-[164px_minmax(0,1fr)] grid-rows-[76px_minmax(0,1fr)_100px] gap-x-6 gap-y-5\" data-kid=\"1-2\" data-name=\"app main grid layout\">\n<header aria-label=\"YT Media header\" class=\"yt-glass col-span-2 flex items-center gap-7 rounded-[22px] px-5\" data-kid=\"1-2-1\" data-name=\"top app header bar\">\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"flex w-[405px] shrink-0 items-center gap-3.5\" data-kid=\"1-2-1-1\" data-name=\"brand identity group\">\n<div aria-hidden=\"true\" class=\"flex size-11 shrink-0 items-center justify-center rounded-[14px] border border-[#d4af37]/40 bg-[#d4af37]/8 text-[22px] text-[#e2c66e]\" data-kid=\"1-2-1-1-1\" data-name=\"app logo mark badge\"><i class=\"icon-orbit\" data-kid=\"1-2-1-1-1-1\" data-name=\"orbit logo icon\"></i></div>\n<p class=\"leading-[1.45]\" data-kid=\"1-2-1-1-2\" data-name=\"brand name and attribution text\"><strong class=\"text-[21px] font-medium tracking-[-.5px]\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name heading\">YT Media</strong><span class=\"ml-1.5 text-[13px] text-[#d9d2bd]\" data-kid=\"1-2-1-1-2-2\" data-name=\"powered-by agency credit\">• Powered by Vorex Agency</span><span class=\"block text-[13px] text-[#aea99e]\" data-kid=\"1-2-1-1-2-3\" data-name=\"built-by developer credit\">| Built by Dhiraj Kondalwar</span></p>\n</div>\n<label class=\"flex h-12 min-w-0 flex-1 items-center gap-3 rounded-full border border-[#69645a]/35 bg-black/35 px-4 shadow-[inset_0_2px_6px_#0008]\" data-kid=\"1-2-1-2\" data-name=\"search bar container\">\n<span class=\"text-[19px] text-[#d6d0c1]\" data-kid=\"1-2-1-2-1\" data-name=\"search icon wrapper\"><i class=\"icon-search\" data-kid=\"1-2-1-2-1-1\" data-name=\"search magnifier icon\"></i></span>\n<input aria-label=\"Search all media\" class=\"yt-search w-full min-w-0 bg-transparent text-[14px] text-[#f5f3ea] outline-hidden placeholder:text-[#a8a59f]\" data-kid=\"1-2-1-2-2\" data-name=\"search input field\" placeholder=\"Search videos, Shorts, posts and music\" type=\"search\"/>\n</label>\n<div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-3\" data-name=\"header action button group\">\n<button class=\"yt-control flex h-11 items-center gap-2.5 rounded-xl px-3 text-[13px] text-[#e5e0d4]\" data-kid=\"1-2-1-3-1\" data-name=\"lock vault button\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-2-1-3-1-1\" data-name=\"lock icon wrapper\"><i class=\"icon-lock-keyhole\" data-kid=\"1-2-1-3-1-1-1\" data-name=\"lock keyhole icon\"></i></span>Lock Vault</button>\n</div>\n</header>\n<aside aria-label=\"Main navigation\" class=\"flex flex-col items-stretch pt-1\" data-kid=\"1-2-2\" data-name=\"main navigation sidebar\">\n<div class=\"yt-glass rounded-[24px] p-2.5\" data-kid=\"1-2-2-1\" data-name=\"navigation panel card\">\n<div class=\"mb-3 flex h-10 items-center justify-between px-3 text-[13px] text-[#aaa69c]\" data-kid=\"1-2-2-1-1\" data-name=\"navigation header row\"><span data-kid=\"1-2-2-1-1-1\" data-name=\"browse section label\">Browse</span><button aria-label=\"Collapse sidebar\" class=\"yt-control flex size-8 items-center justify-center rounded-lg text-[17px]\" data-kid=\"1-2-2-1-1-2\" data-name=\"collapse sidebar button\" type=\"button\"><i class=\"icon-panel-left-close\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"panel close icon\"></i></button></div>\n<nav class=\"flex flex-col gap-2\" data-kid=\"1-2-2-1-2\" data-name=\"sidebar navigation list\">\n<button aria-current=\"page\" class=\"flex h-[54px] items-center gap-3 rounded-[15px] border border-[#d4af37]/30 bg-[#d4af37]/12 px-4 text-[14px] font-medium text-[#e1c468]\" data-kid=\"1-2-2-1-2-1\" data-name=\"home navigation item (active)\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"home icon wrapper\"><i class=\"icon-house\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"house icon\"></i></span>Home<span class=\"ml-auto size-1.5 rounded-full bg-[#d4af37]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"active state indicator dot\"></span></button>\n<button class=\"yt-control flex h-[54px] items-center gap-3 rounded-[15px] px-4 text-[14px] text-[#c7c4bd]\" data-kid=\"1-2-2-1-2-2\" data-name=\"videos navigation item\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"videos icon wrapper\"><i class=\"icon-clapperboard\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"clapperboard icon\"></i