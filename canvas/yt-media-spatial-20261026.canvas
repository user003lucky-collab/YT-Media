      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  body { background-color: #040407; }\n  .screening { font-family: 'Raleway', sans-serif; background: #040407; color: #f5f3ea; }\n  .cinema-serif { font-family: 'Cormorant', serif; }\n  .glass { background: rgba(255,255,255,.04); backdrop-filter: blur(30px) saturate(200%); -webkit-backdrop-filter: blur(30px) saturate(200%); box-shadow: inset 0 1px 1px rgba(255,255,255,.18); }\n  .specular { border: 1px solid transparent; background: linear-gradient(#141316e8,#0e1018eb) padding-box, linear-gradient(120deg,#d4af3766,#ffffff1a 45%,#06b6d433) border-box; }\n  .shelf { scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding-inline: 16px; padding-inline: 16px; }\n  .shelf::after { content: ''; flex: 0 0 4px; }\n  .shelf::-webkit-scrollbar, .home-scroll::-webkit-scrollbar { display:none; }\n  .home-scroll { scrollbar-width:none; }\n  .shelf > article { scroll-snap-align:start; }\n  .screening button:focus-visible, .screening a:focus-visible { outline:2px solid #d4af37; outline-offset:3px; }\n  .vinyl { background: repeating-radial-gradient(circle, #151418 0px, #151418 2px, #37312a 3px, #111013 4px); }\n</style>\n<!-- Node var_6cfb358b5fd6 · Private Screening / Phone Home. Independent visual prototype: no playback, authentication, or routing. The bounded web-app scroll region keeps the absolute-positioned dock and capsule available without fixed or sticky positioning. -->\n<div class=\"screening relative isolate mx-auto h-[1000px] w-full max-w-[480px] overflow-x-clip\" data-kid=\"1\" data-name=\"screening app outer frame\">\n<!-- Canvas-height preview, intentionally without viewport units. Production embedding should give this scroll container the available app height. -->\n<div class=\"home-scroll relative h-full overflow-y-auto overscroll-y-contain pb-[calc(190px+env(safe-area-inset-bottom))]\" data-kid=\"1-1\" data-name=\"scrollable home content region\">\n<header class=\"glass mx-3 mt-3 grid grid-cols-[1fr_auto] items-center gap-x-2 rounded-[24px] px-3 pt-1 pb-3\" data-kid=\"1-1-1\" data-name=\"app header bar\">\n<div class=\"cinema-serif min-w-0 pl-1 text-[27px] leading-8 font-semibold text-[#f5f3ea]\" data-kid=\"1-1-1-1\" data-name=\"app brand wordmark\">YT Media</div>\n<div class=\"flex shrink-0 items-center text-[19px] text-[#f0ede3]\" data-kid=\"1-1-1-2\" data-name=\"header action icon group\">\n<button aria-label=\"Search\" class=\"flex size-12 items-center justify-center rounded-full active:bg-white/10\" data-kid=\"1-1-1-2-1\" data-name=\"search action button\" title=\"Search\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-1-1-2-1-1\" data-name=\"search magnifier icon\"></i></button>\n<button aria-label=\"Admin Studio\" class=\"flex size-12 items-center justify-center rounded-full active:bg-white/10\" data-kid=\"1-1-1-2-2\" data-name=\"admin studio action button\" title=\"Admin Studio\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-sliders-horizontal\" data-kid=\"1-1-1-2-2-1\" data-name=\"sliders icon\"></i></button>\n<button aria-label=\"Lock Vault\" class=\"flex size-12 items-center justify-center rounded-full active:bg-white/10\" data-kid=\"1-1-1-2-3\" data-name=\"lock vault action button\" title=\"Lock Vault\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-1-1-2-3-1\" data-name=\"lock icon\"></i></button>\n</div>\n<p class=\"col-span-2 px-1 text-[12px] leading-[18px] text-[#d5d0c3]\" data-kid=\"1-1-1-3\" data-name=\"header credit line\">YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar</p>\n</header>\n<main class=\"pt-4\" data-kid=\"1-1-2\" data-name=\"main content area\">\n<section aria-labelledby=\"featured-title\" class=\"relative mx-4 h-[304px] overflow-hidden rounded-[28px] border border-[#d4af37]/30 bg-white/4 shadow-[inset_0_1px_1px_#ffffff40]\" data-kid=\"1-1-2-1\" data-name=\"featured film hero card\">\n<img alt=\"Silver surf along a volcanic black-sand coastline at dusk. Photograph by Lorenzo Alessio Messina on Pexels.\" class=\"absolute inset-0 h-full w-full object-cover object-[54%_35%]\" data-kid=\"1-1-2-1-1\" data-name=\"featured film background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n<div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(4,4,7,0.05)_0%,rgba(4,4,7,0.12)_20%,rgba(4,4,7,0.78)_55%,rgba(4,4,7,0.96)_100%)]\" data-kid=\"1-1-2-1-2\" data-name=\"hero gradient scrim overlay\"></div>\n<div class=\"absolute inset-x-5 bottom-5\" data-kid=\"1-1-2-1-3\" data-name=\"hero text content group\">\n<h1 class=\"cinema-serif text-[43px] leading-[.94] font-medium tracking-[-1px]\" data-kid=\"1-1-2-1-3-1\" data-name=\"featured film title\" id=\"featured-title\">Where the<br data-kid=\"1-1-2-1-3-1-1\" data-name=\"line break inside title\"/>land ends</h1>\n<p class=\"mt-3 text-[14px] leading-5 text-[#e6e3d9]\" data-kid=\"1-1-2-1-3-2\" data-name=\"featured film subtitle\">A quiet film along the volcanic coast.</p>\n<div class=\"mt-4 flex items-center justify-between gap-3\" data-kid=\"1-1-2-1-3-3\" data-name=\"hero footer action row\">\n<button class=\"flex min-h-12 items-center gap-2.5 rounded-full bg-[#d4af37] px-5 text-[14px] font-semibold text-[#171409] active:bg-[#e3c358]\" data-kid=\"1-1-2-1-3-3-1\" data-name=\"play featured button\" type=\"button\">\n<span class=\"text-[17px]\" data-kid=\"1-1-2-1-3-3-1-1\" data-name=\"play icon wrapper\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-1-3-3-1-1-1\" data-name=\"play triangle icon\"></i></span>Play Featured\n            </button>\n<span class=\"text-right text-[13px] leading-[18px] text-[#d5d0c3]\" data-kid=\"1-1-2-1-3-3-2\" data-name=\"featured film meta info\">Featured film<br data-kid=\"1-1-2-1-3-3-2-1\" data-name=\"line break in meta\"/>08:24</span>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"trending-title\" class=\"mt-7\" data-kid=\"1-1-2-2\" data-name=\"trending videos section\">\n<div class=\"mb-3 flex items-center justify-between gap-3 px-5\" data-kid=\"1-1-2-2-1\" data-name=\"trending section header\">\n<h2 class=\"text-[19px] font-semibold tracking-[-.5px]\" data-kid=\"1-1-2-2-1-1\" data-name=\"trending section title\" id=\"trending-title\">Trending Videos</h2>\n<span class=\"flex items-center gap-2 text-[13px] text-[#c3bdaa]\" data-kid=\"1-1-2-2-1-2\" data-name=\"trending count with arrow\">2 films <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"small right arrow icon\"></i></span>\n</div>\n<div aria-label=\"Trending videos, swipe to browse\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-1-2-2-2\" data-name=\"trending videos horizontal carousel\" tabindex=\"0\">\n<article class=\"w-[290px] shrink-0\" data-kid=\"1-1-2-2-2-1\" data-name=\"trending video card\">\n<div class=\"glass relative aspect-video overflow-hidden rounded-[19px] border border-white/10\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"video thumbnail container\">\n<img alt=\"A long black-sand shoreline in Iceland. Photograph by Jan Canty on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-2-1-1-1\" data-name=\"video thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1790283124162-338b2f8e9171?auto=format&amp;w=640&amp;q=80&amp;fit=crop\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#040407]/55 to-transparent\" data-kid=\"1-1-2-2-2-1-1-2\" data-name=\"thumbnail scrim overlay\"></div>\n<button aria-label=\"Play The silver coast\" class=\"glass absolute bottom-3 left-3 flex size-12 items-center justify-center rounded-full border border-white/25 text-[18px]\" data-kid=\"1-1-2-2-2-1-1-3\" data-name=\"thumbnail play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-2-2-1-1-3-1\" data-name=\"play triangle icon\"></i></button>\n<span class=\"absolute right-3 bottom-3 rounded-md bg-[#040407]/70 px-2 py-1 text-[13px] tabular-nums\" data-kid=\"1-1-2-2-2-1-1-4\" data-name=\"video duration badge\">06:18</span>\n</div>\n<h3 class=\"mt-3 text-[16px] font-medium\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"video card title\">The silver coast</h3>\n<p class=\"mt-1 text-[13px] text-[#bab8b1]\" data-kid=\"1-1-2-2-2-1-3\" data-name=\"video category and location\">Nature film · Iceland</p>\n</article>\n<article class=\"w-[290px] shrink-0\" data-kid=\"1-1-2-2-2-2\" data-name=\"trending video card\">\n<div class=\"glass relative aspect-video overflow-hidden rounded-[19px] border border-white/10\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"video thumbnail container\">\n<img alt=\"An aerial study of waves meeting dark volcanic sand. Photograph by Lorenzo Alessio Messina on Pexels.\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-1-2-2-2-2-1-1\" data-name=\"video thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=640&amp;q=80\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#040407]/55 to-transparent\" data-kid=\"1-1-2-2-2-2-1-2\" data-name=\"thumbnail scrim overlay\"></div>\n<button aria-label=\"Play Ocean, after hours\" class=\"glass absolute bottom-3 left-3 flex size-12 items-center justify-center rounded-full border border-white/25 text-[18px]\" data-kid=\"1-1-2-2-2-2-1-3\" data-name=\"thumbnail play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-2-2-2-1-3-1\" data-name=\"play triangle icon\"></i></button>\n<span class=\"absolute right-3 bottom-3 rounded-md bg-[#040407]/70 px-2 py-1 text-[13px] tabular-nums\" data-kid=\"1-1-2-2-2-2-1-4\" data-name=\"video duration badge\">09:42</span>\n</div>\n<h3 class=\"mt-3 text-[16px] font-medium\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"video card title\">Ocean, after hours</h3>\n<p class=\"mt-1 text-[13px] text-[#bab8b1]\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"video category and location\">Slow cinema · Coastlines</p>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"music-title\" class=\"mt-8\" data-kid=\"1-1-2-3\" data-name=\"quick-play music section\">\n<div class=\"mb-3 flex items-center justify-between gap-3 px-5\" data-kid=\"1-1-2-3-1\" data-name=\"music section header\">\n<h2 class=\"text-[18px] font-semibold tracking-[-.5px]\" data-kid=\"1-1-2-3-1-1\" data-name=\"music section title\" id=\"music-title\">Quick-Play Music Tracks</h2>\n<span class=\"shrink-0 text-[13px] text-[#c3bdaa]\" data-kid=\"1-1-2-3-1-2\" data-name=\"tracks count label\">2 tracks</span>\n</div>\n<div aria-label=\"Music tracks, swipe to browse\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-1-2-3-2\" data-name=\"music tracks horizontal carousel\" tabindex=\"0\">\n<article class=\"glass flex w-[302px] shrink-0 items-center gap-3 rounded-[20px] border border-[#d4af37]/20 p-3\" data-kid=\"1-1-2-3-2-1\" data-name=\"music track card\">\n<img alt=\"Luminous amber glass sculpture. Photograph by 金西 卢 on Unsplash.\" class=\"size-[66px] shrink-0 rounded-[12px] object-cover\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"album cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1683799286400-69220fa89f48?auto=format&amp;w=240&amp;q=80&amp;fit=crop\"/>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"track info group\"><h3 class=\"text-[16px] font-medium text-[#ead698]\" data-kid=\"1-1-2-3-2-1-2-1\" data-name=\"track title\">Afterglow</h3><p class=\"mt-1 text-[13px] text-[#c4bfb0]\" data-kid=\"1-1-2-3-2-1-2-2\" data-name=\"track genre and duration\">Ambient · 4:32</p></div>\n<button aria-label=\"Play Afterglow\" class=\"flex size-12 shrink-0 items-center justify-center rounded-full text-[21px] text-[#ddc77d]\" data-kid=\"1-1-2-3-2-1-3\" data-name=\"track play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-3-2-1-3-1\" data-name=\"play triangle icon\"></i></button>\n</article>\n<article class=\"glass flex w-[302px] shrink-0 items-center gap-3 rounded-[20px] border border-white/10 p-3\" data-kid=\"1-1-2-3-2-2\" data-name=\"music track card\">\n<img alt=\"Dark shore and pale ocean, cover for Still water. Photograph by Jan Canty on Unsplash.\" class=\"size-[66px] shrink-0 rounded-[12px] object-cover\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"album cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1790283124162-338b2f8e9171?auto=format&amp;w=240&amp;q=80&amp;fit=crop\"/>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"track info group\"><h3 class=\"text-[16px] font-medium\" data-kid=\"1-1-2-3-2-2-2-1\" data-name=\"track title\">Still water</h3><p class=\"mt-1 text-[13px] text-[#c4bfb0]\" data-kid=\"1-1-2-3-2-2-2-2\" data-name=\"track genre and duration\">Piano · 3:48</p></div>\n<button aria-label=\"Play Still water\" class=\"flex size-12 shrink-0 items-center justify-center rounded-full text-[21px]\" data-kid=\"1-1-2-3-2-2-3\" data-name=\"track play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-3-2-2-3-1\" data-name=\"play triangle icon\"></i></button>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"shorts-title\" class=\"mt-8\" data-kid=\"1-1-2-4\" data-name=\"latest shorts section\">\n<div class=\"mb-3 flex items-center justify-between gap-3 px-5\" data-kid=\"1-1-2-4-1\" data-name=\"shorts section header\">\n<h2 class=\"text-[19px] font-semibold tracking-[-.5px]\" data-kid=\"1-1-2-4-1-1\" data-name=\"shorts section title\" id=\"shorts-title\">Latest Shorts Preview</h2>\n<span class=\"flex items-center gap-2 text-[13px] text-[#c3bdaa]\" data-kid=\"1-1-2-4-1-2\" data-name=\"shorts count with arrow\">2 shorts <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"small right arrow icon\"></i></span>\n</div>\n<div aria-label=\"Shorts previews, swipe to browse\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-1-2-4-2\" data-name=\"shorts horizontal carousel\" tabindex=\"0\">\n<article class=\"glass relative aspect-[9/16] w-[212px] shrink-0 overflow-hidden rounded-[22px] border border-white/10\" data-kid=\"1-1-2-4-2-1\" data-name=\"shorts vertical card\">\n<img alt=\"A narrow concrete passage illuminated by warm sunset light. Photograph by Alexander Kaufmann on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-4-2-1-1\" data-name=\"shorts thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1784034292954-e988c2e1ce15?auto=format&amp;w=460&amp;q=80&amp;fit=crop\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#040407]/95 via-transparent to-[#040407]/15\" data-kid=\"1-1-2-4-2-1-2\" data-name=\"shorts scrim overlay\"></div>\n<span class=\"absolute top-3 right-3 text-[13px] text-white\" data-kid=\"1-1-2-4-2-1-3\" data-name=\"shorts duration badge\">00:32</span>\n<div class=\"absolute inset-x-4 bottom-4\" data-kid=\"1-1-2-4-2-1-4\" data-name=\"shorts content group\"><button aria-label=\"Play A passage to light\" class=\"glass mb-3 flex size-12 items-center justify-center rounded-full border border-white/25 text-[18px]\" data-kid=\"1-1-2-4-2-1-4-1\" data-name=\"shorts play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-4-2-1-4-1-1\" data-name=\"play triangle icon\"></i></button><h3 class=\"text-[17px] leading-6 font-medium\" data-kid=\"1-1-2-4-2-1-4-2\" data-name=\"shorts title\">A passage to light</h3><p class=\"mt-1 text-[13px] text-[#d6cfc2]\" data-kid=\"1-1-2-4-2-1-4-3\" data-name=\"shorts caption\">Architecture in a moment</p></div>\n</article>\n<article class=\"glass relative aspect-[9/16] w-[212px] shrink-0 overflow-hidden rounded-[22px] border border-white/10\" data-kid=\"1-1-2-4-2-2\" data-name=\"shorts vertical card\">\n<img alt=\"Silver waves folding onto a black-sand beach. Photograph by Lorenzo Alessio Messina on Pexels.\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"shorts thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33010644/pexels-photo-33010644.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=460&amp;q=80\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#040407]/95 via-transparent to-[#040407]/15\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"shorts scrim overlay\"></div>\n<span class=\"absolute top-3 right-3 text-[13px] text-white\" data-kid=\"1-1-2-4-2-2-3\" data-name=\"shorts duration badge\">00:24</span>\n<div class=\"absolute inset-x-4 bottom-4\" data-kid=\"1-1-2-4-2-2-4\" data-name=\"shorts content group\"><button aria-label=\"Play One more wave\" class=\"glass mb-3 flex size-12 items-center justify-center rounded-full border border-white/25 text-[18px]\" data-kid=\"1-1-2-4-2-2-4-1\" data-name=\"shorts play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-1-2-4-2-2-4-1-1\" data-name=\"play triangle icon\"></i></button><h3 class=\"text-[17px] leading-6 font-medium\" data-kid=\"1-1-2-4-2-2-4-2\" data-name=\"shorts title\">One more wave</h3><p class=\"mt-1 text-[13px] text-[#d6cfc2]\" data-kid=\"1-1-2-4-2-2-4-3\" data-name=\"shorts caption\">A pause by the ocean</p></div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"posts-title\" class=\"mt-8\" data-kid=\"1-1-2-5\" data-name=\"featured posts section\">\n<div class=\"mb-3 flex items-center justify-between gap-3 px-5\" data-kid=\"1-1-2-5-1\" data-name=\"posts section header\">\n<h2 class=\"text-[19px] font-semibold tracking-[-.5px]\" data-kid=\"1-1-2-5-1-1\" data-name=\"posts section title\" id=\"posts-title\">Featured Posts</h2>\n<span class=\"flex items-center gap-2 text-[13px] text-[#c3bdaa]\" data-kid=\"1-1-2-5-1-2\" data-name=\"posts count with arrow\">2 posts <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-1-2-5-1-2-1\" data-name=\"small right arrow icon\"></i></span>\n</div>\n<div aria-label=\"Featured posts, swipe to browse\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-1-2-5-2\" data-name=\"posts horizontal carousel\" tabindex=\"0\">\n<article class=\"w-[292px] shrink-0\" data-kid=\"1-1-2-5-2-1\" data-name=\"featured post card\">\n<div class=\"glass relative aspect-[4/3] overflow-hidden rounded-[22px] border border-white/10\" data-kid=\"1-1-2-5-2-1-1\" data-name=\"post image container\">\n<img alt=\"An architectural composition in illuminated amber glass. Photograph by 金西 卢 on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-5-2-1-1-1\" data-name=\"post image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1683799286400-69220fa89f48?auto=format&amp;w=640&amp;q=80&amp;fit=crop\"/>\n<button aria-label=\"Like Studies in amber\" class=\"glass absolute right-3 bottom-3 flex size-12 items-center justify-center rounded-full border border-white/20 text-[20px]\" data-kid=\"1-1-2-5-2-1-1-2\" data-name=\"post like button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-heart\" data-kid=\"1-1-2-5-2-1-1-2-1\" data-name=\"heart icon\"></i></button>\n</div>\n<h3 class=\"mt-3 text-[16px] font-medium\" data-kid=\"1-1-2-5-2-1-2\" data-name=\"post title\">Studies in amber</h3>\n<p class=\"mt-1 text-[14px] leading-[21px] text-[#c8c5bc]\" data-kid=\"1-1-2-5-2-1-3\" data-name=\"post caption\">Watching the light move through glass.</p>\n</article>\n<article class=\"w-[292px] shrink-0\" data-kid=\"1-1-2-5-2-2\" data-name=\"featured post card\">\n<div class=\"glass relative aspect-[4/3] overflow-hidden rounded-[22px] border border-white/10\" data-kid=\"1-1-2-5-2-2-1\" data-name=\"post image container\">\n<img alt=\"A quiet expanse of sea beside a volcanic shoreline. Photograph by Jan Canty on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-5-2-2-1-1\" data-name=\"post image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1790283124162-338b2f8e9171?auto=format&amp;w=640&amp;q=80&amp;fit=crop\"/>\n<button aria-label=\"Like A quieter edge\" class=\"glass absolute right-3 bottom-3 flex size-12 items-center justify-center rounded-full border border-white/20 text-[20px]\" data-kid=\"1-1-2-5-2-2-1-2\" data-name=\"post like button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-heart\" data-kid=\"1-1-2-5-2-2-1-2-1\" data-name=\"heart icon\"></i></button>\n</div>\n<h3 class=\"mt-3 text-[16px] font-medium\" data-kid=\"1-1-2-5-2-2-2\" data-name=\"post title\">A quieter edge</h3>\n<p class=\"mt-1 text-[14px] leading-[21px] text-[#c8c5bc]\" data-kid=\"1-1-2-5-2-2-3\" data-name=\"post caption\">A few stills from our time on the coast.</p>\n</article>\n</div>\n</section>\n</main>\n<footer class=\"mx-5 mt-9 border-t border-[#d4af37]/20 pt-6 text-center\" data-kid=\"1-1-3\" data-name=\"footer block\">\n<p class=\"cinema-serif text-[25px] leading-8 text-[#e8dfc2]\" data-kid=\"1-1-3-1\" data-name=\"footer brand wordmark\">YT Media</p>\n<p class=\"mx-auto mt-2 max-w-[290px] text-[13px] leading-[21px] text-[#bfbbae]\" data-kid=\"1-1-3-2\" data-name=\"footer credit line\">YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar</p>\n</footer>\n</div>\n<div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-[182px] bg-gradient-to-t from-[#040407] via-[#040407]/90 to-transparent\" data-kid=\"1-2\" data-name=\"gradient scrim for dock overlay\"></div>\n<aside aria-label=\"Music player and main navigation\" class=\"absolute inset-x-3 bottom-3 flex flex-col gap-[10px] pb-[env(safe-area-inset-bottom)]\" data-kid=\"1-3\" data-name=\"bottom dock with player and navigation\">\n<div class=\"specular glass flex h-14 items-center gap-2 rounded-full pl-2 pr-1\" data-kid=\"1-3-1\" data-name=\"now playing capsule\">\n<div class=\"vinyl relative flex size-10 shrink-0 items-center justify-center rounded-full border border-[#776247]/40\" data-kid=\"1-3-1-1\" data-name=\"vinyl record disc\">\n<img alt=\"Afterglow amber cover. Photograph by 金西 卢 on Unsplash.\" class=\"size-[22px] rounded-full object-cover\" data-kid=\"1-3-1-1-1\" data-name=\"vinyl album cover thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1683799286400-69220fa89f48?auto=format&amp;w=100&amp;q=80&amp;fit=crop\"/>\n<span class=\"absolute size-[4px] rounded-full bg-[#e4cb80]\" data-kid=\"1-3-1-1-2\" data-name=\"vinyl center dot\"></span>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2\" data-name=\"track info group\"><p class=\"truncate text-[14px] font-semibold text-[#f0e4c2]\" data-kid=\"1-3-1-2-1\" data-name=\"now playing track title\">Afterglow</p><p class=\"text-[13px] leading-[18px] text-[#bfb9ac]\" data-kid=\"1-3-1-2-2\" data-name=\"track genre and duration\">Ambient · 4:32</p></div>\n<button aria-label=\"Play Afterglow\" class=\"flex size-12 shrink-0 items-center justify-center rounded-full text-[21px] text-[#e4cd87]\" data-kid=\"1-3-1-3\" data-name=\"track play button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-3-1-3-1\" data-name=\"play triangle icon\"></i></button>\n<button aria-label=\"Next track\" class=\"flex size-12 shrink-0 items-center justify-center rounded-full text-[19px] text-[#d0cbbf]\" data-kid=\"1-3-1-4\" data-name=\"next track button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-skip-forward\" data-kid=\"1-3-1-4-1\" data-name=\"skip forward icon\"></i></button>\n</div>\n<nav aria-label=\"Main navigation\" class=\"specular glass grid h-[72px] grid-cols-5 items-center rounded-[24px] p-[6px]\" data-kid=\"1-3-2\" data-name=\"bottom tab navigation\">\n<button aria-current=\"page\" class=\"flex min-h-[56px] min-w-12 flex-col items-center justify-center gap-1 rounded-[18px] bg-[#d4af37]/10 text-[#e1c678]\" data-kid=\"1-3-2-1\" data-name=\"nav home tab (active)\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-3-2-1-1\" data-name=\"house icon wrapper\"><i aria-hidden=\"true\" class=\"icon-house\" data-kid=\"1-3-2-1-1-1\" data-name=\"house icon\"></i></span><span class=\"text-[13px] font-semibold\" data-kid=\"1-3-2-1-2\" data-name=\"tab label Home\">Home</span></button>\n<button class=\"flex min-h-[56px] min-w-12 flex-col items-center justify-center gap-1 rounded-[18px] text-[#cfcdc6]\" data-kid=\"1-3-2-2\" data-name=\"nav videos tab\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-3-2-2-1\" data-name=\"clapperboard icon wrapper\"><i aria-hidden=\"true\" class=\"icon-clapperboard\" data-kid=\"1-3-2-2-1-1\" data-name=\"clapperboard icon\"></i></span><span class=\"text-[13px] font-medium\" data-kid=\"1-3-2-2-2\" data-name=\"tab label Videos\">Videos</span></button>\n<button class=\"flex min-h-[56px] min-w-12 flex-col items-center justify-center gap-1 rounded-[18px] text-[#cfcdc6]\" data-kid=\"1-3-2-3\" data-name=\"nav shorts tab\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-3-2-3-1\" data-name=\"smartphone icon wrapper\"><i aria-hidden=\"true\" class=\"icon-smartphone\" data-kid=\"1-3-2-3-1-1\" data-name=\"smartphone icon\"></i></span><span class=\"text-[13px] font-medium\" data-kid=\"1-3-2-3-2\" data-name=\"tab label Shorts\">Shorts</span></button>\n<button class=\"flex min-h-[56px] min-w-12 flex-col items-center justify-center gap-1 rounded-[18px] text-[#cfcdc6]\" data-kid=\"1-3-2-4\" data-name=\"nav post tab\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-3-2-4-1\" data-name=\"image icon wrapper\"><i aria-hidden=\"true\" class=\"icon-image\" data-kid=\"1-3-2-4-1-1\" data-name=\"image icon\"></i></span><span class=\"text-[13px] font-medium\" data-kid=\"1-3-2-4-2\" data-name=\"tab label Post\">Post</span></button>\n<button class=\"flex min-h-[56px] min-w-12 flex-col items-center justify-center gap-1 rounded-[18px] text-[#cfcdc6]\" data-kid=\"1-3-2-5\" data-name=\"nav music tab\" type=\"button\"><span class=\"text-[21px]\" data-kid=\"1-3-2-5-1\" data-name=\"music note icon wrapper\"><i aria-hidden=\"true\" class=\"icon-music-2\" data-kid=\"1-3-2-5-1-1\" data-name=\"music note icon\"></i></span><span class=\"text-[13px] font-medium\" data-kid=\"1-3-2-5-2\" data-name=\"tab label Music\">Music</span></button>\n</nav>\n</aside>\n</div>",
