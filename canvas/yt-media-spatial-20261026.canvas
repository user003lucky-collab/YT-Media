        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600&family=Raleway:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n@layer components {\n.studio-signin { font-family:'Raleway',sans-serif; color:#f5f3ea; background:#040407; }\n.studio-signin .display { font-family:'Cormorant',serif; }\n.studio-signin .glass-plane { background:linear-gradient(123deg,rgba(255,255,255,.065),rgba(255,255,255,.025)); border:1px solid rgba(245,243,234,.16); backdrop-filter:blur(30px) saturate(200%); box-shadow:inset 0 1px 1px rgba(255,255,255,.25); }\n.studio-signin .signin-plane { background:linear-gradient(135deg,rgba(34,32,30,.7),rgba(18,18,22,.58) 55%,rgba(16,20,25,.6)) padding-box,linear-gradient(140deg,rgba(234,214,160,.63),rgba(245,243,234,.1) 28%,rgba(245,243,234,.08) 68%,rgba(6,182,212,.25)) border-box; border:1px solid transparent; backdrop-filter:blur(30px) saturate(200%); box-shadow:inset 0 1px 1px rgba(255,255,255,.25); }\n.studio-signin input { caret-color:#e4cf91; }\n.studio-signin input:focus-visible { outline:2px solid #d4af37; outline-offset:4px; }\n.studio-signin button:focus-visible { outline:2px solid #d4af37; outline-offset:5px; }\n.studio-signin .field-well { background:rgba(4,4,7,.3); box-shadow:inset 0 1px 8px rgba(4,4,7,.2); border:1px solid rgba(245,243,234,.16); }\n}\n</style>\n<div class=\"studio-signin relative isolate flex min-h-[960px] flex-col overflow-x-clip px-10 pt-7 pb-7 text-[14px] font-medium\" data-kid=\"1\" data-name=\"studio sign-in page layout container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background glow layer\">\n<div class=\"signin-orb-gold absolute -left-[230px] top-[80px] h-[650px] w-[760px] rounded-full bg-[#d4af37]/12 blur-[135px]\" data-kid=\"1-1-1\" data-name=\"floating gold ambient glow orb\"></div>\n<div class=\"signin-orb-crimson absolute right-[-150px] top-[-120px] h-[650px] w-[630px] rounded-full bg-[#ff0033]/9 blur-[145px]\" data-kid=\"1-1-2\" data-name=\"floating crimson ambient glow orb\"></div>\n<div class=\"signin-orb-indigo absolute bottom-[-340px] left-[350px] h-[700px] w-[800px] rounded-full bg-[#4f46e5]/12 blur-[160px]\" data-kid=\"1-1-3\" data-name=\"floating indigo ambient glow orb\"></div>\n<div class=\"signin-orb-cyan absolute right-[50px] top-[450px] h-[380px] w-[450px] rounded-full bg-[#06b6d4]/7 blur-[130px]\" data-kid=\"1-1-4\" data-name=\"floating cyan ambient glow orb\"></div>\n</div>\n<header class=\"relative z-10 flex items-start justify-between\" data-kid=\"1-2\" data-name=\"header bar\">\n<div aria-label=\"YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar\" class=\"glass-plane flex items-center gap-3.5 rounded-[24px] px-5 py-3.5\" data-kid=\"1-2-1\" data-name=\"brand identity badge\">\n<div aria-hidden=\"true\" class=\"glass-plane flex size-[46px] shrink-0 items-center justify-center rounded-full text-[21px] text-[#e6ce8c]\" data-kid=\"1-2-1-1\" data-name=\"brand logo icon container\"><i class=\"icon-play ml-0.5 inline-block size-[22px]\" data-kid=\"1-2-1-1-1\" data-name=\"play button icon\"></i></div>\n<div class=\"leading-[1.4]\" data-kid=\"1-2-1-2\" data-name=\"brand text block\">\n<span class=\"block text-[20px] font-semibold tracking-[-.5px]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name text\">YT Media <span class=\"text-[14px] text-[#d6bf7c]\" data-kid=\"1-2-1-2-1-1\" data-name=\"decorative separator dot\">•</span></span>\n<span class=\"mt-0.5 block text-[13px] text-[#e2dfd6]\" data-kid=\"1-2-1-2-2\" data-name=\"brand attribution text\">Powered by Vorex Agency | Built by Dhiraj Kondalwar</span>\n</div>\n</div>\n</header>\n<main aria-labelledby=\"studio-signin-title\" class=\"relative flex flex-1 items-center justify-center py-11\" data-kid=\"1-3\" data-name=\"main content area\">\n<section class=\"signin-plane relative w-[520px] max-w-full overflow-hidden rounded-[30px] px-11 pt-10 pb-8\" data-kid=\"1-3-1\" data-name=\"sign-in card panel\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-x-12 top-0 h-px bg-[linear-gradient(90deg,transparent,#f0dfae88,transparent)]\" data-kid=\"1-3-1-1\" data-name=\"card top highlight line\"></div>\n<div aria-hidden=\"true\" class=\"mb-6 flex size-[55px] items-center justify-center rounded-[18px] border border-[#e4cf91]/20 bg-[#d4af37]/7 text-[24px] text-[#e6ce8c] shadow-[inset_0_1px_1px_#ffffff20]\" data-kid=\"1-3-1-2\" data-name=\"card icon badge\">\n<i class=\"icon-sliders-horizontal inline-block size-[25px]\" data-kid=\"1-3-1-2-1\" data-name=\"sliders icon\"></i>\n</div>\n<h1 class=\"display text-[46px] font-medium leading-[.98] tracking-[-.7px]\" data-kid=\"1-3-1-3\" data-name=\"sign-in headline\" id=\"studio-signin-title\">Sign in to<br data-kid=\"1-3-1-3-1\" data-name=\"line break\"/>YT Media Studio</h1>\n<p class=\"mt-5 text-[14px] leading-[1.8] text-[#d1cdc3]\" data-kid=\"1-3-1-4\" data-name=\"subtitle text\">Studio access is separate from the viewer vault.</p>\n<form aria-label=\"Administrator sign-in\" class=\"mt-8\" data-kid=\"1-3-1-5\" data-name=\"sign-in form\" onsubmit=\"event.preventDefault()\">\n<div data-kid=\"1-3-1-5-1\" data-name=\"email input field group\">\n<label class=\"mb-2.5 block text-[14px] font-semibold text-[#e8e4da]\" data-kid=\"1-3-1-5-1-1\" data-name=\"email field label\" for=\"studio-email\">Email</label>\n<div class=\"relative\" data-kid=\"1-3-1-5-1-2\" data-name=\"email input wrapper with icon\">\n<span aria-hidden=\"true\" class=\"pointer-events-none absolute left-4 top-4 text-[20px] text-[#b8b3a8]\" data-kid=\"1-3-1-5-1-2-1\" data-name=\"email field icon holder\"><i class=\"icon-mail inline-block size-5\" data-kid=\"1-3-1-5-1-2-1-1\" data-name=\"email mail icon\"></i></span>\n<input aria-label=\"Email\" autocomplete=\"username\" class=\"field-well h-[54px] w-full rounded-[18px] pr-4 pl-12 text-[15px] text-[#f5f3ea] outline-hidden\" data-kid=\"1-3-1-5-1-2-2\" data-name=\"email input field\" id=\"studio-email\" name=\"email\" spellcheck=\"false\" type=\"email\"/>\n</div>\n</div>\n<div class=\"mt-6\" data-kid=\"1-3-1-5-2\" data-name=\"password input field group\">\n<label class=\"mb-2.5 block text-[14px] font-semibold text-[#e8e4da]\" data-kid=\"1-3-1-5-2-1\" data-name=\"password field label\" for=\"studio-password\">Password</label>\n<div class=\"field-well relative flex h-[54px] items-center rounded-[18px]\" data-kid=\"1-3-1-5-2-2\" data-name=\"password field well wrapper\">\n<span aria-hidden=\"true\" class=\"pointer-events-none ml-4 flex shrink-0 text-[20px] text-[#b8b3a8]\" data-kid=\"1-3-1-5-2-2-1\" data-name=\"password field icon holder\"><i class=\"icon-lock-keyhole inline-block size-5\" data-kid=\"1-3-1-5-2-2-1-1\" data-name=\"lock keyhole icon\"></i></span>\n<input aria-label=\"Password\" autocomplete=\"current-password\" class=\"h-full min-w-0 flex-1 rounded-[18px] border-0 bg-transparent px-3 text-[15px] text-[#f5f3ea] outline-hidden\" data-kid=\"1-3-1-5-2-2-2\" data-name=\"password input field\" id=\"studio-password\" name=\"password\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"mr-0.5 flex size-12 shrink-0 items-center justify-center rounded-[16px] text-[21px] text-[#c8c2b6]\" data-kid=\"1-3-1-5-2-2-3\" data-name=\"show password toggle button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-eye inline-block size-[21px]\" data-kid=\"1-3-1-5-2-2-3-1\" data-name=\"eye icon\"></i></button>\n</div>\n</div>\n<button class=\"mt-8 flex h-[54px] w-full items-center justify-center gap-3 rounded-[18px] bg-[#e4cf91] text-[14px] font-bold text-[#211d12] shadow-[inset_0_1px_1px_#ffffff80]\" data-kid=\"1-3-1-5-3\" data-name=\"sign-in call-to-action button\" type=\"button\">Sign in to Studio <span aria-hidden=\"true\" class=\"text-[18px]\" data-kid=\"1-3-1-5-3-1\" data-name=\"forward arrow icon holder\"><i class=\"icon-arrow-right inline-block size-[18px]\" data-kid=\"1-3-1-5-3-1-1\" data-name=\"arrow right icon\"></i></span></button>\n<button class=\"mx-auto mt-5 flex h-12 items-center justify-center gap-2.5 rounded-[16px] px-5 text-[14px] text-[#d7d0c1]\" data-kid=\"1-3-1-5-4\" data-name=\"return to main site button\" type=\"button\"><span aria-hidden=\"true\" class=\"text-[17px]\" data-kid=\"1-3-1-5-4-1\" data-name=\"backward arrow icon holder\"><i class=\"icon-arrow-left inline-block size-[17px]\" data-kid=\"1-3-1-5-4-1-1\" data-name=\"arrow left icon\"></i></span>Return to YT Media</button>\n</form>\n</section>\n</main>\n<footer class=\"relative mx-auto w-full max-w-[1360px] border-t border-white/10 pt-6 pb-1 text-center text-[13px] leading-6 text-[#cec7b8]\" data-kid=\"1-4\" data-name=\"site footer credit bar\">YT Media • Powered by Vorex Agency | Built by Dhiraj Kondalwar</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\nif (typeof gsap !== 'undefined') {\n  gsap.to('.signin-orb-gold', {x:40,y:24,duration:18,repeat:-1,yoyo:true,ease:'sine.inOut'});\n  gsap.to('.signin-orb-crimson', {x:-35,y:36,duration:21,repeat:-1,yoyo:true,ease:'sine.inOut'});\n  gsap.to('.signin-orb-indigo', {x:-24,y:-35,duration:24,repeat:-1,yoyo:true,ease:'sine.inOut'});\n  gsap.to('.signin-orb-cyan', {x:-30,y:16,duration:20,repeat:-1,yoyo:true,ease:'sine.inOut'});\n}\n</script>",
