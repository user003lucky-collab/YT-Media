1-4-1-2-3-1\" data-name=\"pause icon\"></i></button><button aria-label=\"Next track\" data-kid=\"1-4-1-2-4\" data-name=\"next track button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-skip-forward\" data-kid=\"1-4-1-2-4-1\" data-name=\"skip-forward icon\"></i></button><button aria-label=\"Repeat\" class=\"text-[16px] text-[#9c97a8]\" data-kid=\"1-4-1-2-5\" data-name=\"repeat button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-repeat\" data-kid=\"1-4-1-2-5-1\" data-name=\"repeat icon\"></i></button></div>\n<div class=\"min-w-0 pt-1\" data-kid=\"1-4-1-3\" data-name=\"player progress / waveform area\"><svg aria-label=\"Audio waveform\" class=\"waveform h-[29px] w-full\" data-dynamic=\"true\" data-kid=\"1-4-1-3-1\" data-name=\"audio waveform SVG (progress indicator)\" data-reason=\"clip-path rect width driving waveform fill is updated by playback/seek script\" preserveaspectratio=\"none\" role=\"img\" viewbox=\"0 0 400 30\"><defs><clippath id=\"wave-position\"><rect height=\"30\" width=\"155\"></rect></clippath></defs><path d=\"M2 12v6 M8 10v10 M14 8v14 M20 12v6 M26 5v20 M32 9v12 M38 2v26 M44 7v16 M50 10v10 M56 4v22 M62 11v8 M68 8v14 M74 3v24 M80 6v18 M86 11v8 M92 7v16 M98 4v22 M104 1v28 M110 6v18 M116 9v12 M122 4v22 M128 8v14 M134 11v8 M140 4v22 M146 7v16 M152 1v28 M158 5v20 M164 8v14 M170 3v24 M176 6v18 M182 9v12 M188 13v4 M194 11v8 M200 5v20 M206 7v16 M212 3v24 M218 8v14 M224 11v8 M230 5v20 M236 2v26 M242 8v14 M248 5v20 M254 9v12 M260 12v6 M266 7v16 M272 3v24 M278 6v18 M284 10v10 M290 6v18 M296 1v28 M302 4v22 M308 8v14 M314 3v24 M320 7v16 M326 11v8 M332 5v20 M338 8v14 M344 12v6 M350 9v12 M356 5v20 M362 8v14 M368 10v10 M374 6v18 M380 11v8 M386 9v12 M392 12v6 M398 13v4\" id=\"audio-wave\" stroke=\"#57545f\" stroke-linecap=\"round\" stroke-width=\"2\"></path><use clip-path=\"url(#wave-position)\" href=\"#audio-wave\" stroke=\"#65d8e2\"></use></svg><div class=\"mt-1.5 flex items-center gap-3 text-[12px] text-[#bbb6c2]\" data-kid=\"1-4-1-3-2\" data-name=\"progress time / seek row\"><span data-dynamic=\"true\" data-kid=\"1-4-1-3-2-1\" data-name=\"current time label (1:46)\" data-reason=\"current time text is rewritten by playback script\">1:46</span><input aria-label=\"Seek in Blue hour\" class=\"range min-w-0 flex-1\" data-dynamic=\"true\" data-kid=\"1-4-1-3-2-2\" data-name=\"seek range slider\" data-reason=\"range value is rewired to keep current playback position\" max=\"272\" min=\"0\" type=\"range\" value=\"106\"/><span data-kid=\"1-4-1-3-2-3\" data-name=\"total duration label (4:32)\">4:32</span></div></div>\n<div class=\"flex items-center justify-end gap-3\" data-kid=\"1-4-1-4\" data-name=\"player right-side controls (volume + queue)\"><span class=\"text-[20px] text-[#d8d2dd]\" data-kid=\"1-4-1-4-1\" data-name=\"volume icon wrapper\"><i aria-hidden=\"true\" class=\"icon-volume-2\" data-kid=\"1-4-1-4-1-1\" data-name=\"volume-2 icon\"></i></span><input aria-label=\"Volume\" class=\"range w-[78px]\" data-dynamic=\"true\" data-kid=\"1-4-1-4-2\" data-name=\"volume range slider\" data-reason=\"volume value is synchronized with audio element state\" max=\"100\" min=\"0\" type=\"range\" value=\"65\"/><span class=\"mx-1 h-6 w-px bg-white/10\" data-kid=\"1-4-1-4-3\" data-name=\"divider between volume and queue\"></span><button aria-label=\"Open play queue\" class=\"text-[20px] text-[#aaa6b2]\" data-kid=\"1-4-1-4-4\" data-name=\"open play queue button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-list-music\" data-kid=\"1-4-1-4-4-1\" data-name=\"list-music icon (queue)\"></i></button></div>\n</section>\n</div>\n</div>",
