      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Cardo:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  body { background-color: #040407; }\n  .collection-app { font-family: 'Barlow', sans-serif; color: #f5f3ea; background: #040407; }\n  .collection-app .display { font-family: 'Cardo', serif; }\n  .collection-app .glass {\n    border: 1px solid transparent;\n    background: linear-gradient(#ffffff0a,#ffffff0a) padding-box, linear-gradient(125deg,#9a747a55,#ffffff15 35%,#8fc6ce45 100%) border-box;\n    backdrop-filter: blur(30px) saturate(200%);\n    -webkit-backdrop-filter: blur(30px) saturate(200%);\n    box-shadow: inset 0 1px 1px #ffffff25;\n  }\n  .collection-app .caption-glass {\n    background: linear-gradient(120deg,#17171bdf,#0b0c10e8);\n    backdrop-filter: blur(30px) saturate(200%);\n    -webkit-backdrop-filter: blur(30px) saturate(200%);\n    box-shadow: inset 0 1px 0 #ffffff26;\n  }\n  .collection-app .player-glass {\n    background: linear-gradient(125deg,#252528eb,#15161bed) padding-box,linear-gradient(115deg,#a0878955,#ffffff30,#7eafb455) border-box;\n    border: 1px solid transparent;\n    backdrop-filter: blur(30px) saturate(200%);\n    -webkit-backdrop-filter: blur(30px) saturate(200%);\n    box-shadow: inset 0 1px 1px #ffffff26;\n  }\n  .collection-app .shelf { scrollbar-width: none; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; }\n  .collection-app .shelf::-webkit-scrollbar, .collection-app .page-scroll::-webkit-scrollbar { display: none; }\n  .collection-app .page-scroll { scrollbar-width: none; }\n  .collection-app button { cursor: pointer; }\n  .collection-app button:focus-visible, .collection-app [tabindex]:focus-visible { outline: 2px solid #06b6d4; outline-offset: 3px; }\n  .collection-app .vinyl { background: repeating-radial-gradient(circle at center,#1e1e22 0 1px,#0a0b0d 2px 3px); animation: record-turn 18s linear infinite; }\n  .collection-app .aurora { animation: aurora-drift 24s ease-in-out infinite alternate; pointer-events: none; }\n  @keyframes record-turn { to { transform: rotate(360deg); } }\n  @keyframes aurora-drift { to { transform: translate3d(16px,24px,0); } }\n  @media (prefers-reduced-motion: reduce) { .collection-app .vinyl, .collection-app .aurora { animation: none; } }\n</style>\n<div class=\"collection-app relative isolate mx-auto flex h-[1000px] w-full max-w-[480px] flex-col overflow-x-clip\" data-kid=\"1\" data-name=\"app layout root container\" data-node-id=\"var_0dd78dacb4b0\">\n<div aria-hidden=\"true\" class=\"aurora absolute -left-24 top-8 -z-10 h-64 w-64 rounded-full bg-[#ff0033]/12 blur-[70px]\" data-kid=\"1-1\" data-name=\"decorative red aurora glow orb\"></div>\n<div aria-hidden=\"true\" class=\"aurora absolute -right-20 top-32 -z-10 h-56 w-56 rounded-full bg-[#d4af37]/10 blur-[70px] [animation-delay:-9s]\" data-kid=\"1-2\" data-name=\"decorative gold aurora glow orb\"></div>\n<div aria-hidden=\"true\" class=\"aurora absolute -left-28 top-[430px] -z-10 h-72 w-72 rounded-full bg-[#4f46e5]/14 blur-[80px] [animation-delay:-14s]\" data-kid=\"1-3\" data-name=\"decorative indigo aurora glow orb\"></div>\n<div aria-hidden=\"true\" class=\"aurora absolute -right-24 bottom-8 -z-10 h-64 w-64 rounded-full bg-[#06b6d4]/12 blur-[75px] [animation-delay:-5s]\" data-kid=\"1-4\" data-name=\"decorative cyan aurora glow orb\"></div>\n<header class=\"glass relative z-10 shrink-0 rounded-b-xl px-4 pb-2 pt-4\" data-kid=\"1-5\" data-name=\"glass site header\">\n<p class=\"max-w-[350px] text-[13px] leading-[19px] text-[#d8d5cc]\" data-kid=\"1-5-1\" data-name=\"header brand and credits text\">\n<span class=\"display text-[24px] leading-7 text-[#f5f3ea]\" data-kid=\"1-5-1-1\" data-name=\"brand name text\">YT Media</span><span class=\"text-[#d4af37]\" data-kid=\"1-5-1-2\" data-name=\"agency credit text\"> • Powered by Vorex Agency</span><span class=\"block\" data-kid=\"1-5-1-3\" data-name=\"builder credit text\">| Built by Dhiraj Kondalwar</span>\n</p>\n<div aria-label=\"Utilities\" class=\"mt-2 flex items-center justify-between gap-1\" data-kid=\"1-5-2\" data-name=\"header utilities button row\">\n<button aria-label=\"Search\" class=\"flex min-h-12 min-w-12 items-center gap-2 rounded-lg pr-2 text-[14px] active:bg-white/10\" data-kid=\"1-5-2-1\" data-name=\"search action button\" type=\"button\"><span class=\"text-[19px]\" data-kid=\"1-5-2-1-1\" data-name=\"search icon wrapper\"><i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-5-2-1-1-1\" data-name=\"search magnifier icon\"></i></span>Search</button>\n<button class=\"flex min-h-12 min-w-12 items-center gap-2 rounded-lg px-2 text-[14px] active:bg-white/10\" data-kid=\"1-5-2-2\" data-name=\"admin studio action button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-5-2-2-1\" data-name=\"sliders icon wrapper\"><i aria-hidden=\"true\" class=\"icon-sliders-horizontal\" data-kid=\"1-5-2-2-1-1\" data-name=\"sliders horizontal icon\"></i></span>Admin Studio</button>\n<button class=\"flex min-h-12 min-w-12 items-center gap-2 rounded-lg pl-2 text-[14px] active:bg-white/10\" data-kid=\"1-5-2-3\" data-name=\"lock vault action button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-5-2-3-1\" data-name=\"lock icon wrapper\"><i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-5-2-3-1-1\" data-name=\"lock keyhole icon\"></i></span>Lock Vault</button>\n</div>\n</header>\n<main aria-label=\"Home collection\" class=\"page-scroll relative min-h-0 flex-1 overflow-y-auto overflow-x-clip pb-[190px] pt-4\" data-kid=\"1-6\" data-name=\"main scrolling content area\">\n<section aria-labelledby=\"featured-title\" class=\"relative mx-4 h-[340px] overflow-hidden rounded-xl border border-[#8d8980]/35\" data-kid=\"1-6-1\" data-name=\"featured hero section with background photo\">\n<img alt=\"Concrete architecture and its reflection in still water at night. Photograph by Vatsal Patel on Unsplash.\" class=\"absolute inset-0 h-full w-full object-cover object-[50%_40%]\" data-kid=\"1-6-1-1\" data-name=\"featured hero background photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1606199413707-f3fb23570068?auto=format&amp;w=900&amp;q=85&amp;fit=crop\"/>\n<div aria-hidden=\"true\" class=\"absolute inset-0 bg-[linear-gradient(180deg,transparent_12%,#04040788_38%,#040407f5_100%)]\" data-kid=\"1-6-1-2\" data-name=\"hero bottom gradient scrim\"></div>\n<div class=\"absolute inset-x-0 bottom-0 px-5 pb-4 pt-7\" data-kid=\"1-6-1-3\" data-name=\"hero caption overlay container\">\n<h1 class=\"display text-[31px] leading-[1.12] tracking-[-0.7px]\" data-kid=\"1-6-1-3-1\" data-name=\"hero headline title\" id=\"featured-title\">Stillness, after dark</h1>\n<p class=\"mt-2 flex items-center gap-2 text-[13px] text-[#e0ddd3]\" data-kid=\"1-6-1-3-2\" data-name=\"featured category label row\"><span class=\"h-1.5 w-1.5 rounded-full bg-[#d4af37]\" data-kid=\"1-6-1-3-2-1\" data-name=\"gold category bullet dot\"></span>Featured · Architecture</p>\n<p class=\"mt-1.5 max-w-[280px] text-[15px] leading-5 text-[#dddcd4]\" data-kid=\"1-6-1-3-3\" data-name=\"hero description text\">Concrete, warm light and a reflection held still.</p>\n<button class=\"mt-3 inline-flex min-h-12 items-center gap-2.5 rounded-lg border border-[#a3e6ed]/40 bg-[#06b6d4] px-4 text-[15px] font-semibold text-[#031419] shadow-[inset_0_1px_0_#ffffff65] active:scale-95\" data-kid=\"1-6-1-3-4\" data-name=\"play featured call-to-action button\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-6-1-3-4-1\" data-name=\"play icon wrapper\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-6-1-3-4-1-1\" data-name=\"play triangle icon\"></i></span>Play Featured</button>\n<p class=\"mt-2.5 text-[12px] leading-4 text-[#d0ccc1]\" data-kid=\"1-6-1-3-5\" data-name=\"photo credit text\">Photo: Vatsal Patel / Unsplash</p>\n</div>\n</section>\n<section aria-labelledby=\"posts-heading\" class=\"mt-7\" data-kid=\"1-6-2\" data-name=\"featured posts section\">\n<div class=\"mb-3 flex items-center justify-between gap-3 px-4\" data-kid=\"1-6-2-1\" data-name=\"section header with count\">\n<h2 class=\"display text-[25px] leading-8\" data-kid=\"1-6-2-1-1\" data-name=\"section heading text\" id=\"posts-heading\">Featured Posts</h2>\n<span class=\"flex items-center gap-2 text-[13px] text-[#c0beb6]\" data-kid=\"1-6-2-1-2\" data-name=\"item count label with arrow\">2 photos <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-6-2-1-2-1\" data-name=\"right arrow icon\"></i></span>\n</div>\n<div aria-label=\"Featured Posts, swipe for more\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-6-2-2\" data-name=\"horizontal scrolling posts shelf\" tabindex=\"0\">\n<article class=\"glass w-[310px] max-w-[86%] shrink-0 snap-start overflow-hidden rounded-xl\" data-kid=\"1-6-2-2-1\" data-name=\"featured photo card\">\n<button aria-label=\"Open image: A circle of light\" class=\"relative block h-[232px] w-full text-left\" data-kid=\"1-6-2-2-1-1\" data-name=\"open image card button\" type=\"button\">\n<img alt=\"Warm gold light inside a circular stairwell. Photograph by Andrea G on Unsplash.\" class=\"h-full w-full object-cover object-[50%_48%]\" data-kid=\"1-6-2-2-1-1-1\" data-name=\"photo card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1609862776077-ef7dbd3fb464?auto=format&amp;w=660&amp;q=85&amp;fit=crop\"/>\n<span class=\"caption-glass absolute bottom-3 right-3 flex h-12 w-12 items-center justify-center rounded-lg text-[20px]\" data-kid=\"1-6-2-2-1-1-2\" data-name=\"expand overlay button\"><i aria-hidden=\"true\" class=\"icon-expand\" data-kid=\"1-6-2-2-1-1-2-1\" data-name=\"expand arrows icon\"></i></span>\n</button>\n<div class=\"caption-glass px-4 py-3.5\" data-kid=\"1-6-2-2-1-2\" data-name=\"photo card caption block\">\n<div class=\"flex items-start justify-between gap-2\" data-kid=\"1-6-2-2-1-2-1\" data-name=\"caption title and pin row\"><h3 class=\"text-[18px] font-medium leading-6\" data-kid=\"1-6-2-2-1-2-1-1\" data-name=\"photo card title text\">A circle of light</h3><span class=\"pt-1 text-[17px] text-[#d4af37]\" data-kid=\"1-6-2-2-1-2-1-2\" data-name=\"featured pin indicator\" title=\"Featured\"><i aria-hidden=\"true\" class=\"icon-pin\" data-kid=\"1-6-2-2-1-2-1-2-1\" data-name=\"push pin icon\"></i></span></div>\n<p class=\"mt-1 text-[14px] leading-5 text-[#d2d0c7]\" data-kid=\"1-6-2-2-1-2-2\" data-name=\"photo card description text\">Looking up through a gold-lit stairwell.</p>\n<p class=\"mt-2 text-[13px] leading-[18px] text-[#b7b5ac]\" data-kid=\"1-6-2-2-1-2-3\" data-name=\"photo card credit text\">Photography by Andrea G / Unsplash</p>\n</div>\n</article>\n<article class=\"glass w-[310px] max-w-[86%] shrink-0 snap-start overflow-hidden rounded-xl\" data-kid=\"1-6-2-2-2\" data-name=\"featured photo card\">\n<button aria-label=\"Open image: Beside the water\" class=\"relative block h-[232px] w-full text-left\" data-kid=\"1-6-2-2-2-1\" data-name=\"open image card button\" type=\"button\">\n<img alt=\"Illuminated buildings reflected in city water at night. Photograph by Daesun Kim on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-6-2-2-2-1-1\" data-name=\"photo card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1671959670640-bd1ea822a635?auto=format&amp;w=660&amp;q=85&amp;fit=crop\"/>\n<span class=\"caption-glass absolute bottom-3 right-3 flex h-12 w-12 items-center justify-center rounded-lg text-[20px]\" data-kid=\"1-6-2-2-2-1-2\" data-name=\"expand overlay button\"><i aria-hidden=\"true\" class=\"icon-expand\" data-kid=\"1-6-2-2-2-1-2-1\" data-name=\"expand arrows icon\"></i></span>\n</button>\n<div class=\"caption-glass px-4 py-3.5\" data-kid=\"1-6-2-2-2-2\" data-name=\"photo card caption block\"><h3 class=\"text-[18px] font-medium leading-6\" data-kid=\"1-6-2-2-2-2-1\" data-name=\"photo card title text\">Beside the water</h3><p class=\"mt-1 text-[14px] leading-5 text-[#d2d0c7]\" data-kid=\"1-6-2-2-2-2-2\" data-name=\"photo card description text\">City light traced across the surface.</p><p class=\"mt-2 text-[13px] leading-[18px] text-[#b7b5ac]\" data-kid=\"1-6-2-2-2-2-3\" data-name=\"photo card credit text\">Photography by Daesun Kim / Unsplash</p></div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"music-heading\" class=\"mt-7\" data-kid=\"1-6-3\" data-name=\"quick-play music section\">\n<div class=\"mb-3 flex items-center justify-between gap-2 px-4\" data-kid=\"1-6-3-1\" data-name=\"section header with count\"><h2 class=\"display text-[24px] leading-8\" data-kid=\"1-6-3-1-1\" data-name=\"section heading text\" id=\"music-heading\">Quick-Play Music Tracks</h2><span class=\"shrink-0 text-[13px] text-[#c0beb6]\" data-kid=\"1-6-3-1-2\" data-name=\"item count label with arrow\">3 tracks <i aria-hidden=\"true\" class=\"icon-arrow-right ml-1\" data-kid=\"1-6-3-1-2-1\" data-name=\"right arrow icon\"></i></span></div>\n<div aria-label=\"Music tracks, swipe for more\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-6-3-2\" data-name=\"horizontal scrolling music shelf\" tabindex=\"0\">\n<article class=\"w-[164px] shrink-0 snap-start\" data-kid=\"1-6-3-2-1\" data-name=\"music track card\">\n<button aria-label=\"Pause Blue hour\" class=\"glass relative block aspect-square w-full overflow-hidden rounded-lg\" data-kid=\"1-6-3-2-1-1\" data-name=\"album art play/pause button\" type=\"button\">\n<img alt=\"Folded brushed metal with cyan reflections, Blue hour cover. Photograph by Andrei Castanha on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-6-3-2-1-1-1\" data-name=\"album cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1704158853042-105006b01cf0?auto=format&amp;w=400&amp;q=85&amp;fit=crop\"/>\n<span class=\"absolute bottom-2.5 right-2.5 flex h-12 w-12 items-center justify-center rounded-full bg-[#06b6d4] text-[20px] text-[#041317] shadow-[inset_0_1px_0_#ffffff70]\" data-kid=\"1-6-3-2-1-1-2\" data-name=\"album play/pause control\"><i aria-hidden=\"true\" class=\"icon-pause\" data-kid=\"1-6-3-2-1-1-2-1\" data-name=\"pause icon\"></i></span>\n</button>\n<h3 class=\"mt-2 text-[17px] font-medium\" data-kid=\"1-6-3-2-1-2\" data-name=\"track title text\">Blue hour</h3><p class=\"text-[14px] text-[#c4c1b7]\" data-kid=\"1-6-3-2-1-3\" data-name=\"track genre and duration text\">Ambient · 4:36</p><p class=\"mt-1.5 text-[12px] leading-4 text-[#aaa89f]\" data-kid=\"1-6-3-2-1-4\" data-name=\"cover credit text\">Cover: Andrei Castanha / Unsplash</p>\n</article>\n<article class=\"w-[164px] shrink-0 snap-start\" data-kid=\"1-6-3-2-2\" data-name=\"music track card\">\n<button aria-label=\"Play Still water\" class=\"glass relative block aspect-square w-full overflow-hidden rounded-lg\" data-kid=\"1-6-3-2-2-1\" data-name=\"album art play/pause button\" type=\"button\">\n<img alt=\"Concrete building beside still water, Still water cover. Photograph by Vatsal Patel on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-6-3-2-2-1-1\" data-name=\"album cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1606199413707-f3fb23570068?auto=format&amp;w=400&amp;q=80&amp;fit=crop\"/>\n<span class=\"player-glass absolute bottom-2.5 right-2.5 flex h-12 w-12 items-center justify-center rounded-full text-[20px]\" data-kid=\"1-6-3-2-2-1-2\" data-name=\"album play control\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-6-3-2-2-1-2-1\" data-name=\"play triangle icon\"></i></span>\n</button>\n<h3 class=\"mt-2 text-[17px] font-medium\" data-kid=\"1-6-3-2-2-2\" data-name=\"track title text\">Still water</h3><p class=\"text-[14px] text-[#c4c1b7]\" data-kid=\"1-6-3-2-2-3\" data-name=\"track genre and duration text\">Piano · 3:28</p><p class=\"mt-1.5 text-[12px] leading-4 text-[#aaa89f]\" data-kid=\"1-6-3-2-2-4\" data-name=\"cover credit text\">Cover: Vatsal Patel / Unsplash</p>\n</article>\n<article class=\"w-[164px] shrink-0 snap-start\" data-kid=\"1-6-3-2-3\" data-name=\"music track card\">\n<button aria-label=\"Play Amber room\" class=\"glass relative block aspect-square w-full overflow-hidden rounded-lg\" data-kid=\"1-6-3-2-3-1\" data-name=\"album art play/pause button\" type=\"button\">\n<img alt=\"Golden circular stairwell, Amber room cover. Photograph by Andrea G on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-6-3-2-3-1-1\" data-name=\"album cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1609862776077-ef7dbd3fb464?auto=format&amp;w=400&amp;q=80&amp;fit=crop\"/>\n<span class=\"player-glass absolute bottom-2.5 right-2.5 flex h-12 w-12 items-center justify-center rounded-full text-[20px]\" data-kid=\"1-6-3-2-3-1-2\" data-name=\"album play control\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-6-3-2-3-1-2-1\" data-name=\"play triangle icon\"></i></span>\n</button>\n<h3 class=\"mt-2 text-[17px] font-medium\" data-kid=\"1-6-3-2-3-2\" data-name=\"track title text\">Amber room</h3><p class=\"text-[14px] text-[#c4c1b7]\" data-kid=\"1-6-3-2-3-3\" data-name=\"track genre and duration text\">Electronic · 5:12</p><p class=\"mt-1.5 text-[12px] leading-4 text-[#aaa89f]\" data-kid=\"1-6-3-2-3-4\" data-name=\"cover credit text\">Cover: Andrea G / Unsplash</p>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"videos-heading\" class=\"mt-8\" data-kid=\"1-6-4\" data-name=\"trending videos section\">\n<div class=\"mb-3 flex items-center justify-between px-4\" data-kid=\"1-6-4-1\" data-name=\"section header with count\"><h2 class=\"display text-[25px] leading-8\" data-kid=\"1-6-4-1-1\" data-name=\"section heading text\" id=\"videos-heading\">Trending Videos</h2><span class=\"text-[13px] text-[#c0beb6]\" data-kid=\"1-6-4-1-2\" data-name=\"item count label with arrow\">2 videos <i aria-hidden=\"true\" class=\"icon-arrow-right ml-1\" data-kid=\"1-6-4-1-2-1\" data-name=\"right arrow icon\"></i></span></div>\n<div aria-label=\"Trending Videos, swipe for more\" class=\"shelf flex gap-3 overflow-x-auto px-4 pb-1\" data-kid=\"1-6-4-2\" data-name=\"horizontal scrolling videos shelf\" tabindex=\"0\">\n<article class=\"w-[302px] max-w-[85%] shrink-0 snap-start\" data-kid=\"1-6-4-2-1\" data-name=\"video card\">\n<button aria-label=\"Play After the city quiets\" class=\"glass relative block aspect-video w-full overflow-hidden rounded-xl\" data-kid=\"1-6-4-2-1-1\" data-name=\"video preview play button\" type=\"button\">\n<img alt=\"A waterfront city at night. Photograph by Daesun Kim on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-6-4-2-1-1-1\" data-name=\"video preview thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1671959670640-bd1ea822a635?auto=format&amp;w=640&amp;q=85&amp;fit=crop\"/>\n<span class=\"absolute inset-0 bg-black/15\" data-kid=\"1-6-4-2-1-1-2\" data-name=\"video thumbnail darkening overlay\"></span><span class=\"player-glass absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-[20px]\" data-kid=\"1-6-4-2-1-1-3\" data-name=\"centered play button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-6-4-2-1-1-3-1\" data-name=\"play triangle icon\"></i></span>\n<span class=\"caption-glass absolute bottom-2 right-2 rounded px-1.5 py-0.5 text-[12px]\" data-kid=\"1-6-4-2-1-1-4\" data-name=\"video duration badge\">6:42</span>\n</button>\n<h3 class=\"mt-2 text-[18px] font-medium leading-6\" data-kid=\"1-6-4-2-1-2\" data-name=\"video title text\">After the city quiets</h3><p class=\"mt-0.5 text-[14px] text-[#c4c1b7]\" data-kid=\"1-6-4-2-1-3\" data-name=\"video category text\">Architecture · Night film</p><p class=\"mt-1 text-[13px] leading-[18px] text-[#aaa89f]\" data-kid=\"1-6-4-2-1-4\" data-name=\"video preview credit text\">Preview photo: Daesun Kim / Unsplash</p>\n</article>\n<article class=\"w-[302px] max-w-[85%] shrink-0 snap-start\" data-kid=\"1-6-4-2-2\" data-name=\"video card\">\n<button aria-label=\"Play Light on concrete\" class=\"glass relative block aspect-video w-full overflow-hidden rounded-xl\" data-kid=\"1-6-4-2-2-1\" data-name=\"video preview play button\" type=\"button\">\n<img alt=\"Monumental concrete building reflected in water. Photograph by Vatsal Patel on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-6-4-2-2-1-1\" data-name=\"video preview thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1606199413707-f3fb23570068?auto=format&amp;w=640&amp;q=85&amp;fit=crop\"/>\n<span class=\"player-glass absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-[20px]\" data-kid=\"1-6-4-2-2-1-2\" data-name=\"centered play button\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-6-4-2-2-1-2-1\" data-name=\"play triangle icon\"></i></span><span class=\"caption-glass absolute bottom-2 right-2 rounded px-1.5 py-0.5 text-[12px]\" data-kid=\"1-6-4-2-2-1-3\" data-name=\"video duration badge\">4:18</span>\n</button>\n<h3 class=\"mt-2 text-[18px] font-medium leading-6\" data-kid=\"1-6-4-2-2-2\" data-name=\"video title text\">Light on concrete</h3><p class=\"mt-0.5 text-[14px] text-[#c4c1b7]\" data-kid=\"1-6-4-2-2-3\" data-name=\"video category text\">Architecture · Short film</p><p class=\"mt-1 text-[13px] leading-[18px] text-[#aaa89f]\" data-kid=\"1-6-4-2-2-4\" data-name=\"video preview credit text\">Preview photo: Vatsal Patel / Unsplash</p>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"shorts-heading\" class=\"mt-8\" data-kid=\"1-6-5\" data-name=\"latest shorts section\">\n<div class=\"mb-3 flex items-center justify-between gap-2 px-4\" data-kid=\"1-6-5-1\" data-name=\"section header with cou