      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Cardo:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.media-app{font-family:'Barlow',sans-serif;background:#040407;color:#f5f3ea;color-scheme:dark}.display{font-family:'Cardo',serif}.glass{background:rgba(255,255,255,.04);backdrop-filter:blur(30px) saturate(200%);border:1px solid transparent;background-clip:padding-box;box-shadow:inset 0 1px 1px rgba(255,255,255,.25),inset 0 -1px 1px rgba(6,182,212,.1)}.rim{position:relative}.rim:before{content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;background:linear-gradient(120deg,rgba(255,255,255,.22),rgba(255,0,51,.08) 30%,rgba(255,255,255,.04) 65%,rgba(6,182,212,.22));mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask-composite:exclude;pointer-events:none}.collection-scroll{scrollbar-width:thin;scrollbar-color:#35383b transparent;scroll-behavior:smooth}.vinyl{background:repeating-radial-gradient(circle at center,#111316 0px,#242629 1px,#111316 2px,#0b0d10 4px);box-shadow:inset 0 0 0 1px #55585b,0 5px 12px #02030680;animation:vinyl-turn 24s linear infinite}.vinyl:after{content:'';position:absolute;inset:0;border-radius:50%;background:conic-gradient(transparent 0deg,rgba(255,255,255,.13) 45deg,transparent 75deg,transparent 180deg,rgba(255,255,255,.1) 240deg,transparent 280deg)}.waveform path{animation:wave-breathe 3s ease-in-out infinite;transform-origin:center}.range{height:3px;accent-color:#43cee0;cursor:pointer}.media-app button{cursor:pointer}.media-app button:focus-visible,.media-app input:focus-visible{outline:2px solid #64dce9;outline-offset:4px}.media-app button{transition:background-color .2s,color .2s}.media-app button:hover{color:#fff}.orb{filter:blur(80px);border-radius:50%;pointer-events:none;animation:orb-drift 22s ease-in-out infinite alternate}@keyframes vinyl-turn{to{transform:rotate(360deg)}}@keyframes wave-breathe{50%{opacity:.65;transform:scaleY(.9)}}@keyframes orb-drift{to{transform:translate(20px,28px)}}@media(prefers-reduced-motion:reduce){.vinyl,.orb,.waveform path{animation:none}.collection-scroll{scroll-behavior:auto}}\n</style>\n<div class=\"media-app relative isolate grid h-[1080px] w-full grid-rows-[94px_minmax(0,1fr)_122px] overflow-clip\" data-kid=\"1\" data-name=\"page layout grid container\">\n<div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 -z-10 overflow-hidden\" data-kid=\"1-1\" data-name=\"decorative background layer (aria-hidden)\">\n<div class=\"orb absolute -left-32 top-32 h-[390px] w-[390px] bg-[#ff0033]/5\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"decorative floating color orb (true/false)1\" data-reason=\"false\"></div>\n<div class=\"orb absolute -right-24 top-[270px] h-[450px] w-[450px] bg-[#06b6d4]/5\" data-kid=\"1-1-2\" data-name=\"cyan-tinted glass blur orb\"></div>\n<div class=\"orb absolute bottom-16 left-[32%] h-[360px] w-[360px] bg-[#4f46e5]/5\" data-kid=\"1-1-3\" data-name=\"indigo-tinted glass blur orb\"></div>\n<div class=\"orb absolute -bottom-28 left-2 h-[300px] w-[300px] bg-[#d4af37]/5\" data-kid=\"1-1-4\" data-name=\"gold-tinted glass blur orb\"></div>\n</div>\n<header class=\"flex min-w-0 items-center gap-5 px-5 py-4\" data-kid=\"1-2\" data-name=\"header bar\">\n<div class=\"glass rim flex h-[62px] shrink-0 items-center gap-3 rounded-xl px-4\" data-kid=\"1-2-1\" data-name=\"brand / logo panel\">\n<span class=\"relative flex size-9 items-center justify-center rounded-full border border-[#bdb7a2]/40 bg-white/5 text-[19px]\" data-kid=\"1-2-1-1\" data-name=\"brand circular emblem badge\"><i aria-hidden=\"true\" class=\"icon-aperture\" data-kid=\"1-2-1-1-1\" data-name=\"aperture icon (brand mark)\"></i></span>\n<div class=\"text-[13px] leading-[20px]\" data-kid=\"1-2-1-2\" data-name=\"brand text block\"><span class=\"text-[22px] font-semibold tracking-[-.7px]\" data-kid=\"1-2-1-2-1\" data-name='brand name \"YT Media\"'>YT Media</span><span class=\"ml-2 text-[#d2bb71]\" data-kid=\"1-2-1-2-2\" data-name=\"powered-by agency tagline\">• Powered by Vorex Agency</span><br data-kid=\"1-2-1-2-3\" data-name=\"line break\"/><span class=\"text-[#bcbab8]\" data-kid=\"1-2-1-2-4\" data-name=\"builder credit text\">| Built by Dhiraj Kondalwar</span></div>\n</div>\n<label class=\"glass rim flex h-12 min-w-[200px] flex-1 items-center gap-3 rounded-lg px-4 text-[18px] text-[#a9a9ad]\" data-kid=\"1-2-2\" data-name=\"search label / field container\">\n<i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-2-2-1\" data-name=\"search magnifier icon\"></i><input aria-label=\"Search your collection\" class=\"min-w-0 flex-1 bg-transparent text-[15px] text-[#f5f3ea] outline-hidden placeholder:text-[#a2a2a9]\" data-kid=\"1-2-2-2\" data-name=\"search input field\" placeholder=\"Search photographs, music, films…\" type=\"search\"/>\n</label>\n<button class=\"flex h-12 shrink-0 items-center gap-2.5 px-2 text-[15px] text-[#d2d0cf]\" data-kid=\"1-2-3\" data-name=\"Admin Studio toggle button\" type=\"button\"><span class=\"text-[19px]\" data-kid=\"1-2-3-1\" data-name=\"filter sliders icon wrapper\"><i aria-hidden=\"true\" class=\"icon-sliders-horizontal\" data-kid=\"1-2-3-1-1\" data-name=\"sliders-horizontal icon\"></i></span>Admin Studio</button>\n<button class=\"glass rim flex h-12 shrink-0 items-center gap-2.5 rounded-lg px-4 text-[15px]\" data-kid=\"1-2-4\" data-name=\"Lock Vault button\" type=\"button\"><span class=\"text-[18px]\" data-kid=\"1-2-4-1\" data-name=\"lock keyhole icon wrapper\"><i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-4-1-1\" data-name=\"lock-keyhole icon\"></i></span>Lock Vault</button>\n</header>\n<div class=\"grid min-h-0 grid-cols-[184px_minmax(0,1fr)] gap-6 pl-5 pr-3\" data-kid=\"1-3\" data-name=\"main content layout grid (sidebar + main)\">\n<aside class=\"pt-[17px]\" data-kid=\"1-3-1\" data-name=\"sidebar aside\">\n<div class=\"glass rim rounded-xl p-2.5\" data-kid=\"1-3-1-1\" data-name=\"collection sidebar card\">\n<div class=\"flex items-center justify-between px-3 pb-5 pt-3 text-[14px] text-[#b6b3b8]\" data-kid=\"1-3-1-1-1\" data-name=\"sidebar header row\"><span data-kid=\"1-3-1-1-1-1\" data-name=\"collection label heading\">Collection</span><button aria-label=\"Collapse sidebar\" class=\"text-[18px]\" data-kid=\"1-3-1-1-1-2\" data-name=\"collapse sidebar button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-panel-left-close\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"panel-left-close icon\"></i></button></div>\n<div class=\"space-y-1.5\" data-kid=\"1-3-1-1-2\" data-name=\"sidebar navigation list\">\n<button aria-current=\"page\" class=\"glass flex h-12 w-full items-center gap-3 rounded-lg px-3 text-[16px]\" data-kid=\"1-3-1-1-2-1\" data-name=\"Home nav item (active)\" type=\"button\"><span class=\"text-[20px]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"home icon wrapper\"><i aria-hidden=\"true\" class=\"icon-house\" data-kid=\"1-3-1-1-2-1-1-1\" data-name=\"house icon\"></i></span>Home<span class=\"ml-auto size-1.5 rounded-full bg-[#65d6df]\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"active-state indicator dot\"></span></button>\n<button class=\"flex h-12 w-full items-center gap-3 rounded-lg px-3 text-[16px] text-[#bcbac3] hover:bg-white/5\" data-kid=\"1-3-1-1-2-2\" data-name=\"Post nav item\" type=\"button\"><span class=\"text-[20px]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"image icon wrapper\"><i aria-hidden=\"true\" class=\"icon-image\" data-kid=\"1-3-1-1-2-2-1-1\" data-name=\"image icon\"></i></span>Post</button>\n<button class=\"flex h-12 w-full items-center gap-3 rounded-lg px-3 text-[16px] text-[#bcbac3] hover:bg-white/5\" data-kid=\"1-3-1-1-2-3\" data-name=\"Music nav item\" type=\"button\"><span class=\"text-[20px]\" data-kid=\"1-3-1-1-2-3-1\" data-name=\"disc icon wrapper\"><i aria-hidden=\"true\" class=\"icon-disc-3\" data-kid=\"1-3-1-1-2-3-1-1\" data-name=\"disc-3 icon (music)\"></i></span>Music</button>\n<button class=\"flex h-12 w-full items-center gap-3 rounded-lg px-3 text-[16px] text-[#bcbac3] hover:bg-white/5\" data-kid=\"1-3-1-1-2-4\" data-name=\"Videos nav item\" type=\"button\"><span class=\"text-[20px]\" data-kid=\"1-3-1-1-2-4-1\" data-name=\"clapperboard icon wrapper\"><i aria-hidden=\"true\" class=\"icon-clapperboard\" data-kid=\"1-3-1-1-2-4-1-1\" data-name=\"clapperboard icon (videos)\"></i></span>Videos</button>\n<button class=\"flex h-12 w-full items-center gap-3 rounded-lg px-3 text-[16px] text-[#bcbac3] hover:bg-white/5\" data-kid=\"1-3-1-1-2-5\" data-name=\"Shorts nav item\" type=\"button\"><span class=\"text-[20px]\" data-kid=\"1-3-1-1-2-5-1\" data-name=\"smartphone icon wrapper\"><i aria-hidden=\"true\" class=\"icon-smartphone\" data-kid=\"1-3-1-1-2-5-1-1\" data-name=\"smartphone icon (shorts)\"></i></span>Shorts</button>\n</div>\n<div class=\"mx-3 mb-2 mt-5 flex items-center gap-2 border-t border-white/10 pt-5 text-[13px] text-[#929099]\" data-kid=\"1-3-1-1-3\" data-name=\"private collection footer row\"><i aria-hidden=\"true\" class=\"icon-lock\" data-kid=\"1-3-1-1-3-1\" data-name=\"lock icon (private)\"></i>Private collection</div>\n</div>\n</aside>\n<main aria-label=\"Home collection\" class=\"collection-scroll min-h-0 overflow-y-auto pr-3 pb-5\" data-kid=\"1-3-2\" data-name=\"main content scroll area (Home collection)\">\n<div class=\"flex items-center justify-between pb-4 pt-3\" data-kid=\"1-3-2-1\" data-name=\"page header row (title + tagline)\"><h2 class=\"display text-[30px] leading-10\" data-kid=\"1-3-2-1-1\" data-name=\"Home page title\">Home</h2><p class=\"text-[15px] text-[#aaa8b0]\" data-kid=\"1-3-2-1-2\" data-name=\"page tagline description\">Photographs, films and music, collected.</p></div>\n<section aria-labelledby=\"featured-title\" class=\"glass rim relative isolate h-[360px] overflow-hidden rounded-xl\" data-kid=\"1-3-2-2\" data-name=\"featured film hero section\">\n<img alt=\"Concrete architecture reflected in still water at dusk. Photograph by Vatsal Patel on Unsplash.\" class=\"absolute inset-0 -z-20 h-full w-full object-cover object-[center_48%]\" data-kid=\"1-3-2-2-1\" data-name=\"hero background image (architecture at dusk)\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1606199413707-f3fb23570068?auto=format&amp;w=1600&amp;q=85&amp;fit=crop\"/>\n<div class=\"absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(4,4,7,.85)_0%,rgba(4,4,7,.43)_43%,rgba(4,4,7,.06)_78%),linear-gradient(0deg,rgba(4,4,7,.85)_0%,transparent_75%)]\" data-kid=\"1-3-2-2-2\" data-name=\"hero gradient overlays (dim left and bottom)\"></div>\n<div class=\"absolute inset-x-0 bottom-0 flex items-end justify-between gap-8 p-7\" data-kid=\"1-3-2-2-3\" data-name=\"hero bottom content row\">\n<div class=\"max-w-[550px]\" data-kid=\"1-3-2-2-3-1\" data-name=\"hero left content block\"><h1 class=\"display text-[57px] leading-[1.06] tracking-[-1.6px]\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3-1-1\" data-name='hero headline \"Stillness' data-reason=\"false\" id=\"featured-title\">Stillness, after dark</h1>\n<div class=\"mt-4 flex items-center gap-2 text-[14px] text-[#d6cfb8]\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"hero meta info row (genre / duration)\"><i aria-hidden=\"true\" class=\"icon-star text-[#d4af37]\" data-kid=\"1-3-2-2-3-1-2-1\" data-name=\"star icon (featured badge)\"></i><span data-kid=\"1-3-2-2-3-1-2-2\" data-name=\"Featured film label\">Featured film</span><span class=\"mx-1 text-[#8c8a88]\" data-kid=\"1-3-2-2-3-1-2-3\" data-name=\"separator dot\">·</span><span data-kid=\"1-3-2-2-3-1-2-4\" data-name=\"Architecture genre label\">Architecture</span><span class=\"mx-1 text-[#8c8a88]\" data-kid=\"1-3-2-2-3-1-2-5\" data-name=\"separator dot\">·</span><span data-kid=\"1-3-2-2-3-1-2-6\" data-name=\"duration label (6 min)\">6 min</span></div>\n<p class=\"mt-3 max-w-[400px] text-[17px] leading-[25px] text-[#cccbd0]\" data-kid=\"1-3-2-2-3-1-3\" data-name=\"hero description paragraph\">Concrete, quiet water and the last light.<br data-kid=\"1-3-2-2-3-1-3-1\" data-name=\"line break\"/>A study in architecture after everyone has left.</p>\n<button class=\"mt-6 inline-flex h-12 items-center gap-3 rounded-lg border border-[#8be2e9]/60 bg-[#9ce5e9] px-5 text-[15px] font-semibold text-[#082023] shadow-[0_3px_18px_#06b6d420] hover:bg-[#b2eff2]\" data-kid=\"1-3-2-2-3-1-4\" data-name=\"Play Featured CTA button\" type=\"button\"><span class=\"text-[17px]\" data-kid=\"1-3-2-2-3-1-4-1\" data-name=\"play icon wrapper\"><i aria-hidden=\"true\" class=\"icon-play\" data-kid=\"1-3-2-2-3-1-4-1-1\" data-name=\"play icon\"></i></span>Play Featured</button>\n</div>\n<div class=\"shrink-0 pb-1 text-right text-[13px] leading-5 text-[#ccced0]\" data-kid=\"1-3-2-2-3-2\" data-name=\"photo credit block\"><span class=\"text-[#a6a9aa]\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"Photography credit label\">Photography</span><br data-kid=\"1-3-2-2-3-2-2\" data-name=\"line break\"/>Vatsal Patel / Unsplash</div>\n</div>\n</section>\n<div class=\"mt-8 grid grid-cols-[1.35fr_1fr] gap-7\" data-kid=\"1-3-2-3\" data-name=\"upper two-column section (posts + music)\">\n<section aria-labelledby=\"posts-title\" class=\"min-w-0\" data-kid=\"1-3-2-3-1\" data-name=\"Featured Posts section\">\n<div class=\"mb-4 flex items-center justify-between gap-2\" data-kid=\"1-3-2-3-1-1\" data-name=\"posts section header row\"><h2 class=\"display text-[27px] leading-9\" data-kid=\"1-3-2-3-1-1-1\" data-name=\"Featured Posts heading\" id=\"posts-title\">Featured Posts</h2><button class=\"flex items-center gap-2 text-[14px] text-[#b8b7be]\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"All posts link button\" type=\"button\">All posts<i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-3-1-1-2-1\" data-name=\"arrow-up-right icon\"></i></button></div>\n<div class=\"grid grid-cols-[1.4fr_1fr] gap-3.5\" data-kid=\"1-3-2-3-1-2\" data-name=\"posts grid container\">\n<article class=\"glass rim relative h-[326px] overflow-hidden rounded-xl\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"featured post card (The geometry of quiet)\">\n<img alt=\"Spiral staircase with a warm gold opening, photographed by Andrea G on Unsplash.\" class=\"h-full w-full object-cover\" data-kid=\"1-3-2-3-1-2-1-1\" data-name=\"post card cover image (spiral staircase)\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1609862776077-ef7dbd3fb464?auto=format&amp;w=700&amp;q=85&amp;fit=crop\"/>\n<button aria-label=\"Open The geometry of quiet photograph\" class=\"glass absolute right-3 top-3 flex size-8 items-center justify-center rounded-lg text-[17px]\" data-kid=\"1-3-2-3-1-2-1-2\" data-name=\"open / expand post button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-expand\" data-kid=\"1-3-2-3-1-2-1-2-1\" data-name=\"expand icon\"></i></button>\n<div class=\"absolute inset-x-0 bottom-0 border-t border-white/15 bg-[#101013]/95 px-4 py-3.5\" data-kid=\"1-3-2-3-1-2-1-3\" data-name=\"post card footer bar\"><div class=\"flex items-start justify-between gap-2\" data-kid=\"1-3-2-3-1-2-1-3-1\" data-name=\"post title row with like button\"><h3 class=\"text-[18px] font-medium leading-6\" data-kid=\"1-3-2-3-1-2-1-3-1-1\" data-name=\"post title (The geometry of quiet)\">The geometry of quiet</h3><button aria-label=\"Like The geometry of quiet\" class=\"pt-1 text-[18px] text-[#e0ddd6]\" data-kid=\"1-3-2-3-1-2-1-3-1-2\" data-name=\"post like button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-heart\" data-kid=\"1-3-2-3-1-2-1-3-1-2-1\" data-name=\"heart icon (like)\"></i></button></div><p class=\"mt-1 text-[13px] text-[#cfccd0]\" data-kid=\"1-3-2-3-1-2-1-3-2\" data-name=\"post author / category caption\">Andrea G · Architecture</p><div class=\"mt-2 flex items-center gap-1.5 text-[13px] text-[#b8b6bd]\" data-kid=\"1-3-2-3-1-2-1-3-3\" data-name=\"post meta info (type / date)\"><i aria-hidden=\"true\" class=\"icon-image\" data-kid=\"1-3-2